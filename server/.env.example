# 云开发版 .env 示例
# 复制此文件为 .env 并按需修改

# ---- 运行环境 ----
NODE_ENV=development
PORT=8787

# ---- 云开发环境 ----
# 在微信小程序管理后台 → 云开发 → 环境 ID
CLOUDBASE_ENV_ID=your-cloudbase-env-id

# 本地开发（可选）：云开发 API 密钥（云托管容器内自动注入，不需要填）
# CLOUDBASE_SECRET_ID=
# CLOUDBASE_SECRET_KEY=

# ---- 小程序 AppID（用于校验 X-WX-APPID 头）----
WX_APPID=your-mini-program-appid

# ---- 附件设置 ----
# 单个附件最大体积（MB，允许 1-100）；小程序会通过 /api/dicts 自动同步
MAX_UPLOAD_MB=30

# ---- MySQL（云托管容器内自动注入；本地开发手动填写）----
MYSQL_ADDRESS=127.0.0.1:3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=dev123456
MYSQL_DATABASE=simu

# 身份证字段加密密钥：生产环境必须设置为长期固定的高强度随机值，部署后不要随意更换。
# 示例生成方式：openssl rand -base64 32
IDENTITY_DATA_KEY=

# ---- 微信支付（云托管代签名，只需要 MCHID）----
# 商户号（JSAPI 下单接口需要显式传参时用，可不填让云托管自动补充）
WXPAY_MCHID=
# 支付回调地址（云托管内部地址，格式：http://<服务名>.<envId>.wxcloudrun/api/pay/notify）
WXPAY_NOTIFY_URL=

# 演示价开关：1 = 所有订单实付 0.01 元；生产留空
PAY_AMOUNT_OVERRIDE_FEN=1

# 超时未支付自动回退（秒）
PAY_TIMEOUT_SEC=1800

# 支付模式：
#   mock   —— 模拟支付（本地开发/联调默认，不调用微信支付接口）
#   wechat —— 真实微信支付（云托管代签名，需要开通支付服务）
# 本地开发默认走 mock，避免调不到微信支付时 502 卡住闭环；上线务必改为 wechat。
PAYMENT_MODE=mock

# ---- 工程师资格演示开关 ----
# true = 允许 /api/dev/promote-engineer 自主核验；正式上线前置 false
ALLOW_ENGINEER_SELF_VERIFY=true

# ---- 腾讯云短信（验证码；开发未配置时走本地测试模式，返回固定 code=123456）----
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_REGION=ap-beijing
TENCENT_SMS_SIGN_NAME=仿真工坊
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_SDK_APP_ID=

# ---- 登录/重置密码安全限流（不填时使用以下默认值）----
# 账号密码登录：15分钟内账号最多失败5次，同一IP最多失败30次
LOGIN_RATE_WINDOW_SEC=900
LOGIN_ACCOUNT_FAIL_LIMIT=5
LOGIN_IP_FAIL_LIMIT=30
# 重置验证码：每个账号每小时最多5次，同一IP每小时最多20次
RESET_SMS_WINDOW_SEC=3600
RESET_SMS_ACCOUNT_LIMIT=5
RESET_SMS_IP_LIMIT=20
# 重置验证码校验：15分钟内账号最多失败5次，同一IP最多失败20次
RESET_VERIFY_WINDOW_SEC=900
RESET_VERIFY_ACCOUNT_LIMIT=5
RESET_VERIFY_IP_LIMIT=20
# 同一账号24小时内最多成功重置3次
RESET_SUCCESS_WINDOW_SEC=86400
RESET_SUCCESS_ACCOUNT_LIMIT=3

# ---- 内容安全（Mock 词表，上线前接真实 msgSecCheck）----
BANNED_WORDS=违禁词,代刷,加微信私聊

# ---- 本地开发辅助 ----
# 设置此 openid 后，本地 curl/Postman 无需带 X-WX-OPENID 头
DEV_OPENID=test_openid_customer
