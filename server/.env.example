# 复制为 .env 后按需修改。全部留空即为「演示模式」：Mock 登录 + Mock 支付 + 本地文件。
PORT=3000
# NODE_ENV=production 时强制要求真实 JWT_SECRET 与非 mock 支付
NODE_ENV=development
JWT_SECRET=dev-secret-change-me-in-prod

# ---- 微信登录 ----
# 1 = Mock（不连微信服务器，openid=mock_+code）；0 = 真实 jscode2session
WX_MOCK=1
WX_APPID=
WX_SECRET=

# ---- 支付 ----
# mock = 演示收银台；wechat = 微信支付v3（需在 docs/upgrade.md 指引下补充商户凭据代码）
PAY_PROVIDER=mock
# 未支付自动回退秒数（演示/测试可改小，生产 1800）
PAY_TIMEOUT_SEC=1800
# 演示价开关：设为 1 则所有订单实付 0.01 元；生产必须留空
PAY_AMOUNT_OVERRIDE_FEN=

# ---- 文件 ----
MAX_UPLOAD_MB=25

# ---- 内容安全（Mock 词表，逗号分隔；上线前替换为微信 msgSecCheck） ----
BANNED_WORDS=违禁词,代刷,加微信私聊
