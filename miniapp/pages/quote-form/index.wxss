/* ===== 提交报价 · 浅色商务（布局参照 new_simu quoteCreate） ===== */
.page-container {
  min-height: 100vh;
  background-color: var(--bg-base);
  padding-bottom: 40rpx;
}

/* ===== 页头 ===== */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--c-divider);
}
.page-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--c-text);
}

/* ===== 表单区块 ===== */
.form-section {
  background: #FFFFFF;
  border-radius: var(--r-lg);
  margin: 20rpx 24rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-card);
}

/* ===== 表单组 ===== */
.form-group {
  margin-bottom: 24rpx;
}
.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--c-text-2);
  margin-bottom: 12rpx;
}
.required {
  color: var(--neon-red);
}
.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #DDDDDD;
  border-radius: var(--r-md);
  font-size: 28rpx;
  color: var(--c-text);
  background: #FAFAFA;
  box-sizing: border-box;
}
.form-input:focus {
  border-color: var(--neon-violet);
  background: #FFFFFF;
}
.form-textarea {
  width: 100%;
  min-height: 220rpx;
  padding: 20rpx;
  border: 1rpx solid #DDDDDD;
  border-radius: var(--r-md);
  font-size: 28rpx;
  color: var(--c-text);
  background: #FAFAFA;
  box-sizing: border-box;
  line-height: 1.6;
}
.form-textarea:focus {
  border-color: var(--neon-violet);
  background: #FFFFFF;
}
.char-count {
  display: block;
  text-align: right;
  font-size: 20rpx;
  color: var(--c-text-4);
  margin-top: 6rpx;
}

/* ===== 固定预算展示 ===== */
.fixed-amount {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--c-money);
  padding: 16rpx 0;
}
.fixed-tip {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--c-text-3);
}

/* ===== 提交按钮 ===== */
.btn-primary-block {
  width: 100%;
  padding: 22rpx 0;
  border: none;
  border-radius: var(--r-md);
  background: var(--grad-violet-pink);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: var(--glow-primary);
  line-height: 1.5;
}
.btn-primary-block::after { border: none; }
.btn-primary-block:active {
  transform: scale(0.98);
  opacity: 0.9;
}
.btn-primary-block.disabled {
  opacity: 0.5;
}
.submit-tip {
  font-size: 22rpx;
  color: var(--c-text-3);
  margin-top: 20rpx;
  line-height: 1.6;
}

/* ===== design 1:1 ===== */
.form-section { background: #FFFFFF; border-radius: 32rpx; box-shadow: 0 2rpx 12rpx rgba(70,110,60,.06); }
.form-input, .form-textarea { background: #FBFDF9; border: 1rpx solid #E1EBDD; border-radius: 16rpx; }
.btn-primary-block { border-radius: 999rpx; }
