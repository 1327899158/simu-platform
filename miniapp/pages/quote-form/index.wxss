/* ========== 固定预算提示 · 霓虹 ========== */
.fixed-amount {
  padding: 22rpx 24rpx;
  margin-top: 12rpx;
  background: rgba(168, 85, 247, 0.1);
  border-radius: var(--r-md);
  font-size: 36rpx;
  font-weight: 700;
  color: var(--neon-violet-2);
  border: 1rpx solid rgba(168, 85, 247, 0.4);
  box-shadow: inset 0 0 32rpx rgba(168, 85, 247, 0.1);
}
