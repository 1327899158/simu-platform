.page-container{min-height:100vh;padding:28rpx 24rpx;box-sizing:border-box;background:var(--bg-base)}.hero{padding:30rpx 28rpx;border-radius:var(--r-lg);background:var(--grad-violet-pink);color:#fff}.hero-title,.title,.label,.status,.item{display:block}.hero-title{font-size:36rpx;font-weight:700}.hero-desc{display:block;margin-top:10rpx;font-size:23rpx;line-height:1.6;color:rgba(255,255,255,.84)}.card{margin-top:22rpx;padding:28rpx;border-radius:var(--r-lg);background:#fff;box-shadow:var(--shadow-card)}.status{color:#2FA8DE;font-size:25rpx;font-weight:600}.title{margin-top:12rpx;font-size:31rpx;font-weight:700;color:var(--c-text)}.item{margin-top:12rpx;font-size:25rpx;line-height:1.6;color:var(--c-text-2);word-break:break-all}.label{margin:18rpx 0 10rpx;color:var(--c-text);font-size:26rpx;font-weight:600}.input,.textarea{width:100%;box-sizing:border-box;border-radius:var(--r-md);background:#F5F6FB;padding:18rpx 20rpx;font-size:27rpx}.input{height:88rpx}.textarea{height:160rpx}.primary{margin-top:30rpx;border:0;border-radius:var(--r-md);background:var(--grad-violet-pink);color:#fff;font-size:29rpx;font-weight:600}.primary::after{border:none}
.invoice-files{display:flex;flex-direction:column;gap:10rpx;margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid #ECEEF4}.files-title{color:var(--c-text);font-size:25rpx;font-weight:700}.file-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:18rpx;border-radius:14rpx;background:#F7F8FC}.file-row:active{background:#E3F4FC}.file-copy{display:flex;min-width:0;flex:1;flex-direction:column;gap:4rpx}.file-name{overflow:hidden;color:var(--c-text);font-size:24rpx;text-overflow:ellipsis;white-space:nowrap}.file-size{color:var(--c-text-3);font-size:20rpx}.file-open{flex-shrink:0;color:#2FA8DE;font-size:23rpx;font-weight:600}.waiting-file{display:block;margin-top:22rpx;padding:18rpx;border-radius:14rpx;background:#FFF8E8;color:#8E671E;font-size:23rpx;line-height:1.55}

/* ===== design 1:1 ===== */
.hero { background: linear-gradient(160deg, #F7F3C9, #DDEBD9); }
.card { border-radius: 32rpx; }
.input, .textarea { background: #FBFDF9; border: 1rpx solid #E1EBDD; border-radius: 16rpx; }
.primary, button.primary { border-radius: 999rpx; background: #5BC0EB; }
