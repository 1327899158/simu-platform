.page-container{min-height:100vh;padding:28rpx 24rpx;box-sizing:border-box;background:var(--bg-base)}.hero{padding:30rpx 28rpx;border-radius:var(--r-lg);background:var(--grad-violet-pink);color:#fff}.hero-title,.title,.label,.status,.item{display:block}.hero-title{font-size:36rpx;font-weight:700}.hero-desc{display:block;margin-top:10rpx;font-size:23rpx;line-height:1.6;color:rgba(255,255,255,.84)}.card{margin-top:22rpx;padding:28rpx;border-radius:var(--r-lg);background:#fff;box-shadow:var(--shadow-card)}.status{color:#596CD4;font-size:25rpx;font-weight:600}.title{margin-top:12rpx;font-size:31rpx;font-weight:700;color:var(--c-text)}.item{margin-top:12rpx;font-size:25rpx;line-height:1.6;color:var(--c-text-2);word-break:break-all}.label{margin:18rpx 0 10rpx;color:var(--c-text);font-size:26rpx;font-weight:600}.input,.textarea{width:100%;box-sizing:border-box;border-radius:var(--r-md);background:#F5F6FB;padding:18rpx 20rpx;font-size:27rpx}.input{height:88rpx}.textarea{height:160rpx}.primary{margin-top:30rpx;border:0;border-radius:var(--r-md);background:var(--grad-violet-pink);color:#fff;font-size:29rpx;font-weight:600}.primary::after{border:none}
