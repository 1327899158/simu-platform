<view class="qualification-page">
  <view class="qualification-hero"><text class="qualification-title">身份认证</text><text class="qualification-desc">认证通过后可发布需求或参与接单。证件信息仅用于审核并加密保存。</text></view>
  <view class="status-card {{verifyStatus === 'APPROVED' ? 'approved' : verifyStatus === 'REJECTED' ? 'rejected' : 'pending'}}">
    <view><text class="status-label">认证状态</text><text class="status-value">{{verifyText}}</text></view>
    <text class="status-reason" wx:if="{{reviewReason}}">审核说明：{{reviewReason}}</text>
  </view>

  <view class="qualification-card form-card">
    <text class="section-title">本人信息</text>
    <view class="field"><text class="field-label">真实姓名</text><input class="field-input" value="{{realName}}" maxlength="30" placeholder="请输入身份证上的姓名" bindinput="onRealName" /></view>
    <view class="field"><text class="field-label">手机号</text><input class="field-input" type="number" value="{{phone}}" maxlength="11" placeholder="请输入本人手机号" bindinput="onPhone" /></view>
    <view class="field"><text class="field-label">身份证号</text><input class="field-input" value="{{idCardNumber}}" maxlength="18" placeholder="请输入18位身份证号" bindinput="onIdCard" /></view>
  </view>

  <view class="qualification-card">
    <text class="section-title">上传中华人民共和国身份证</text>
    <text class="section-tip">请确保四角完整、文字清晰、无反光遮挡</text>
    <view class="id-grid">
      <view class="id-slot" data-side="front" bindtap="chooseIdImage">
        <image wx:if="{{idFront}}" class="id-preview" src="{{idFront.previewUrl || idFront.fileID}}" mode="aspectFill" />
        <view wx:else class="id-placeholder"><text class="id-plus">＋</text><text>上传人像面</text></view>
        <text class="id-side">身份证人像面</text>
      </view>
      <view class="id-slot" data-side="back" bindtap="chooseIdImage">
        <image wx:if="{{idBack}}" class="id-preview" src="{{idBack.previewUrl || idBack.fileID}}" mode="aspectFill" />
        <view wx:else class="id-placeholder"><text class="id-plus">＋</text><text>上传国徽面</text></view>
        <text class="id-side">身份证国徽面</text>
      </view>
    </view>
    <text class="privacy-tip">身份证照片和号码属于敏感个人信息，仅认证审核人员可查看。</text>
  </view>

  <view class="qualification-card">
    <view class="section-head"><view><text class="section-title">补充认证资料</text><text class="section-tip">学历、证书、项目案例等（选填）</text></view><button class="choose-button {{uploading ? 'disabled' : ''}}" disabled="{{uploading}}" bindtap="chooseSupporting">{{uploading ? uploadText : '上传资料'}}</button></view>
    <view class="file-row" wx:for="{{files}}" wx:key="fileId"><view class="file-main" data-source="support" data-index="{{index}}" bindtap="openFile"><text class="file-icon">{{item.kind === 'IMAGE' ? '图' : '文'}}</text><view class="file-copy"><text class="file-name">{{item.name}}</text><text class="file-meta">{{item.sizeText}} · 点击查看</text></view></view><button class="remove-button" data-index="{{index}}" bindtap="removeSupporting">删除</button></view>
    <view class="empty" wx:if="{{!loading && !files.length}}">暂无补充认证资料</view>
  </view>

  <button class="submit-button" loading="{{saving}}" disabled="{{saving || uploading}}" bindtap="submit">提交身份认证</button>
</view>
