.qualification-page { min-height: 100vh; padding: 24rpx; padding-bottom: calc(56rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: var(--bg-base); }
.qualification-hero { padding: 32rpx; border-radius: 24rpx; background: var(--grad-violet-pink); color: #fff; box-shadow: var(--glow-primary); }
.qualification-title { display: block; font-size: 36rpx; line-height: 50rpx; font-weight: 700; }
.qualification-desc { display: block; margin-top: 10rpx; font-size: 24rpx; line-height: 38rpx; color: rgba(255,255,255,.88); }
.status-card,.qualification-card { margin-top: 20rpx; padding: 24rpx; border: 1rpx solid var(--c-border); border-radius: var(--r-lg); background: var(--bg-card); box-shadow: var(--shadow-card); }
.status-card { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.status-card.approved { border-color: #BCE7D2; background: #F0FBF5; }.status-card.pending { border-color: #E8DCA8; background: #FFFBEA; }.status-card.rejected { border-color: #F2C4C0; background: #FFF4F3; }
.status-label { color: var(--c-text-3); font-size: 23rpx; }.status-value { display: block; margin-top: 5rpx; color: var(--c-text); font-size: 30rpx; font-weight: 700; }.status-reason { max-width: 430rpx; color: #B3382D; font-size: 23rpx; line-height: 34rpx; text-align: right; }
.section-title { display: block; color: var(--c-text); font-size: 29rpx; font-weight: 700; }.section-tip { display: block; margin-top: 6rpx; color: var(--c-text-3); font-size: 22rpx; line-height: 34rpx; }
.field { padding: 20rpx 0; border-bottom: 1rpx solid var(--c-divider); }.field:last-child { border-bottom: 0; }.field-label { display: block; margin-bottom: 12rpx; color: var(--c-text-2); font-size: 24rpx; }.field-input { height: 72rpx; padding: 0 18rpx; border: 1rpx solid var(--c-border); border-radius: 14rpx; background: #FAF9FD; color: var(--c-text); font-size: 27rpx; box-sizing: border-box; }
.id-grid { display: flex; gap: 18rpx; margin-top: 22rpx; }.id-slot { position: relative; flex: 1; min-width: 0; height: 220rpx; overflow: hidden; border: 2rpx dashed #B9A8DC; border-radius: 18rpx; background: #FAF7FF; }.id-preview { width: 100%; height: 170rpx; }.id-placeholder { height: 170rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #7256A8; font-size: 23rpx; }.id-plus { font-size: 50rpx; line-height: 56rpx; }.id-side { position: absolute; left: 0; right: 0; bottom: 0; height: 50rpx; display: flex; align-items: center; justify-content: center; background: rgba(78,52,117,.9); color: #fff; font-size: 22rpx; }.privacy-tip { display: block; margin-top: 18rpx; padding: 16rpx; border-radius: 12rpx; background: #F5F1FC; color: #635474; font-size: 21rpx; line-height: 34rpx; }
.section-head { min-height: 88rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }.choose-button,.remove-button { min-height: 72rpx; margin: 0; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; font-size: 24rpx; }.choose-button { padding: 0 20rpx; background: var(--grad-violet-pink); color: #fff; }.choose-button::after,.remove-button::after,.submit-button::after { border: none; }.disabled { opacity: .58; }
.file-row { min-height: 104rpx; padding: 16rpx 0; display: flex; align-items: center; gap: 14rpx; border-top: 1rpx solid var(--c-divider); }.file-main { flex: 1; min-width: 0; display: flex; align-items: center; gap: 16rpx; }.file-icon { width: 58rpx; height: 58rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; background: #EEE8FA; color: #6F4DA2; font-size: 23rpx; font-weight: 700; }.file-copy { flex: 1; min-width: 0; }.file-name { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--c-text); font-size: 25rpx; }.file-meta { display: block; margin-top: 5rpx; color: var(--c-text-3); font-size: 21rpx; }.remove-button { flex-shrink: 0; padding: 0 16rpx; background: #FDECEA; color: #B3382D; }.empty { padding: 50rpx 0; color: var(--c-text-4); font-size: 24rpx; text-align: center; }
.submit-button { min-height: 92rpx; margin-top: 28rpx; border-radius: 18rpx; background: var(--grad-violet-pink); color: #fff; font-size: 29rpx; font-weight: 700; box-shadow: var(--glow-primary); }

/* ===== design 1:1 ===== */
.card, .section { background: #FFFFFF; border-radius: 32rpx; }
.submit, button.primary { border-radius: 999rpx; background: #5BC0EB; color: #FFFFFF; }
