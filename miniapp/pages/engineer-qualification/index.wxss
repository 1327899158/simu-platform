.qualification-page { min-height: 100vh; padding: 24rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: var(--bg-base); }
.qualification-hero { padding: 30rpx; border-radius: 24rpx; background: var(--grad-violet-pink); color: #fff; box-shadow: var(--glow-primary); }
.qualification-title { display: block; font-size: 36rpx; line-height: 50rpx; font-weight: 700; }
.qualification-desc { display: block; margin-top: 10rpx; font-size: 24rpx; line-height: 38rpx; color: rgba(255,255,255,.86); }
.qualification-card { margin-top: 20rpx; padding: 24rpx; border: 1rpx solid var(--c-border); border-radius: var(--r-lg); background: var(--bg-card); box-shadow: var(--shadow-card); }
.notice { background: #F8F5FF; border-color: #E1D7F5; color: #5A4A76; }
.notice-title { display: block; margin-bottom: 10rpx; color: var(--neon-violet); font-size: 28rpx; font-weight: 650; }
.notice text:not(.notice-title) { display: block; margin-top: 6rpx; font-size: 23rpx; line-height: 36rpx; }
.section-head { min-height: 88rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.section-title { font-size: 29rpx; font-weight: 650; color: var(--c-text); }
.choose-button,.remove-button { min-height: 72rpx; margin: 0; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; font-size: 24rpx; }
.choose-button { padding: 0 20rpx; background: var(--grad-violet-pink); color: #fff; }
.choose-button::after,.remove-button::after { border: none; }
.choose-button.disabled { opacity: .58; }
.file-row { min-height: 104rpx; padding: 16rpx 0; display: flex; align-items: center; gap: 14rpx; border-top: 1rpx solid var(--c-divider); }
.file-main { flex: 1; min-width: 0; display: flex; align-items: center; gap: 16rpx; }
.file-icon { width: 58rpx; height: 58rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; background: #EEF2FF; color: #596CD4; font-size: 23rpx; font-weight: 700; }
.file-copy { flex: 1; min-width: 0; }
.file-name { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--c-text); font-size: 25rpx; }
.file-meta { display: block; margin-top: 5rpx; color: var(--c-text-3); font-size: 21rpx; }
.remove-button { flex-shrink: 0; padding: 0 16rpx; background: #FDECEA; color: #B3382D; }
.empty,.loading { padding: 80rpx 0; color: var(--c-text-4); font-size: 25rpx; text-align: center; }
