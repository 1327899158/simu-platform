.page-container { min-height: 100vh; padding: 28rpx 20rpx calc(140rpx + env(safe-area-inset-bottom)); background: var(--bg-base); box-sizing: border-box; }.profile-hero { display: flex; align-items: center; gap: 20rpx; padding: 32rpx 24rpx; border-radius: 22rpx; background: var(--grad-violet-pink); }.avatar { display: flex; width: 92rpx; height: 92rpx; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.24); color: #FFFFFF; font-size: 52rpx; }.profile-title, .profile-desc { display: block; }.profile-title { color: #FFFFFF; font-size: 32rpx; font-weight: 700; }.profile-desc { margin-top: 8rpx; color: rgba(255,255,255,.82); font-size: 22rpx; }.login-card, .menu-card { margin-top: 20rpx; padding: 28rpx 24rpx; border-radius: 20rpx; background: #FFFFFF; box-shadow: var(--shadow-sm); }.login-title { display: block; color: var(--c-text); font-size: 29rpx; font-weight: 800; }.login-copy { display: block; margin-top: 10rpx; color: var(--c-text-3); font-size: 23rpx; line-height: 1.55; }.login-button { margin-top: 22rpx; padding: 18rpx 0; border-radius: 14rpx; background: var(--neon-violet); color: #FFFFFF; font-size: 27rpx; font-weight: 700; text-align: center; }.menu-card { padding: 0 24rpx; }.menu-item { display: flex; align-items: center; min-height: 104rpx; border-bottom: 1rpx solid var(--c-divider); color: var(--c-text); font-size: 27rpx; }.menu-item:last-child { border-bottom: none; }.menu-icon { margin-right: 18rpx; font-size: 34rpx; }.menu-note { margin-left: auto; color: var(--c-text-4); font-size: 21rpx; }.guest-tabbar { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; display: flex; height: calc(112rpx + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); background: rgba(255,255,255,.98); border-top: 1rpx solid var(--c-border); box-shadow: 0 -4rpx 16rpx rgba(26,26,46,.06); box-sizing: border-box; }.guest-tab { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5rpx; color: var(--c-text-3); font-size: 20rpx; }.guest-tab.active { color: var(--neon-violet); font-weight: 700; }.tab-icon { font-size: 34rpx; line-height: 1; }

/* ===== design 1:1 ===== */
.profile-hero { background: linear-gradient(160deg, #F7F3C9, #DDEBD9); border-radius: 32rpx; }
.login-card { background: #FFFFFF; border-radius: 32rpx; }
.login-button { border-radius: 999rpx; background: #5BC0EB; }
.menu-card { border-radius: 32rpx; }
