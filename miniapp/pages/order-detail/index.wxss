/* ========== 订单详情 · 霓虹 ========== */
.desc {
  margin-top: 20rpx;
  line-height: 1.7;
  color: var(--c-text-2);
  font-size: 27rpx;
}

/* ---------- 文件列表 ---------- */
.file-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  background: rgba(34, 211, 238, 0.06);
  border: 1rpx solid rgba(34, 211, 238, 0.22);
  border-radius: var(--r-md);
  transition: background 0.15s ease, border-color 0.15s ease;
}
.file-row:active {
  background: rgba(34, 211, 238, 0.12);
  border-color: rgba(34, 211, 238, 0.4);
}
.file-name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 12rpx;
  font-size: 27rpx;
  color: var(--c-text);
}
.dl {
  color: var(--neon-cyan-2);
  margin-left: 16rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* ---------- 报价卡片 ---------- */
.quote {
  border-top: 1rpx solid var(--c-divider);
  padding-top: 28rpx;
  margin-top: 28rpx;
}
.q-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--grad-cyan-blue);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
  box-shadow: var(--glow-cyan);
  flex-shrink: 0;
  border: 1rpx solid rgba(34, 211, 238, 0.5);
}
.q-avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
  border: 1rpx solid var(--c-border-strong);
  box-shadow: var(--glow-cyan);
}
