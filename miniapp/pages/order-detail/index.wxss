/* ===== 订单详情 · 浅色商务（布局参照 new_simu orderDetail） ===== */
.page-container {
  min-height: 100vh;
  background-color: var(--bg-base);
  padding: 20rpx 24rpx 40rpx;
  box-sizing: border-box;
}

/* ===== 状态卡片（主色深色卡） ===== */
.status-card {
  display: flex;
  align-items: center;
  background: var(--grad-hero-sky);
  border-radius: var(--r-lg);
  padding: 36rpx 28rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 20rpx;
}
.status-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
}
.status-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.status-label {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2B22;
}
.status-hint {
  font-size: 24rpx;
  color: #5A665C;
}

/* ===== 信息卡片 ===== */
.info-card {
  background: #FFFFFF;
  border-radius: var(--r-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 20rpx;
}
.card-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 20rpx;
}
.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.card-title-row .card-title {
  margin-bottom: 0;
}

.info-row {
  display: flex;
  padding: 10rpx 0;
  font-size: 26rpx;
}
.info-label {
  width: 150rpx;
  flex-shrink: 0;
  color: var(--c-text-3);
}
.info-value {
  flex: 1;
  min-width: 0;
  color: var(--c-text);
  word-break: break-all;
}
.info-value.budget {
  color: var(--c-money);
  font-weight: 700;
}

.desc-text {
  font-size: 26rpx;
  color: var(--c-text-2);
  line-height: 1.7;
  word-break: break-all;
}

/* ===== 附件列表 ===== */
.attachment-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.attachment-item {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  background: #F8F9FA;
  border-radius: var(--r-sm);
  min-height: 88rpx;
}
.attachment-item:active { opacity: 0.7; }
.attachment-kind {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--r-sm);
  background: #E3F4FC;
  color: #175D7A;
  margin-right: 16rpx;
}
.attachment-kind.result {
  background: #E8F5E9;
  color: #388E3C;
}
.attachment-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--c-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.attachment-size {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--c-text-3);
  margin-left: 12rpx;
}
.attachment-dl {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--neon-cyan);
  margin-left: 16rpx;
  padding: 4rpx 8rpx;
}

/* ===== 报价列表 ===== */
.no-data-text {
  font-size: 26rpx;
  color: var(--c-text-3);
  text-align: center;
  padding: 32rpx 0;
}
.quote-item {
  background: #F8F9FA;
  border: 2rpx solid transparent;
  border-radius: var(--r-md);
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.quote-item.selected {
  border-color: var(--neon-green);
  background: #F1F8F2;
}
.quote-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.quote-engineer {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.quote-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  overflow: hidden;
  margin-right: 16rpx;
}
.quote-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--grad-violet-pink);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}
.quote-engineer-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.quote-engineer-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-text);
}
.quote-sub {
  font-size: 22rpx;
  color: var(--c-text-3);
}
.quote-body {
  display: flex;
  gap: 32rpx;
  margin-top: 16rpx;
}
.quote-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--c-money);
}
.quote-days {
  font-size: 26rpx;
  color: var(--c-text-2);
}
.quote-desc {
  display: block;
  font-size: 26rpx;
  color: var(--c-text-2);
  line-height: 1.7;
  margin-top: 12rpx;
}
.quote-profile-link {
  display: inline-block;
  min-height: 56rpx;
  line-height: 56rpx;
  margin-top: 12rpx;
  color: var(--neon-violet);
  font-size: 24rpx;
}
.quote-profile-link:active { opacity: .7; }
.peer-quotes-card { border: 1rpx solid rgba(102, 126, 234, 0.14); }
.peer-quotes-tip { flex-shrink: 0; padding: 6rpx 12rpx; border-radius: 999rpx; background: #E3F4FC; color: #2FA8DE; font-size: 20rpx; }
.quote-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
}
.btn-quote-chat,
.btn-select {
  flex: 1;
  padding: 18rpx 0;
  text-align: center;
  border-radius: var(--r-md);
  font-size: 28rpx;
  font-weight: 600;
}
.btn-quote-chat {
  border: 1rpx solid var(--neon-cyan);
  background: rgba(52, 152, 219, 0.06);
  color: var(--neon-cyan);
}
.btn-select {
  background: var(--grad-violet-pink);
  color: #FFFFFF;
  box-shadow: var(--glow-primary);
}
.btn-quote-chat:active,
.btn-select:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* ===== 支付卡片 ===== */
.pay-card {
  background: #FFFFFF;
  border-radius: var(--r-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 20rpx;
}
.pay-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.pay-label {
  font-size: 28rpx;
  color: var(--c-text-2);
}
.pay-amount {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--c-money);
}
.btn-pay {
  width: 100%;
  padding: 22rpx 0;
  border: none;
  border-radius: var(--r-md);
  background: linear-gradient(135deg, #52B788, #3E9B72);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(7, 193, 96, 0.25);
  line-height: 1.5;
}
.btn-pay::after { border: none; }
.btn-pay:active {
  transform: scale(0.98);
  opacity: 0.9;
}
.btn-pay.disabled {
  opacity: 0.5;
}
.pay-tip {
  font-size: 22rpx;
  color: var(--c-text-3);
  margin-top: 16rpx;
  line-height: 1.6;
}

/* ===== 操作卡片/操作区 ===== */
.action-card {
  background: #FFFFFF;
  border-radius: var(--r-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 20rpx;
}
.review-action-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #FFFFFF;
  border-radius: var(--r-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 20rpx;
}
.review-action-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.review-action-title { color: var(--c-text); font-size: 28rpx; font-weight: 700; }
.review-action-desc { color: var(--c-text-3); font-size: 22rpx; line-height: 1.5; }
.review-action-btn { flex-shrink: 0; min-width: 136rpx; min-height: 72rpx; line-height: 72rpx; margin: 0; padding: 0 16rpx; border: 0; border-radius: var(--r-pill); background: var(--grad-violet-pink); color: #fff; font-size: 24rpx; }
.review-action-btn::after { border: none; }
.review-action-btn[disabled] { background: #C8CCD8; color: #fff; }
.invoice-action-card, .invoice-engineer-card { display:flex; align-items:center; gap:18rpx; background:#FFFFFF; border-radius:var(--r-lg); padding:28rpx; box-shadow:var(--shadow-card); margin-bottom:20rpx; }
.invoice-engineer-card { flex-wrap:wrap; }
.invoice-action-btn { flex-shrink:0; min-width:136rpx; min-height:72rpx; line-height:72rpx; margin:0; padding:0 16rpx; border:0; border-radius:var(--r-pill); background:#E3F4FC; color:#2FA8DE; font-size:24rpx; }
.invoice-action-btn::after { border:none; }
.action-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.btn-primary-block {
  width: 100%;
  padding: 22rpx 0;
  border: none;
  border-radius: var(--r-md);
  background: var(--grad-violet-pink);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: var(--glow-primary);
  line-height: 1.5;
  margin-bottom: 16rpx;
}
.btn-primary-block::after { border: none; }
.btn-primary-block:active {
  transform: scale(0.98);
  opacity: 0.9;
}
.action-section .btn-primary-block {
  margin-bottom: 0;
}
.btn-danger-block {
  width: 100%;
  padding: 22rpx 0;
  border: 1rpx solid var(--neon-red);
  border-radius: var(--r-md);
  background: rgba(231, 76, 60, 0.05);
  color: var(--neon-red);
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.5;
}
.btn-danger-block::after { border: none; }
.btn-danger-block:active {
  background: rgba(231, 76, 60, 0.12);
}
.btn-chat {
  width: 100%;
  padding: 22rpx 0;
  border: 1rpx solid var(--neon-cyan);
  border-radius: var(--r-md);
  background: rgba(52, 152, 219, 0.06);
  color: var(--neon-cyan);
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.5;
}
.btn-chat::after { border: none; }
.btn-chat:active {
  background: rgba(52, 152, 219, 0.12);
}
.btn-delete-order {
  width: 100%;
  padding: 22rpx 0;
  border: 1rpx solid var(--neon-red);
  border-radius: var(--r-md);
  background: rgba(231, 76, 60, 0.05);
  color: var(--neon-red);
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.5;
}
.btn-delete-order::after { border: none; }
.btn-delete-order:active {
  background: rgba(231, 76, 60, 0.12);
}
.btn-deliver {
  width: 100%;
  padding: 22rpx 0;
  border: none;
  border-radius: var(--r-md);
  background: linear-gradient(135deg, #52B788, #3E9B72);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(39, 174, 96, 0.25);
  line-height: 1.5;
}
.btn-deliver::after { border: none; }
.btn-deliver:active {
  transform: scale(0.98);
  opacity: 0.9;
}
.btn-deliver.disabled {
  opacity: 0.5;
}

/* ===== 纠纷横幅 ===== */
.dispute-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  background: #FFF8E6;
  border: 1rpx solid #F5D98E;
  border-radius: var(--r-md);
}
.dispute-banner-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}
.dispute-banner-icon { font-size: 40rpx; flex-shrink: 0; }
.dispute-banner-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.dispute-banner-title { font-size: 26rpx; font-weight: 600; color: #8A5A00; }
.dispute-banner-desc { font-size: 22rpx; color: #A8822E; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dispute-banner-link { flex-shrink: 0; font-size: 24rpx; color: #B7791F; font-weight: 500; }

/* ===== 纠纷按钮 ===== */
.btn-dispute {
  width: 100%;
  padding: 22rpx 0;
  border: 1rpx solid #F0B429;
  border-radius: var(--r-md);
  background: rgba(240, 180, 41, 0.08);
  color: #B7791F;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.5;
}
.btn-dispute::after { border: none; }
.btn-dispute:active { background: rgba(240, 180, 41, 0.16); }

/* ===== 退款申请 ===== */
.refund-request-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin: 20rpx 0;
  padding: 22rpx 24rpx;
  border: 1rpx solid #A9D7FF;
  border-radius: var(--r-md);
  background: #F1F8FF;
}
.refund-request-title { color: #146BB5; font-size: 28rpx; font-weight: 600; }
.refund-request-desc { color: #5D7894; font-size: 24rpx; line-height: 1.55; }
.refund-request-card.rejected { border-color: #F1C1BC; background: #FFF5F4; }
.refund-request-card.rejected .refund-request-title { color: #B43A32; }
.refund-request-card.rejected .refund-request-desc { color: #875A56; }
.btn-refund-escalate { min-height: 88rpx; margin: 12rpx 0 0; border: none; border-radius: var(--r-md); background: var(--grad-violet-pink); color: #FFFFFF; font-size: 27rpx; font-weight: 600; line-height: 1.4; }
.btn-refund-escalate::after { border: none; }
.refund-reason-box {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 10rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.72);
}
.refund-detail-label { color: #526D87; font-size: 23rpx; font-weight: 600; }
.refund-detail-value { color: #263F56; font-size: 26rpx; line-height: 1.65; word-break: break-all; }
.refund-materials { display: flex; flex-direction: column; gap: 10rpx; margin-top: 10rpx; }
.refund-file-row,
.refund-upload-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 17rpx 18rpx;
  border: 1rpx solid rgba(67, 139, 198, 0.2);
  border-radius: 14rpx;
  background: #FFFFFF;
}
.refund-file-row:active { background: #F3F8FD; }
.refund-file-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 4rpx; }
.refund-file-name { overflow: hidden; color: #2E4E68; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.refund-file-size { color: #8A9CAB; font-size: 21rpx; }
.refund-file-action { flex-shrink: 0; color: #1678C5; font-size: 23rpx; font-weight: 600; }
.btn-refund {
  width: 100%;
  padding: 22rpx 0;
  border: 1rpx solid #3B9BE8;
  border-radius: var(--r-md);
  background: rgba(59, 155, 232, 0.08);
  color: #176EAD;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.5;
}
.btn-refund::after { border: none; }
.btn-refund:active { background: rgba(59, 155, 232, 0.16); }

.refund-form-card {
  margin: 22rpx 0;
  padding: 28rpx 26rpx;
  border: 1rpx solid #C9DFF2;
  border-radius: var(--r-lg);
  background: #FFFFFF;
  box-shadow: 0 10rpx 30rpx rgba(38, 93, 136, 0.1);
}
.refund-form-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin-bottom: 26rpx; }
.refund-form-copy { display: flex; min-width: 0; flex-direction: column; gap: 6rpx; }
.refund-form-title { color: #173A56; font-size: 32rpx; font-weight: 700; }
.refund-form-tip { color: #758B9D; font-size: 23rpx; line-height: 1.5; }
.refund-form-required {
  flex-shrink: 0;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  background: #FFF0EE;
  color: #D55449;
  font-size: 20rpx;
}
.refund-field-title { color: #2B465D; font-size: 25rpx; font-weight: 600; }
.required-mark { color: #E15148; }
.refund-reason-input {
  box-sizing: border-box;
  width: 100%;
  height: 190rpx;
  margin-top: 14rpx;
  padding: 20rpx;
  border: 1rpx solid #D5E1EB;
  border-radius: 16rpx;
  background: #F8FAFC;
  color: #243D52;
  font-size: 27rpx;
  line-height: 1.55;
}
.refund-reason-input:focus { border-color: #4B9DDD; background: #FFFFFF; }
.refund-placeholder { color: #A0AFBB; font-size: 27rpx; line-height: 1.55; }
.refund-word-count { margin-top: 8rpx; color: #99A8B4; font-size: 21rpx; text-align: right; }
.refund-upload-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 20rpx; }
.refund-upload-optional { color: #8DA0AF; font-size: 22rpx; }
.refund-upload-btn {
  width: auto;
  min-width: 166rpx;
  margin: 0;
  padding: 12rpx 20rpx;
  border: 1rpx solid #82B9E4;
  border-radius: 999rpx;
  background: #F2F8FD;
  color: #176EAD;
  font-size: 23rpx;
  line-height: 1.45;
}
.refund-upload-btn::after,
.refund-form-actions button::after { border: none; }
.refund-upload-btn[disabled] { opacity: 0.5; }
.refund-upload-list { display: flex; flex-direction: column; gap: 10rpx; margin-top: 16rpx; }
.refund-remove-file { flex-shrink: 0; padding: 8rpx; color: #D75A51; font-size: 23rpx; }
.refund-form-notice { margin-top: 22rpx; padding: 16rpx 18rpx; border-radius: 12rpx; background: #FFF8E8; color: #91691E; font-size: 22rpx; line-height: 1.55; }
.refund-form-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.refund-form-actions button { flex: 1; margin: 0; padding: 19rpx 12rpx; border-radius: 16rpx; font-size: 26rpx; font-weight: 600; line-height: 1.45; }
.refund-form-cancel { border: 1rpx solid #CAD7E1; background: #FFFFFF; color: #607687; }
.refund-form-submit { border: none; background: linear-gradient(135deg, #5BC0EB, #2FA8DE); color: #FFFFFF; }
.refund-form-actions button[disabled] { opacity: 0.52; }

.refund-decision-card {
  margin: 24rpx 0;
  padding: 28rpx;
  border: 2rpx solid #F2B65E;
  border-radius: var(--r-lg);
  background: linear-gradient(145deg, #FFF9ED, #FFF3D8);
  box-shadow: 0 8rpx 24rpx rgba(180, 112, 22, 0.12);
}
.refund-decision-head { display: flex; align-items: flex-start; gap: 18rpx; }
.refund-decision-icon { flex-shrink: 0; font-size: 44rpx; line-height: 1; }
.refund-decision-copy { display: flex; flex: 1; flex-direction: column; gap: 8rpx; }
.refund-decision-title { color: #7A4700; font-size: 31rpx; font-weight: 700; }
.refund-decision-desc { color: #956B2C; font-size: 24rpx; line-height: 1.6; }
.engineer-refund-reason { margin-top: 20rpx; background: rgba(255, 255, 255, 0.62); }
.refund-decision-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.refund-decision-actions button { flex: 1; padding: 19rpx 10rpx; border-radius: var(--r-md); font-size: 25rpx; font-weight: 600; line-height: 1.45; }
.refund-decision-actions button::after { border: none; }
.refund-reject-btn { border: 1rpx solid #E3A13F; background: #FFFFFF; color: #A5650B; }
.refund-accept-btn { border: none; background: linear-gradient(135deg, #5BC0EB, #2FA8DE); color: #FFFFFF; }
.refund-decision-actions button[disabled] { opacity: 0.55; }

/* ===== design rebuild ===== */
.btn-select { border-radius: 999rpx; background: #5BC0EB; color: #FFFFFF; }
.btn-quote-chat { border-radius: 999rpx; border: 1rpx solid #5BC0EB; color: #2FA8DE; }

/* ===== design 1:1 ===== */
.pay-card { background: #FFFFFF; border-radius: 32rpx; }
.pay-amount { color: #E85A4F; font-weight: 800; font-size: 40rpx; }
.quote-item { border-radius: 24rpx; border: 1rpx solid #E1EBDD; }
.quote-item.selected { border-color: #F5D33F; background: #FFFBEA; }
