<wxs module="u">
var STATUS_ICONS = { QUOTING: '📋', AWAITING_PAYMENT: '💳', IN_PROGRESS: '⚙️', DELIVERED: '📦', COMPLETED: '✅', CLOSED: '❌' };
var STATUS_HINTS = {
  QUOTING: '需求已发布，等待工程师报价',
  AWAITING_PAYMENT: '已选定工程师，请尽快完成支付',
  IN_PROGRESS: '工程师正在执行，请保持沟通',
  DELIVERED: '成果已交付，请及时验收',
  COMPLETED: '订单已完成，感谢使用',
  CLOSED: '订单已关闭'
};
module.exports = {
  statusIcon: function (s) { return STATUS_ICONS[s] || '📋'; },
  statusHint: function (s) { return STATUS_HINTS[s] || ''; },
  joinText: function (arr) { return arr && arr.length ? arr.join('、') : '未选择'; }
};
</wxs>
<view class="page-container" wx:if="{{order}}">

  <!-- 状态卡片 -->
  <view class="status-card">
    <text class="status-icon">{{u.statusIcon(order.status)}}</text>
    <view class="status-info">
      <text class="status-label">{{order.statusText}}</text>
      <text class="status-hint">{{u.statusHint(order.status)}}</text>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="info-card">
    <text class="card-title">📄 基本信息</text>
    <view class="info-row">
      <text class="info-label">项目名称</text>
      <text class="info-value">{{order.projectName}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">预算</text>
      <text class="info-value budget">¥{{order.budgetY}}{{order.budgetFlexible ? '（可协商）' : ''}}</text>
    </view>
    <view class="info-row" wx:if="{{order.finalAmountFen}}">
      <text class="info-label">成交价</text>
      <text class="info-value budget">¥{{order.finalY}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">工期</text>
      <text class="info-value">{{order.deliveryDays}} 天</text>
    </view>
    <view class="info-row">
      <text class="info-label">仿真方向</text>
      <text class="info-value">{{u.joinText(order.directionTags)}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">使用软件</text>
      <text class="info-value">{{u.joinText(order.softwareTags)}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">订单编号</text>
      <text class="info-value">{{order.orderNo}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">创建时间</text>
      <text class="info-value">{{order.time}}</text>
    </view>
  </view>

  <!-- 项目描述 -->
  <view class="info-card" wx:if="{{order.description}}">
    <text class="card-title">📝 项目描述</text>
    <text class="desc-text">{{order.description}}</text>
  </view>

  <!-- 特殊要求 -->
  <view class="info-card" wx:if="{{order.specialNote}}">
    <text class="card-title">🎯 特殊要求</text>
    <text class="desc-text">{{order.specialNote}}</text>
  </view>

  <!-- 附件列表 -->
  <view class="info-card" wx:if="{{files.length}}">
    <text class="card-title">📎 附件（{{files.length}}）</text>
    <view class="attachment-list">
      <view class="attachment-item" wx:for="{{files}}" wx:key="fileId" data-id="{{item.fileId}}" bindtap="download">
        <text class="attachment-kind {{item.purpose === 'RESULT' || item.kind === 'RESULT' ? 'result' : ''}}">{{item.purpose === 'RESULT' || item.kind === 'RESULT' ? '成果' : '需求'}}</text>
        <text class="attachment-name">{{item.name}}</text>
        <text class="attachment-size">{{item.sizeText}}</text>
        <text class="attachment-dl">{{downloadingFileId === item.fileId ? '下载中…' : '下载'}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 客户视角 ===== -->
  <block wx:if="{{mode === 'customer'}}">

    <!-- 工程师报价 -->
    <view class="info-card" wx:if="{{order.status === 'QUOTING' || order.status === 'AWAITING_PAYMENT'}}">
      <text class="card-title">💬 工程师报价（{{quotes.length}}）</text>
      <view class="no-data-text" wx:if="{{!quotes.length}}">暂无工程师报价，请耐心等待</view>
      <view class="quote-item {{item.status === 'SELECTED' ? 'selected' : ''}}" wx:for="{{quotes}}" wx:key="id">
        <view class="quote-header">
          <view class="quote-engineer">
            <image wx:if="{{item.engineer.avatarUrl}}" src="{{item.engineer.avatarUrl}}" class="quote-avatar" mode="aspectFill" />
            <view wx:else class="quote-avatar quote-avatar-fallback">{{item.engineer.nickname[0]}}</view>
            <view class="quote-engineer-info">
              <text class="quote-engineer-name">👨‍💼 {{item.engineer.nickname}}</text>
              <text class="quote-sub">已完成 {{item.engineer.completedCount}} 单</text>
            </view>
          </view>
          <text class="status st-blue" wx:if="{{item.status === 'SELECTED'}}">已选中</text>
        </view>
        <view class="quote-body">
          <text class="quote-price">💰 ¥{{item.amountY}}</text>
          <text class="quote-days">📅 承诺 {{item.days}} 天</text>
        </view>
        <text class="quote-desc" wx:if="{{item.solution}}">{{item.solution}}</text>
        <view class="btn-select" wx:if="{{order.status === 'QUOTING'}}"
          bindtap="select" data-id="{{item.id}}" data-nick="{{item.engineer.nickname}}"
          data-amounty="{{item.amountY}}" data-days="{{item.days}}">选择该工程师</view>
      </view>
    </view>

    <!-- 支付 -->
    <view class="pay-card" wx:if="{{order.status === 'AWAITING_PAYMENT'}}">
      <view class="pay-row">
        <text class="pay-label">应付金额</text>
        <text class="pay-amount">¥{{order.finalY}}</text>
      </view>
      <button class="btn-pay {{paying ? 'disabled' : ''}}" bindtap="pay">
        {{paying ? '处理中…' : '💳 立即支付'}}
      </button>
      <view class="pay-tip">超时未支付将自动释放选标；真实通道将调起微信支付收银台</view>
    </view>

    <!-- 验收 -->
    <view class="action-card" wx:if="{{order.status === 'DELIVERED'}}">
      <button class="btn-primary-block" bindtap="confirmDone">✅ 确认验收，完成订单</button>
      <button class="btn-danger-block" bindtap="rejectDelivery">驳回本次交付</button>
    </view>

    <!-- 操作区 -->
    <view class="action-section">
      <button class="btn-chat"
        wx:if="{{order.status === 'IN_PROGRESS' || order.status === 'DELIVERED' || order.status === 'COMPLETED'}}"
        bindtap="goChat">💬 与工程师沟通</button>
      <button class="btn-delete-order" wx:if="{{order.status === 'QUOTING'}}" bindtap="del">🗑️ 删除订单</button>
    </view>
  </block>

  <!-- ===== 工程师视角 ===== -->
  <block wx:if="{{mode === 'market'}}">
    <view class="info-card" wx:if="{{order.myQuote}}">
      <view class="card-title-row">
        <text class="card-title">💰 我的报价</text>
        <text class="status st-blue">{{order.myQuote.status === 'PENDING' ? '待客户确认' : order.myQuote.status === 'SELECTED' ? '已选中' : order.myQuote.status}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">报价金额</text>
        <text class="info-value budget">¥{{order.myQuote.amountFen / 100}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">承诺工期</text>
        <text class="info-value">{{order.myQuote.days}} 天</text>
      </view>
    </view>

    <view class="action-section">
      <button class="btn-primary-block" wx:if="{{order.status === 'QUOTING'}}" bindtap="goQuote">
        {{order.myQuote ? '✏️ 修改报价' : '💰 我要报价'}}
      </button>
      <button class="btn-deliver {{delivering ? 'disabled' : ''}}"
        wx:if="{{order.iAmSelected && order.status === 'IN_PROGRESS'}}" bindtap="deliver">
        {{delivering ? '上传中…' : '📦 上传成果并交付'}}
      </button>
      <button class="btn-chat"
        wx:if="{{order.iAmSelected && (order.status === 'IN_PROGRESS' || order.status === 'DELIVERED' || order.status === 'COMPLETED')}}"
        bindtap="goChat">💬 与客户沟通</button>
    </view>

    <view class="info-card" wx:if="{{order.customer}}">
      <text class="card-title">👤 客户</text>
      <text class="desc-text">{{order.customer.nickname}}（支付后可见联系方式）</text>
    </view>
  </block>

</view>
