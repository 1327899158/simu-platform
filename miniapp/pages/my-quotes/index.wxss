/* ===== 我的报价 · 浅色商务（布局参照 new_simu quoteList） ===== */
.page-container {
  min-height: 100vh;
  background-color: var(--bg-base);
}

/* ===== 页头 ===== */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--c-divider);
}
.page-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--c-text);
}
.quote-count {
  font-size: 24rpx;
  color: var(--c-text-3);
  background: #F0F0F0;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* ===== 状态筛选栏 ===== */
.filter-bar {
  display: flex;
  flex-wrap: wrap;
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid var(--c-divider);
  gap: 12rpx;
}
.filter-item {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: var(--r-pill);
  font-size: 24rpx;
  color: var(--c-text-2);
  background: #F0F0F0;
  transition: all 0.2s ease;
}
.filter-item:active { transform: scale(0.95); }
.filter-item.active {
  background: var(--neon-violet);
  color: #FFFFFF;
  font-weight: 600;
}

/* ===== 报价列表 ===== */
.quote-list {
  padding: 20rpx 24rpx 40rpx;
}

.quote-card {
  background: #FFFFFF;
  border-radius: var(--r-lg);
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
  transition: transform 0.15s ease;
}
.quote-card-hover {
  opacity: 0.85;
  transform: scale(0.98);
}

.quote-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--c-divider);
}
.quote-title-wrap {
  flex: 1;
  min-width: 0;
}
.quote-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.quote-header .status {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.quote-body {
  margin-bottom: 16rpx;
}
.quote-row {
  display: flex;
  padding: 6rpx 0;
  font-size: 26rpx;
}
.quote-label {
  color: var(--c-text-3);
  width: 170rpx;
  flex-shrink: 0;
}
.quote-value {
  color: var(--c-text);
  flex: 1;
  min-width: 0;
}
.quote-value.price {
  color: var(--c-money);
  font-weight: 700;
}

.quote-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--c-divider);
}
.quote-time {
  font-size: 22rpx;
  color: var(--c-text-4);
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.quote-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.btn-action {
  padding: 8rpx 24rpx;
  border: none;
  border-radius: var(--r-pill);
  font-size: 24rpx;
  font-weight: 500;
  height: auto;
  line-height: 1.6;
  margin: 0;
}
.btn-action::after { border: none; }
.btn-action.detail {
  background: #EBF5FB;
  color: var(--neon-violet);
}
.btn-action.withdraw {
  background: #FDE8E8;
  color: var(--neon-red);
}
.btn-action:active { opacity: 0.7; }

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 20rpx;
}
.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}
.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--c-text);
}
.empty-desc {
  font-size: 24rpx;
  color: var(--c-text-3);
  margin-top: 8rpx;
  margin-bottom: 32rpx;
}
.btn-sm {
  padding: 18rpx 48rpx;
  font-size: 28rpx;
  border: none;
  border-radius: var(--r-md);
  background: var(--grad-violet-pink);
  color: #FFFFFF;
  box-shadow: var(--glow-primary);
  line-height: 1.5;
}
.btn-sm::after { border: none; }
.btn-sm:active {
  transform: scale(0.97);
  opacity: 0.9;
}
