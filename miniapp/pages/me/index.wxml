<!-- pages/me/index.wxml · 布局迁移自 new_simu profile（浅色商务适配） -->
<view class="page-container">

  <!-- 用户卡片 -->
  <view class="user-card" wx:if="{{user}}">
    <view class="avatar" wx:if="{{!user.avatarUrl}}">{{user.nickname ? user.nickname[0] : '👤'}}</view>
    <image class="avatar" wx:else src="{{user.avatarUrl}}" mode="aspectFill"></image>
    <view class="info">
      <text class="name">{{user.nickname || '用户'}}</text>
      <view class="phone-row">
        <text class="phone">{{user.phoneMasked || '未绑定手机'}}</text>
        <button wx:if="{{!user.hasPhone}}" class="bind-phone-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">绑定手机号</button>
      </view>
      <text class="role">{{user.role === 'ENGINEER' ? '🛠️ 工程师' : '👤 客户'}}</text>
    </view>
    <button class="edit-btn" bindtap="goEdit">编辑</button>
  </view>

  <!-- 所有角色统一使用身份认证；工程师在演示环境可保留自主认证入口。 -->
  <view class="verify-card" wx:if="{{user}}" bindtap="goQualification">
    <view class="verify-head">
      <view class="verify-copy">
        <text class="verify-title">身份认证</text>
        <text class="verify-desc">当前状态：{{verifyText}}</text>
      </view>
      <text class="verify-status {{verifyStatus === 'APPROVED' ? 'approved' : verifyStatus === 'REJECTED' ? 'rejected' : 'pending'}}">{{verifyText}}</text>
    </view>
    <button
      wx:if="{{showSelfVerify}}"
      class="verify-btn"
      loading="{{selfVerifyLoading}}"
      disabled="{{selfVerifyLoading}}"
      catchtap="selfVerifyEngineer"
    >自主认证通过（调试）</button>
    <text class="verify-hint">{{qualificationFileCount ? '已提交 ' + qualificationFileCount + ' 份认证材料。' : (user.role === 'ENGINEER' ? '可填写资料申请审核；演示环境也可使用自主认证。' : '填写本人信息并上传身份证正反面后提交审核。')}}</text>
  </view>

  <!-- 菜单（仅保留 simu-platform 已有功能的跳转） -->
  <view class="menu" wx:if="{{user}}">
    <view class="menu-item" bindtap="goQualification">
      <text class="icon">🪪</text>
      <text class="title">身份认证</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" wx:if="{{user.role === 'CUSTOMER'}}" bindtap="goOrders">
      <text class="icon">📋</text>
      <text class="title">我的订单</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" wx:if="{{user.role === 'ENGINEER'}}" bindtap="goMyQuotes">
      <text class="icon">💰</text>
      <text class="title">我的报价</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" wx:if="{{user.role === 'ENGINEER'}}" bindtap="goMyReviews">
      <text class="icon">⭐</text>
      <text class="title">我的评价</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goMyDisputes">
      <text class="icon">⚖️</text>
      <text class="title">我的纠纷</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goResetPassword">
      <text class="icon">🔑</text>
      <text class="title">重置密码</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="switchRole">
      <text class="icon">🔄</text>
      <text class="title">切换角色（演示）</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 操作 -->
  <view class="actions" wx:if="{{user}}">
    <button class="btn-danger-block" bindtap="logout">退出登录</button>
  </view>

</view>
