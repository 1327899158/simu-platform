/* pages/me/index.wxss · 布局迁移自 new_simu profile（浅色商务适配） */

.page-container {
  min-height: 100vh;
  background: var(--bg-base);
  padding: 24rpx;
  box-sizing: border-box;
}

/* ===== 用户卡片 ===== */
.user-card {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: var(--r-md);
  padding: 32rpx 24rpx;
  border: 1rpx solid var(--c-border);
  box-shadow: var(--shadow-card);
  margin-bottom: 24rpx;
}
.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: var(--bg-deep);
  flex-shrink: 0;
  border: 2rpx solid var(--c-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: var(--c-text-3);
  overflow: hidden;
}
.info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 6rpx;
}
.phone-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}
.phone {
  font-size: 24rpx;
  color: var(--c-text-3);
}
.bind-phone-btn {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  background: var(--neon-cyan);
  color: #FFFFFF;
  border: none;
  border-radius: var(--r-pill);
  line-height: 1.6;
  margin: 0;
}
.bind-phone-btn::after { border: none; }
.role {
  font-size: 24rpx;
  color: var(--neon-violet);
  font-weight: 500;
}
.edit-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--neon-violet);
  background: var(--bg-card);
  border: 1rpx solid var(--neon-violet);
  border-radius: var(--r-pill);
  padding: 8rpx 28rpx;
  line-height: 1.5;
  margin: 0;
}
.edit-btn::after { border: none; }
.edit-btn:active {
  background: var(--neon-violet);
  color: #FFFFFF;
}

/* ===== 身份认证（演示） ===== */
.verify-card {
  background: var(--bg-card);
  border-radius: var(--r-md);
  border: 1rpx solid var(--c-border);
  box-shadow: var(--shadow-card);
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.verify-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.verify-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.verify-title {
  color: var(--c-text);
  font-size: 30rpx;
  font-weight: 600;
}
.verify-desc,
.verify-hint {
  color: var(--c-text-3);
  font-size: 23rpx;
  margin-top: 8rpx;
}
.verify-status {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
}
.verify-status.approved { color: #16A34A; }
.verify-status.pending { color: #D97706; }
.verify-status.rejected { color: #DC2626; }
.verify-btn {
  width: 100%;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  margin: 24rpx 0 0;
  border: none;
  border-radius: var(--r-md);
  background: var(--neon-violet);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}
.verify-btn::after { border: none; }
.verify-btn:active { opacity: 0.82; }
.verify-btn[disabled] { opacity: 0.55; }

/* ===== 菜单 ===== */
.menu {
  background: var(--bg-card);
  border-radius: var(--r-md);
  border: 1rpx solid var(--c-border);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  margin-bottom: 24rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--c-divider);
  transition: background 0.2s ease;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-item:active {
  background: var(--bg-deep);
}
.menu-item .icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.menu-item .title {
  flex: 1;
  font-size: 28rpx;
  color: var(--c-text);
}
.menu-item .arrow {
  font-size: 36rpx;
  color: var(--c-text-4);
  flex-shrink: 0;
}

/* ===== 操作 ===== */
.actions {
  margin-top: 40rpx;
}
.btn-danger-block {
  width: 100%;
  padding: 22rpx 0;
  background: var(--neon-red);
  color: #FFFFFF;
  border-radius: var(--r-md);
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
}
.btn-danger-block::after { border: none; }
.btn-danger-block:active {
  background: #C0392B;
  transform: scale(0.98);
}
