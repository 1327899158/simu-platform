/* ========== 个人资料头部卡片 · 霓虹 ========== */
.card.row {
  align-items: center;
  padding: 36rpx 28rpx;
  background: rgba(168, 85, 247, 0.08);
  border: 1rpx solid rgba(168, 85, 247, 0.3);
  animation: neon-rise 0.4s ease-out both;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--grad-violet-pink);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 600;
  box-shadow: var(--glow-violet);
  flex-shrink: 0;
  border: 1rpx solid rgba(236, 72, 153, 0.5);
}
.avatar-img {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
  border: 1rpx solid var(--c-border-strong);
  box-shadow: var(--glow-cyan);
}

.edit-btn {
  padding: 12rpx 28rpx;
  background: var(--grad-cyan-blue);
  color: #fff;
  border-radius: var(--r-pill);
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
  align-self: center;
  box-shadow: var(--glow-cyan);
  transition: transform 0.15s ease, box-shadow 0.2s ease;
}
.edit-btn:active {
  transform: scale(0.94);
  box-shadow: 0 2rpx 10rpx rgba(34, 211, 238, 0.3);
}
