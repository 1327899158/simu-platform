/* pages/me/index.wxss · 布局迁移自 new_simu profile（浅色商务适配） */

.page-container {
  min-height: 100vh;
  background: var(--bg-base);
  padding: 24rpx;
  box-sizing: border-box;
}

/* ===== 用户卡片 ===== */
.user-card {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: var(--r-md);
  padding: 32rpx 24rpx;
  border: 1rpx solid var(--c-border);
  box-shadow: var(--shadow-card);
  margin-bottom: 24rpx;
}
.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: var(--bg-deep);
  flex-shrink: 0;
  border: 2rpx solid var(--c-border);
}
.info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 6rpx;
}
.phone {
  font-size: 24rpx;
  color: var(--c-text-3);
  margin-bottom: 6rpx;
}
.role {
  font-size: 24rpx;
  color: var(--neon-violet);
  font-weight: 500;
}
.edit-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--neon-violet);
  background: var(--bg-card);
  border: 1rpx solid var(--neon-violet);
  border-radius: var(--r-pill);
  padding: 8rpx 28rpx;
  line-height: 1.5;
  margin: 0;
}
.edit-btn::after { border: none; }
.edit-btn:active {
  background: var(--neon-violet);
  color: #FFFFFF;
}

/* ===== 菜单 ===== */
.menu {
  background: var(--bg-card);
  border-radius: var(--r-md);
  border: 1rpx solid var(--c-border);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  margin-bottom: 24rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--c-divider);
  transition: background 0.2s ease;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-item:active {
  background: var(--bg-deep);
}
.menu-item .icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.menu-item .title {
  flex: 1;
  font-size: 28rpx;
  color: var(--c-text);
}
.menu-item .arrow {
  font-size: 36rpx;
  color: var(--c-text-4);
  flex-shrink: 0;
}

/* ===== 操作 ===== */
.actions {
  margin-top: 40rpx;
}
.btn-danger-block {
  width: 100%;
  padding: 22rpx 0;
  background: var(--neon-red);
  color: #FFFFFF;
  border-radius: var(--r-md);
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
}
.btn-danger-block::after { border: none; }
.btn-danger-block:active {
  background: #C0392B;
  transform: scale(0.98);
}
