/* pages/me/index.wxss · 布局迁移自 new_simu profile（浅色商务适配） */

.page-container {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 24rpx;
  box-sizing: border-box;
}

/* ===== 用户卡片 ===== */
.user-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  border: 1rpx solid #EEEEEE;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}
.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #F0F0F0;
  flex-shrink: 0;
  border: 2rpx solid #EEEEEE;
}
.info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.name {
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 6rpx;
}
.phone {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 6rpx;
}
.role {
  font-size: 24rpx;
  color: #2C3E50;
  font-weight: 500;
}
.edit-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #2C3E50;
  background: #FFFFFF;
  border: 1rpx solid #2C3E50;
  border-radius: 999rpx;
  padding: 8rpx 28rpx;
  line-height: 1.5;
  margin: 0;
}
.edit-btn::after { border: none; }
.edit-btn:active {
  background: #2C3E50;
  color: #FFFFFF;
}

/* ===== 菜单 ===== */
.menu {
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #EEEEEE;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  margin-bottom: 24rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
  transition: background 0.2s ease;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-item:active {
  background: #F8F8F8;
}
.menu-item .icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.menu-item .title {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}
.menu-item .arrow {
  font-size: 36rpx;
  color: #CCCCCC;
  flex-shrink: 0;
}

/* ===== 操作 ===== */
.actions {
  margin-top: 40rpx;
}
.btn-danger-block {
  width: 100%;
  padding: 22rpx 0;
  background: #E74C3C;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
}
.btn-danger-block::after { border: none; }
.btn-danger-block:active {
  background: #C0392B;
  transform: scale(0.98);
}
