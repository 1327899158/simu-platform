/* ========== 个人资料编辑 · 浅色商务 ========== */
.section {
  position: relative;
  margin-bottom: 28rpx;
  padding: 30rpx 28rpx;
  background: var(--bg-elev);
  border: 1rpx solid var(--c-border);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 26rpx;
  color: var(--neon-violet);
  display: flex;
  align-items: center;
  letter-spacing: 1rpx;
}
.section-title::before {
  content: "";
  display: inline-block;
  width: 6rpx;
  height: 30rpx;
  background: var(--neon-violet);
  border-radius: var(--r-pill);
  margin-right: 16rpx;
}

/* 头像选择器 */
.avatar-picker {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background: #F5F6F7;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--c-border);
  overflow: hidden;
  transition: transform 0.15s ease, border-color 0.15s ease;
}
.avatar-picker:active {
  transform: scale(0.96);
  border-color: var(--neon-cyan);
}
.avatar-picker image {
  width: 100%;
  height: 100%;
}
.avatar-placeholder {
  font-size: 64rpx;
  color: var(--neon-violet);
  font-weight: 600;
}
.uploading {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.88);
  color: var(--c-text-2);
  text-align: center;
  padding: 10rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

/* 表单组 */
.form-group {
  margin-bottom: 24rpx;
}
.form-group label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 14rpx;
  color: var(--c-text-2);
  letter-spacing: 1rpx;
}
.form-group input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #DDDDDD;
  border-radius: var(--r-md);
  font-size: 28rpx;
  color: var(--c-text);
  background: #FAFAFA;
  box-sizing: border-box;
  transition: border-color 0.2s ease, background 0.2s ease;
}
.form-group input:focus {
  border-color: var(--neon-violet);
  background: #FFFFFF;
}
.form-group input::placeholder {
  color: var(--c-text-4);
}
.form-group textarea {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 1rpx solid #DDDDDD;
  border-radius: var(--r-md);
  font-size: 28rpx;
  color: var(--c-text);
  background: #FAFAFA;
  box-sizing: border-box;
  min-height: 168rpx;
  line-height: 1.6;
  transition: border-color 0.2s ease, background 0.2s ease;
}
.form-group textarea:focus {
  border-color: var(--neon-violet);
  background: #FFFFFF;
}
.form-group textarea::placeholder {
  color: var(--c-text-4);
}

/* 按钮组 */
.btn-group {
  margin-top: 44rpx;
  display: flex;
  gap: 16rpx;
}
.btn {
  flex: 1;
  padding: 22rpx;
  text-align: center;
  border-radius: var(--r-md);
  font-size: 30rpx;
  font-weight: 600;
  transition: transform 0.15s ease, box-shadow 0.2s ease;
}
.btn:active {
  transform: scale(0.98);
}
.btn-primary {
  background: var(--grad-violet-pink);
  color: #fff;
  box-shadow: var(--glow-primary);
}

/* ===== design 1:1 ===== */
.card, .section, .form-card { background: #FFFFFF; border-radius: 32rpx; box-shadow: 0 2rpx 12rpx rgba(70,110,60,.06); }
.input { background: #FBFDF9; border: 1rpx solid #E1EBDD; border-radius: 16rpx; }
.submit, .save-btn, button.primary { border-radius: 999rpx; background: #5BC0EB; color: #FFFFFF; }
