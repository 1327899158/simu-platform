/* ========== 个人资料编辑 · 霓虹 ========== */
.section {
  position: relative;
  margin-bottom: 28rpx;
  padding: 30rpx 28rpx;
  background: var(--bg-elev);
  border: 1rpx solid var(--c-border);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}
.section::before {
  content: "";
  position: absolute;
  top: 0;
  left: 12%;
  right: 12%;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(34, 211, 238, 0.5), rgba(168, 85, 247, 0.5), transparent);
  opacity: 0.7;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 26rpx;
  background: var(--grad-violet-pink);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: var(--neon-violet-2);
  display: flex;
  align-items: center;
  letter-spacing: 1rpx;
}
.section-title::before {
  content: "";
  display: inline-block;
  width: 6rpx;
  height: 30rpx;
  background: var(--grad-violet-pink);
  border-radius: var(--r-pill);
  margin-right: 16rpx;
  box-shadow: var(--glow-violet);
  -webkit-text-fill-color: initial;
}

/* 头像选择器 · 霓虹环 */
.avatar-picker {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background: rgba(168, 85, 247, 0.08);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(34, 211, 238, 0.45);
  overflow: hidden;
  transition: transform 0.15s ease, border-color 0.15s ease;
  box-shadow: inset 0 0 40rpx rgba(34, 211, 238, 0.08);
}
.avatar-picker:active {
  transform: scale(0.96);
  border-color: var(--neon-cyan);
}
.avatar-picker image {
  width: 100%;
  height: 100%;
}
.avatar-placeholder {
  font-size: 64rpx;
  background: var(--grad-violet-pink);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: var(--neon-violet-2);
  font-weight: 600;
}
.uploading {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(8, 6, 15, 0.78);
  color: var(--neon-cyan-2);
  text-align: center;
  padding: 10rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

/* 表单组 · 霓虹输入框 */
.form-group {
  margin-bottom: 24rpx;
}
.form-group label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 14rpx;
  color: var(--c-text-2);
  letter-spacing: 1rpx;
}
.form-group input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(168, 85, 247, 0.25);
  border-radius: var(--r-md);
  font-size: 28rpx;
  color: var(--c-text);
  background: rgba(8, 6, 15, 0.5);
  box-sizing: border-box;
  transition: border-color 0.2s ease, background 0.2s ease;
}
.form-group input:focus {
  border-color: var(--neon-cyan);
  background: rgba(8, 6, 15, 0.85);
}
.form-group input::placeholder {
  color: var(--c-text-4);
}
.form-group textarea {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(168, 85, 247, 0.25);
  border-radius: var(--r-md);
  font-size: 28rpx;
  color: var(--c-text);
  background: rgba(8, 6, 15, 0.5);
  box-sizing: border-box;
  min-height: 168rpx;
  line-height: 1.6;
  transition: border-color 0.2s ease, background 0.2s ease;
}
.form-group textarea:focus {
  border-color: var(--neon-cyan);
  background: rgba(8, 6, 15, 0.85);
}
.form-group textarea::placeholder {
  color: var(--c-text-4);
}

/* 按钮组 */
.btn-group {
  margin-top: 44rpx;
  display: flex;
  gap: 16rpx;
}
.btn {
  flex: 1;
  padding: 22rpx;
  text-align: center;
  border-radius: var(--r-md);
  font-size: 30rpx;
  font-weight: 600;
  transition: transform 0.15s ease, box-shadow 0.2s ease;
}
.btn:active {
  transform: scale(0.98);
}
.btn-primary {
  background: var(--grad-violet-pink);
  color: #fff;
  box-shadow: var(--glow-primary);
}
