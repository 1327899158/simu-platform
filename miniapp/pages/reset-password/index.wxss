/* 忘记密码页面样式 · 浅色商务 */
.page {
  background: var(--bg-base);
  min-height: 100vh;
  padding: 40rpx 0;
  color: var(--c-text);
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.header .title {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--neon-violet);
}

.form-card {
  background: var(--bg-card);
  margin: 0 20rpx;
  padding: 40rpx;
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
}

.form-group {
  margin-bottom: 24rpx;
}

.form-group label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 28rpx;
  color: var(--c-text-2);
  font-weight: 500;
}

.form-group input {
  width: 100%;
  height: 88rpx;
  padding: 0 20rpx;
  border: 1rpx solid #DDDDDD;
  border-radius: var(--r-md);
  font-size: 28rpx;
  background: #FAFAFA;
  color: var(--c-text);
  box-sizing: border-box;
}

.sms-input,
.account-input {
  display: flex;
  gap: 16rpx;
}

.sms-input input,
.account-input input {
  flex: 1;
  min-width: 0;
}

.btn-sms,
.btn-account {
  flex: 0 0 170rpx;
  min-height: 88rpx;
  padding: 0;
  background: #FFFFFF;
  border: 1rpx solid var(--neon-violet);
  border-radius: var(--r-md);
  font-size: 24rpx;
  color: var(--neon-violet);
  line-height: 86rpx;
}

.btn-sms[disabled],
.btn-account[disabled] {
  background: #F0F0F0;
  border-color: #DDDDDD;
  color: #999999;
}

.phone-hint {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--r-md);
  background: #F5F2FF;
  color: var(--c-text-2);
  font-size: 26rpx;
}

.phone-hint text {
  color: var(--neon-violet);
  font-weight: 600;
}

.btn-primary {
  width: 100%;
  padding: 20rpx 0;
  margin-top: 16rpx;
  background: var(--grad-violet-pink);
  color: #FFFFFF;
  border: none;
  border-radius: var(--r-md);
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: var(--glow-primary);
}

.btn-primary[disabled] {
  opacity: 0.5;
}

/* ===== design 1:1 ===== */
.form-card, .card { background: #FFFFFF; border-radius: 32rpx; }
.input { background: #FBFDF9; border: 1rpx solid #E1EBDD; border-radius: 16rpx; }
.submit, .primary { border-radius: 999rpx; background: #5BC0EB; color: #FFFFFF; }
