/* 忘记密码页面样式 */
.page {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
  padding: 40rpx 0;
  color: #333;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
  color: white;
}

.header .title {
  font-size: 48rpx;
  font-weight: bold;
}

.form-card {
  background: white;
  margin: 0 20rpx;
  padding: 40rpx;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.form-group {
  margin-bottom: 24rpx;
}

.form-group label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.form-group input {
  width: 100%;
  padding: 12rpx 16rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 6rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.sms-input {
  display: flex;
  gap: 8rpx;
}

.sms-input input {
  flex: 1;
}

.btn-sms {
  flex: 0 0 140rpx;
  padding: 12rpx 0;
  background: #f5f5f5;
  border: 1rpx solid #e0e0e0;
  border-radius: 6rpx;
  font-size: 24rpx;
  color: #667eea;
  line-height: 1.5;
}

.btn-sms[disabled] {
  background: #f0f0f0;
  color: #999;
}

.btn-primary {
  width: 100%;
  padding: 16rpx 0;
  margin-top: 16rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.btn-primary[disabled] {
  opacity: 0.5;
}
