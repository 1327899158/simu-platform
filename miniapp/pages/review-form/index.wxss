.page { min-height: 100vh; background: var(--bg-base); padding: 24rpx; box-sizing: border-box; }
.hero { padding: 32rpx 28rpx; border-radius: var(--r-lg); background: var(--grad-violet-pink); color: #fff; margin-bottom: 24rpx; }
.hero-title { display: block; font-size: 36rpx; font-weight: 700; }
.hero-sub { display: block; font-size: 24rpx; opacity: .84; margin-top: 12rpx; }
.card { background: var(--bg-card); border-radius: var(--r-lg); box-shadow: var(--shadow-card); padding: 28rpx; margin-bottom: 20rpx; }
.rating-row { min-height: 96rpx; display: flex; align-items: center; border-bottom: 1rpx solid var(--c-divider); }
.rating-row:last-child { border-bottom: none; }
.rating-label { width: 90rpx; color: var(--c-text); font-size: 30rpx; font-weight: 600; }
.stars { flex: 1; display: flex; }
.star { width: 58rpx; min-height: 88rpx; line-height: 88rpx; text-align: center; font-size: 48rpx; color: #D9DCE8; }
.star.active { color: #FFB800; }
.rating-score { width: 72rpx; text-align: right; color: var(--c-text-3); font-size: 22rpx; }
.comment-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.comment-title { color: var(--c-text); font-size: 28rpx; font-weight: 600; }
.counter { color: var(--c-text-3); font-size: 22rpx; }
.comment-input { width: 100%; height: 200rpx; box-sizing: border-box; background: var(--bg-deep); border-radius: var(--r-md); padding: 20rpx; color: var(--c-text); font-size: 28rpx; line-height: 1.6; }
.placeholder { color: var(--c-text-4); }
.tip { color: var(--c-text-3); font-size: 23rpx; padding: 4rpx 8rpx 24rpx; }
.submit { width: 100%; min-height: 92rpx; line-height: 92rpx; border: none; border-radius: var(--r-md); background: var(--grad-violet-pink); color: #fff; font-size: 30rpx; font-weight: 600; }
.submit::after { border: none; }
.submit[disabled] { opacity: .55; }

/* ===== design 1:1 ===== */
.hero { background: linear-gradient(160deg, #F7F3C9, #DDEBD9); border-radius: 32rpx; padding: 36rpx 32rpx; }
.hero-title { color: #1F2B22; font-weight: 800; font-size: 36rpx; }
.hero-sub { color: #5A665C; }
.card { border-radius: 32rpx; }
.star.active { color: #F5A623; }
.submit { border-radius: 999rpx; background: #5BC0EB; color: #FFFFFF; }
