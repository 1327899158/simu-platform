<view class="chat-container">

  <!-- 顶部导航 -->
  <view class="chat-header">
    <text class="header-title">💬 {{peer.nickname || '聊天'}}</text>
  </view>

  <!-- 消息列表 -->
  <scroll-view class="message-list" scroll-y scroll-top="{{scrollTop}}" scroll-with-animation>
    <view wx:for="{{msgs}}" wx:key="id" id="{{item.anchor}}">
      <!-- 系统消息 -->
      <view class="sys-msg {{item.actionOrderId ? 'sys-msg-action' : ''}}" wx:if="{{item.sys}}"
        bindtap="openSystemAction" data-oid="{{item.actionOrderId}}">
        <text>{{item.content}}</text>
        <text class="sys-msg-link" wx:if="{{item.actionOrderId}}">查看订单 ›</text>
      </view>

      <!-- 普通消息 -->
      <view class="message-item {{item.mine ? 'self' : 'other'}}" wx:else>
        <image wx:if="{{!item.mine && item.senderAvatar}}" src="{{item.senderAvatar}}" class="msg-avatar"
          mode="aspectFill" style="width:{{avatarSize}}rpx;height:{{avatarSize}}rpx" />
        <view wx:if="{{!item.mine && !item.senderAvatar}}" class="msg-avatar avatar-placeholder"
          style="width:{{avatarSize}}rpx;height:{{avatarSize}}rpx;font-size:{{avatarSize/2}}rpx">对</view>

        <view class="message-content {{item.mine ? 'content-self' : 'content-other'}}" style="max-width:{{bubbleMaxWidth}}">
          <!-- 文字消息 -->
          <view wx:if="{{item.type === 'TEXT'}}" class="message-text">{{item.content}}</view>
          <!-- 图片消息 -->
          <view wx:elif="{{item.type === 'IMAGE'}}">
            <image wx:if="{{item.imgUrl}}" class="msg-img" src="{{item.imgUrl}}"
              mode="widthFix" style="width:{{imageWidth}}rpx" bindtap="previewImg" data-url="{{item.imgUrl}}" />
            <view wx:else class="filemsg-loading">图片加载中…</view>
          </view>
          <!-- 文件消息 -->
          <view wx:else class="filemsg" bindtap="openFile" data-fid="{{item.fileId}}">
            📎 {{item.content || '[文件]'}}
          </view>
          <text class="message-time">{{item.time}}</text>
        </view>

        <image wx:if="{{item.mine && item.senderAvatar}}" src="{{item.senderAvatar}}" class="msg-avatar"
          mode="aspectFill" style="width:{{avatarSize}}rpx;height:{{avatarSize}}rpx" />
        <view wx:if="{{item.mine && !item.senderAvatar}}" class="msg-avatar avatar-placeholder mine"
          style="width:{{avatarSize}}rpx;height:{{avatarSize}}rpx;font-size:{{avatarSize/2}}rpx">我</view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-message" wx:if="{{!msgs.length}}">
      <text>暂无消息，开始聊天吧</text>
    </view>
    <view style="height:24rpx"></view>
  </scroll-view>

  <!-- 底部输入 -->
  <view class="chat-input-area" wx:if="{{canSend}}">
    <view class="img-btn {{imageSending ? 'disabled' : ''}}" bindtap="sendImage">
      {{imageSending ? '…' : '🖼️'}}
    </view>
    <input class="chat-input" placeholder="输入消息..." value="{{text}}" bindinput="input" maxlength="2000"
      confirm-type="send" bindconfirm="send" adjust-position />
    <button class="send-btn {{sending ? 'dim' : ''}}" bindtap="send" disabled="{{!text}}">发送</button>
  </view>
  <view class="chat-disabled-tip" wx:else>
    <text>{{sendDisabledReason || '当前会话仅供查看'}}</text>
  </view>

</view>
