.room { display: flex; flex-direction: column; height: 100vh; background: #F5F6F8; }
.list { flex: 1; padding: 24rpx; box-sizing: border-box; }
.sys { text-align: center; color: #999; font-size: 22rpx; margin: 16rpx 0; }
.bubble-row { display: flex; margin: 16rpx 0; }
.bubble-row.mine { justify-content: flex-end; }
.bubble { max-width: 70%; padding: 18rpx 22rpx; border-radius: 12rpx; font-size: 28rpx; word-break: break-all; }
.b-peer { background: #fff; }
.b-mine { background: #1890FF; color: #fff; }
.b-mine .t { color: rgba(255,255,255,.7); }
.t { font-size: 20rpx; color: #bbb; margin-top: 8rpx; text-align: right; }
.filemsg { text-decoration: underline; }
.inputbar {
  display: flex; align-items: center; padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff; border-top: 1rpx solid #EEE;
}
.plus {
  width: 64rpx; height: 64rpx; border: 1rpx solid #D9D9D9; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; color: #666; margin-right: 16rpx;
}
.ipt { flex: 1; background: #F5F6F8; border-radius: 32rpx; padding: 14rpx 24rpx; }
.sendbtn { color: #1890FF; font-weight: 600; margin-left: 16rpx; }
.sendbtn.dim { opacity: .5; }
