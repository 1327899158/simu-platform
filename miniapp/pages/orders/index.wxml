<view class="container">
  <scroll-view scroll-x class="tabs">
    <text wx:for="{{tabs}}" wx:key="key" class="chip {{tab===item.key?'on':''}}"
      bindtap="switchTab" data-key="{{item.key}}">{{item.label}}</text>
  </scroll-view>
  <view class="empty" wx:if="{{!items.length}}">暂无订单，去首页发布一个需求吧</view>
  <view class="card" wx:for="{{items}}" wx:key="id" bindtap="open" data-id="{{item.id}}">
    <view class="spread">
      <view class="title">{{item.projectName}}</view>
      <text class="status {{item.cls}}">{{item.statusText}}</text>
    </view>
    <view style="margin-top:12rpx">
      <text class="tag" wx:for="{{item.directionTags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
    </view>
    <view class="spread" style="margin-top:8rpx">
      <text class="muted">{{item.orderNo}} · {{item.time}} · {{item.quoteCount}} 人报价</text>
      <text class="money">¥{{item.budgetY}}</text>
    </view>
  </view>
</view>
