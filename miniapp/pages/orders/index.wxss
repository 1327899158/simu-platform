/* ===== 我的订单 · 浅色商务（布局参照 new_simu orderList） ===== */
.page-container {
  min-height: 100vh;
  background-color: var(--bg-base);
}

/* ===== 页头 ===== */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--c-divider);
}
.page-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--c-text);
}
.order-count {
  font-size: 24rpx;
  color: var(--c-text-3);
  background: #F0F0F0;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* ===== 可折叠状态筛选 ===== */
.filter-wrap {
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid var(--c-divider);
}
.filter-trigger {
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F7F4FF;
  border: 1rpx solid #E7D9FF;
  border-radius: var(--r-md);
  color: var(--c-text);
  font-size: 28rpx;
  line-height: 1.4;
}
.filter-trigger::after, .filter-item::after { border: none; }
.filter-current { display: flex; align-items: center; gap: 16rpx; font-weight: 600; }
.filter-arrow { color: var(--neon-violet); transition: transform .2s ease; }
.filter-arrow.open { transform: rotate(180deg); }
.filter-panel {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-top: 16rpx;
}
.filter-item {
  min-height: 88rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  flex: 1 0 42%;
  padding: 0 22rpx;
  border-radius: var(--r-md);
  font-size: 24rpx;
  color: var(--c-text-2);
  background: #FAFAFA;
  border: 1rpx solid var(--c-border);
  line-height: 1.4;
  transition: all 0.2s ease;
}
.filter-item:active { transform: scale(0.95); }
.filter-item.active {
  background: #F1E8FF;
  border-color: #C4A7F7;
  color: #5B21B6;
  font-weight: 600;
}
.filter-label { margin-left: 12rpx; }
.filter-count {
  min-width: 34rpx;
  height: 34rpx;
  margin-left: 12rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-pill);
  background: rgba(124, 58, 237, .10);
  color: #6D28D9;
  font-size: 20rpx;
}
.status-dot { width: 14rpx; height: 14rpx; border-radius: 50%; flex-shrink: 0; }
.dot-purple { background: #7C3AED; }
.dot-blue { background: #3B82F6; }
.dot-orange { background: #F59E0B; }
.dot-cyan { background: #06B6D4; }
.dot-pink { background: #D946EF; }
.dot-green { background: #22C55E; }
.dot-red { background: #EF4444; }
.dot-gray { background: #94A3B8; }

/* ===== 订单列表 ===== */
.order-list {
  padding: 20rpx 24rpx 40rpx;
}

.order-card {
  background: #FFFFFF;
  border-radius: var(--r-lg);
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
  transition: transform 0.15s ease;
}
.order-card-hover {
  opacity: 0.85;
  transform: scale(0.98);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--c-divider);
}
.order-title-wrap {
  flex: 1;
  min-width: 0;
}
.order-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.order-header .status {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.order-body {
  margin-bottom: 16rpx;
}
.order-info-row {
  display: flex;
  padding: 6rpx 0;
  font-size: 26rpx;
}
.info-label {
  color: var(--c-text-3);
  width: 90rpx;
  flex-shrink: 0;
}
.info-value {
  color: var(--c-text);
  flex: 1;
  min-width: 0;
}
.info-value.budget {
  color: var(--c-money);
  font-weight: 700;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--c-divider);
}
.order-time {
  font-size: 22rpx;
  color: var(--c-text-4);
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.order-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.btn-action {
  padding: 8rpx 24rpx;
  border: none;
  border-radius: var(--r-pill);
  font-size: 24rpx;
  font-weight: 500;
  height: auto;
  line-height: 1.6;
  margin: 0;
}
.btn-action::after { border: none; }
.btn-action.detail {
  background: #EBF5FB;
  color: var(--neon-violet);
}
.btn-action:active { opacity: 0.7; }

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 20rpx;
}
.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}
.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--c-text);
}
.empty-desc {
  font-size: 24rpx;
  color: var(--c-text-3);
  margin-top: 8rpx;
  margin-bottom: 32rpx;
}
.btn-sm {
  padding: 18rpx 48rpx;
  font-size: 28rpx;
  border: none;
  border-radius: var(--r-md);
  background: var(--grad-violet-pink);
  color: #FFFFFF;
  box-shadow: var(--glow-primary);
  line-height: 1.5;
}
.btn-sm::after { border: none; }
.btn-sm:active {
  transform: scale(0.97);
  opacity: 0.9;
}
