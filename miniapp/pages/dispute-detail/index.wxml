<view class="page-container" wx:if="{{dispute}}">
  <view class="hero">
    <view class="hero-top">
      <text class="hero-title">⚖️ 订单纠纷</text>
      <text class="status {{dispute.statusCls}}">{{dispute.statusText}}</text>
    </view>
    <text class="hero-desc">{{dispute.order ? dispute.order.projectName : '纠纷'}}<text wx:if="{{dispute.order}}"> · {{dispute.order.orderNo}}</text></text>
  </view>

  <view class="evidence-timer {{dispute.evidenceOpen ? 'active' : 'ended'}}">
    <view class="timer-icon">{{dispute.evidenceOpen ? '⏳' : '🔒'}}</view>
    <view class="timer-copy">
      <text class="timer-title">{{dispute.evidenceOpen ? '48小时举证进行中' : '举证通道已关闭'}}</text>
      <text class="timer-value">{{evidenceCountdown}}</text>
      <text class="timer-desc">截止时间：{{dispute.deadlineText}}</text>
    </view>
  </view>

  <view class="card">
    <text class="card-title">纠纷信息</text>
    <view class="info-row"><text class="info-label">纠纷类型</text><text class="info-value">{{dispute.reasonText}}</text></view>
    <view class="info-row"><text class="info-label">发起人</text><text class="info-value">{{dispute.customer && dispute.initiatorId === dispute.customer.id ? '客户' : (dispute.engineer && dispute.initiatorId === dispute.engineer.id ? '工程师' : '—')}}<text wx:if="{{dispute.myRole}}" class="role-inline {{dispute.myRole === 'INITIATOR' ? 'mine' : 'other'}}">{{dispute.myRole === 'INITIATOR' ? '（我提出）' : '（对方提出）'}}</text></text></view>
    <view class="info-row"><text class="info-label">发起时间</text><text class="info-value">{{dispute.createdText}}</text></view>
    <view class="info-row" wx:if="{{dispute.resolutionNote}}"><text class="info-label">仲裁说明</text><text class="info-value">{{dispute.resolutionNote}}</text></view>
    <view class="info-row" wx:if="{{dispute.verdictText && dispute.verdict !== 'NONE'}}"><text class="info-label">仲裁结论</text><text class="info-value">{{dispute.verdictText}} · {{dispute.orderActionText}}</text></view>
    <view class="info-row" wx:if="{{dispute.refundAmountFen != null}}"><text class="info-label">应退金额</text><text class="info-value budget">¥{{dispute.refundY}}（{{dispute.refundStatusText}}）</text></view>
    <view class="desc-text" wx:if="{{dispute.description}}">{{dispute.description}}</view>
  </view>

  <view class="card evidence-card">
    <view class="evidence-header">
      <view>
        <text class="card-title compact">📎 双方证据（{{dispute.evidence.length}}）</text>
        <text class="evidence-subtitle">我已提交 {{dispute.myEvidenceCount}} / 20 份</text>
      </view>
      <button class="upload-button" wx:if="{{dispute.evidenceOpen}}" bindtap="addEvidence" disabled="{{uploading}}">
        {{uploading ? '上传中…' : '＋ 补充证据'}}
      </button>
    </view>

    <view class="evidence-notice">
      支持上传文件作为证据。举证截止后不可再补充，平台管理员将依据全部材料进行仲裁。
    </view>

    <view class="evid-item" wx:for="{{dispute.evidence}}" wx:key="fileId"
      data-index="{{index}}" bindtap="openEvidence">
      <view class="evid-icon">{{item.kind === 'IMAGE' ? '图' : '文'}}</view>
      <view class="evid-copy">
        <text class="evid-name">{{item.name}}</text>
        <text class="evid-meta">{{item.uploaderText}} · {{item.timeText}} · {{item.sizeText}}</text>
      </view>
      <text class="evid-arrow">›</text>
    </view>
    <view class="empty-evidence" wx:if="{{!dispute.evidence.length}}">暂未提交证据材料</view>

    <view class="closed-tip" wx:if="{{!dispute.evidenceOpen}}">
      {{dispute.status === 'OPEN' ? '举证已结束，等待平台管理员仲裁' : '该纠纷已' + dispute.statusText}}
    </view>
  </view>
</view>
<view class="loading" wx:if="{{!dispute}}">正在加载纠纷详情…</view>
