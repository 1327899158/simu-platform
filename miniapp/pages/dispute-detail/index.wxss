.page-container { min-height: 100vh; padding: 20rpx 24rpx 48rpx; box-sizing: border-box; background: var(--bg-base); }
.hero { margin-bottom: 20rpx; padding: 30rpx 28rpx; border-radius: var(--r-lg); background: linear-gradient(135deg,#5BC0EB,#2FA8DE); box-shadow: var(--glow-primary); }
.hero-top { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.hero-title { color:#FFF; font-size:34rpx; font-weight:700; }
.hero-desc { display:block; margin-top:8rpx; color:rgba(255,255,255,.82); font-size:24rpx; }
.status { padding:6rpx 18rpx; border-radius:var(--r-pill); font-size:22rpx; font-weight:600; }
.st-orange { color:#A55A00; background:#FFF1DB; }.st-green { color:#247A43; background:#E8F6ED; }.st-gray { color:#666E7A; background:#EEF0F3; }

.evidence-timer { display:flex; align-items:center; gap:20rpx; margin-bottom:20rpx; padding:25rpx 27rpx; border:2rpx solid; border-radius:var(--r-lg); }
.evidence-timer.active { border-color:#F1B85A; background:linear-gradient(135deg,#FFF9E9,#FFF1CC); box-shadow:0 8rpx 24rpx rgba(170,108,14,.10); }
.evidence-timer.ended { border-color:#D9DEE7; background:#F4F6F9; }
.timer-icon { font-size:48rpx; flex-shrink:0; }.timer-copy { display:flex; flex:1; flex-direction:column; gap:5rpx; }
.timer-title { color:#6F480B; font-size:27rpx; font-weight:700; }.ended .timer-title { color:#667085; }
.timer-value { color:#C57300; font-size:39rpx; font-weight:800; letter-spacing:2rpx; font-variant-numeric:tabular-nums; }.ended .timer-value { color:#7B8491; font-size:29rpx; }
.timer-desc { color:#95713C; font-size:21rpx; }.ended .timer-desc { color:#8A929E; }

.card { margin-bottom:20rpx; padding:28rpx; border-radius:var(--r-lg); background:#FFF; box-shadow:var(--shadow-card); }
.card-title { display:block; margin-bottom:16rpx; color:var(--c-text); font-size:28rpx; font-weight:700; }.card-title.compact { margin-bottom:4rpx; }
.info-row { display:flex; padding:8rpx 0; font-size:26rpx; }.info-label { width:160rpx; flex-shrink:0; color:var(--c-text-3); }.info-value { flex:1; min-width:0; color:var(--c-text); word-break:break-all; }.info-value.budget { color:var(--c-money); font-weight:700; }
.role-inline { margin-left:8rpx; padding:2rpx 10rpx; border-radius:8rpx; font-size:20rpx; }.role-inline.mine { color:#247A43; background:#E8F6ED; }.role-inline.other { color:#2FA8DE; background:#E3F4FC; }
.desc-text { margin-top:12rpx; padding:16rpx; border-radius:var(--r-sm); background:#F8F9FA; color:var(--c-text-2); font-size:26rpx; line-height:1.7; word-break:break-all; }

.evidence-header { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.evidence-subtitle { color:var(--c-text-4); font-size:21rpx; }
.upload-button { flex-shrink:0; min-width:190rpx; margin:0; padding:15rpx 22rpx; border:0; border-radius:99rpx; background:linear-gradient(135deg,#5BC0EB,#2FA8DE); color:#FFF; font-size:23rpx; font-weight:600; line-height:1.4; }
.upload-button::after { border:none; }.upload-button[disabled] { opacity:.55; }
.evidence-notice { margin:20rpx 0 16rpx; padding:17rpx 20rpx; border-left:6rpx solid #6A72DA; border-radius:0 12rpx 12rpx 0; background:#F1F3FF; color:#59637A; font-size:22rpx; line-height:1.65; }
.evid-item { display:flex; align-items:center; gap:14rpx; margin-bottom:12rpx; padding:17rpx 18rpx; border:1rpx solid #E6E9EF; border-radius:14rpx; background:#FAFBFC; }
.evid-item:active { opacity:.7; }.evid-icon { display:flex; align-items:center; justify-content:center; width:52rpx; height:52rpx; flex-shrink:0; border-radius:12rpx; background:#E9EDFF; color:#5967D3; font-size:21rpx; font-weight:700; }
.evid-copy { display:flex; flex:1; min-width:0; flex-direction:column; gap:5rpx; }.evid-name { overflow:hidden; color:var(--c-text); font-size:24rpx; white-space:nowrap; text-overflow:ellipsis; }.evid-meta { color:var(--c-text-4); font-size:20rpx; }.evid-arrow { color:var(--c-text-4); font-size:28rpx; }
.empty-evidence { padding:36rpx 0; color:var(--c-text-4); font-size:24rpx; text-align:center; }
.closed-tip { display:block; margin-top:18rpx; padding:19rpx; border-radius:12rpx; background:#F2F4F7; color:#667085; font-size:23rpx; text-align:center; }
.loading { padding:60rpx 0; color:var(--c-text-3); font-size:25rpx; text-align:center; }

/* ===== design 1:1 ===== */
.hero { background: linear-gradient(160deg, #FBF3CD, #DDEBD9); }
.card { border-radius: 32rpx; }
