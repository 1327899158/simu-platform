.page-container {
  min-height: 100vh;
  background-color: var(--bg-base);
  padding: 20rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.hero {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: var(--r-lg);
  padding: 30rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--glow-primary);
}
.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}
.hero-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}
.hero-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.card {
  background: #FFFFFF;
  border-radius: var(--r-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 20rpx;
}
.card-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  padding: 8rpx 0;
  font-size: 26rpx;
}
.info-label {
  width: 160rpx;
  flex-shrink: 0;
  color: var(--c-text-3);
}
.info-value {
  flex: 1;
  min-width: 0;
  color: var(--c-text);
  word-break: break-all;
}
.info-value.budget { color: var(--c-money); font-weight: 700; }

.desc-text {
  margin-top: 12rpx;
  padding: 16rpx;
  background: #F8F9FA;
  border-radius: var(--r-sm);
  font-size: 26rpx;
  color: var(--c-text-2);
  line-height: 1.7;
  word-break: break-all;
}

/* 状态徽标（复用订单详情 st-*） */
.status { padding: 6rpx 18rpx; border-radius: var(--r-pill); font-size: 22rpx; font-weight: 600; }
.st-orange { color: #A55A00; background: #FFF1DB; }
.st-green { color: #247A43; background: #E8F6ED; }
.st-gray { color: #666E7A; background: #EEF0F3; }

/* 当事人 */
.party-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}
.party-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667EEA, #764BA2);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.party-avatar.eng { background: linear-gradient(135deg, #3498DB, #5DADE2); }
.party-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.party-name { font-size: 27rpx; color: var(--c-text); font-weight: 500; }
.party-phone { font-size: 22rpx; color: var(--c-text-4); }

/* 证据 */
.evid-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #F8F9FA;
  border-radius: var(--r-sm);
  margin-bottom: 10rpx;
  gap: 12rpx;
}
.evid-item:active { opacity: 0.7; }
.evid-name { flex: 1; min-width: 0; font-size: 24rpx; color: var(--c-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.evid-size { font-size: 22rpx; color: var(--c-text-4); flex-shrink: 0; }
.evid-arrow { font-size: 28rpx; color: var(--c-text-4); flex-shrink: 0; }

/* 消息线程 */
.msg-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.sys-msg {
  text-align: center;
  font-size: 22rpx;
  color: var(--c-text-4);
  background: #F4F5F7;
  border-radius: var(--r-pill);
  padding: 10rpx 20rpx;
  align-self: center;
  max-width: 90%;
}
.msg-item {
  display: flex;
}
.msg-item.mine { justify-content: flex-end; }
.msg-item.other { justify-content: flex-start; }
.msg-bubble {
  max-width: 82%;
  padding: 14rpx 20rpx;
  border-radius: var(--r-md);
  background: #EEF2FF;
}
.msg-item.mine .msg-bubble { background: #E8F6ED; }
.msg-sender {
  display: block;
  font-size: 20rpx;
  color: var(--c-text-4);
  margin-bottom: 4rpx;
}
.msg-content {
  display: block;
  font-size: 26rpx;
  color: var(--c-text);
  line-height: 1.6;
  word-break: break-all;
}
.msg-time {
  display: block;
  font-size: 20rpx;
  color: var(--c-text-4);
  margin-top: 6rpx;
  text-align: right;
}
.empty-msg {
  text-align: center;
  font-size: 24rpx;
  color: var(--c-text-4);
  padding: 30rpx 0;
}

/* 输入区 */
.input-area {
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-top: 1rpx solid var(--c-divider);
  padding-top: 20rpx;
}
.img-btn {
  flex-shrink: 0;
  min-width: 72rpx;
  height: 72rpx;
  padding: 0;
  border: 1rpx solid var(--c-border);
  border-radius: 50%;
  background: #FFFFFF;
  font-size: 30rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.img-btn::after { border: none; }
.img-btn.disabled { opacity: 0.5; }
.chat-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--c-border);
  border-radius: 36rpx;
  background: #FAFBFC;
  font-size: 26rpx;
}
.send-btn {
  flex-shrink: 0;
  min-width: 112rpx;
  height: 72rpx;
  padding: 0 20rpx;
  border: none;
  border-radius: 36rpx;
  background: var(--grad-violet-pink);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 72rpx;
  margin: 0;
}
.send-btn::after { border: none; }
.send-btn.dim { opacity: 0.5; }
.send-btn[disabled] { opacity: 0.4; color: #FFFFFF; }
.closed-tip {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: var(--c-text-4);
  padding: 20rpx 0;
}

.loading {
  padding: 60rpx 0;
  text-align: center;
  color: var(--c-text-3);
  font-size: 25rpx;
}
