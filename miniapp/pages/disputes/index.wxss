.page-container {
  min-height: 100vh;
  background-color: var(--bg-base);
}

.page-header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--c-divider);
}
.page-title { font-size: 32rpx; font-weight: 700; color: var(--c-text); }

.filter-wrap { background: #FFFFFF; padding: 16rpx 24rpx; border-bottom: 1rpx solid var(--c-divider); }
.filter-trigger {
  width: 100%; min-height: 88rpx; margin: 0; padding: 0 28rpx;
  display: flex; align-items: center; justify-content: space-between;
  background: #F7F8FF; border: 1rpx solid #DDE4FF; border-radius: var(--r-md);
  color: var(--c-text); font-size: 28rpx; line-height: 1.4;
}
.filter-trigger::after, .filter-item::after { border: none; }
.filter-current { display: flex; align-items: center; gap: 16rpx; font-weight: 600; }
.filter-arrow { color: var(--neon-violet); transition: transform .2s ease; }
.filter-arrow.open { transform: rotate(180deg); }
.filter-panel { display: flex; flex-wrap: wrap; gap: 12rpx; padding-top: 16rpx; }
.filter-item {
  min-height: 88rpx; margin: 0; display: flex; align-items: center;
  flex: 1 0 42%; padding: 0 22rpx; border-radius: var(--r-md);
  font-size: 24rpx; color: var(--c-text-2); background: #FAFAFA;
  border: 1rpx solid var(--c-border); line-height: 1.4;
}
.filter-item.active { background: #EEF2FF; border-color: #C7D2FE; color: #596CD4; font-weight: 600; }
.filter-label { margin-left: 12rpx; }
.status-dot { width: 14rpx; height: 14rpx; border-radius: 50%; flex-shrink: 0; }
.dot-purple { background: #667EEA; }
.dot-orange { background: #F59E0B; }
.dot-green { background: #22C55E; }
.dot-gray { background: #94A3B8; }

.list { padding: 20rpx 24rpx 40rpx; }
.dispute-card {
  background: #FFFFFF; border-radius: var(--r-lg); padding: 24rpx 28rpx;
  margin-bottom: 20rpx; box-shadow: var(--shadow-card);
  transition: transform 0.15s ease;
}
.card-hover { opacity: 0.85; transform: scale(0.98); }
.card-top { display: flex; align-items: center; gap: 16rpx; }
.reason-icon { font-size: 40rpx; flex-shrink: 0; }
.card-grow { flex: 1; min-width: 0; }
.card-title { display: block; font-size: 28rpx; font-weight: 600; color: var(--c-text); }
.card-sub { display: block; font-size: 22rpx; color: var(--c-text-4); margin-top: 4rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.status { flex-shrink: 0; padding: 6rpx 16rpx; border-radius: var(--r-pill); font-size: 22rpx; font-weight: 600; }
.st-orange { color: #A55A00; background: #FFF1DB; }
.st-green { color: #247A43; background: #E8F6ED; }
.st-gray { color: #666E7A; background: #EEF0F3; }
.card-desc {
  margin-top: 14rpx; font-size: 25rpx; color: var(--c-text-2); line-height: 1.6;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.card-footer {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid var(--c-divider);
}
.time { font-size: 22rpx; color: var(--c-text-4); }
.detail-link { font-size: 24rpx; color: var(--neon-violet); }

.empty { display: flex; flex-direction: column; align-items: center; padding: 100rpx 20rpx; }
.empty-icon { font-size: 72rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 30rpx; color: var(--c-text-3); }
.loading { padding: 60rpx 0; text-align: center; color: var(--c-text-3); font-size: 25rpx; }
