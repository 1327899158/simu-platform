.page-container { min-height: 100vh; padding: 20rpx 20rpx calc(140rpx + env(safe-area-inset-bottom)); background: #DDEBD9; box-sizing: border-box; }
.hero-card { position: relative; overflow: hidden; padding: 44rpx 32rpx 34rpx; border-radius: 28rpx; background: linear-gradient(160deg, #BEE3F0 0%, #DDEBD9 100%); box-shadow: 0 12rpx 30rpx rgba(70, 110, 60, .12); }
.hero-orb { position: absolute; border-radius: 50%; opacity: .45; filter: blur(4rpx); }
.orb-one { width: 230rpx; height: 230rpx; top: -85rpx; right: -70rpx; background: #A5E1F7; }
.orb-two { width: 150rpx; height: 150rpx; bottom: -100rpx; left: 25%; background: #F7F3C9; }
.hero-eyebrow, .hero-title-wrap, .hero-title, .hero-subtitle, .hero-desc, .hero-tags, .hero-action { position: relative; z-index: 1; display: block; }
.hero-eyebrow { color: #175D7A; font-size: 24rpx; font-weight: 600; }
.hero-title-wrap { height: 54rpx; margin-top: 14rpx; overflow: hidden; }
.hero-title { color: #1F2B22; font-size: 40rpx; line-height: 1.34; font-weight: 800; letter-spacing: 1rpx; }
/* 底字保持静止；高亮副本只在窄窗口内显现，窗口与副本反向位移，因此只有被扫到的字形提亮。 */
.hero-title-shine-window { position: absolute; z-index: 2; top: 0; left: 0; width: 104rpx; height: 54rpx; overflow: hidden; pointer-events: none; transform: skewX(-18deg) translateX(-130rpx); animation: hero-title-sweep-window 1.6s ease-in-out infinite; }
.hero-title-shine-copy { position: absolute; top: 0; left: 0; width: 700rpx; color: #F5B31A; text-shadow: none; white-space: nowrap; transform: skewX(18deg) translateX(130rpx); animation: hero-title-sweep-copy 1.6s ease-in-out infinite; }
@keyframes hero-title-sweep-window { 0%, 58% { opacity: 0; transform: skewX(-18deg) translateX(-130rpx); } 60% { opacity: 1; } 78% { opacity: 1; transform: skewX(-18deg) translateX(810rpx); } 80%, 100% { opacity: 0; transform: skewX(-18deg) translateX(810rpx); } }
@keyframes hero-title-sweep-copy { 0%, 58% { transform: skewX(18deg) translateX(130rpx); } 78%, 100% { transform: skewX(18deg) translateX(-810rpx); } }
.hero-subtitle { margin-top: 12rpx; color: #5A665C; font-size: 27rpx; font-weight: 600; letter-spacing: 3rpx; }
.hero-desc { margin-top: 8rpx; color: #7C877B; font-size: 22rpx; }
.hero-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 22rpx; }
.hero-tags text { padding: 5rpx 12rpx; border: 1rpx solid #BEE3F0; border-radius: 99rpx; background: rgba(255,255,255,.6); color: #175D7A; font-size: 19rpx; }
.hero-action { width: 290rpx; margin: 24rpx auto 0; padding: 14rpx 0; border-radius: 99rpx; background: linear-gradient(90deg, #20B6F4, #7785F5); color: #FFFFFF; font-size: 29rpx; font-weight: 700; text-align: center; }
.quick-swiper { height: 208rpx; margin-top: 18rpx; }
.quick-card { position: relative; display: flex; align-items: center; justify-content: center; height: 194rpx; overflow: hidden; border-radius: 22rpx; color: #1F2B22; box-shadow: 0 8rpx 18rpx rgba(70, 110, 60, .12); }
.quick-card.release { background: linear-gradient(112deg, #F7F3C9, #F5D33F); }
.quick-card.engineer { background: linear-gradient(112deg, #BEE3F0, #7ED3F2); box-shadow: 0 8rpx 18rpx rgba(70, 110, 60, .12); }
.quick-card.secure { background: linear-gradient(112deg, #E6F4E9, #A5E1F7); box-shadow: 0 8rpx 18rpx rgba(70, 110, 60, .12); }
.quick-light { position: absolute; width: 360rpx; height: 260rpx; top: -140rpx; left: -100rpx; border-radius: 50%; background: rgba(255,255,255,.16); }
.quick-content, .quick-icon { position: relative; z-index: 1; }
.quick-title { display: block; font-size: 34rpx; line-height: 1.35; font-weight: 800; }
.quick-desc { display: block; margin-top: 7rpx; font-size: 25rpx; }
.quick-action { display: block; margin-top: 12rpx; color: #5A665C; font-size: 21rpx; font-weight: 600; }
.quick-icon { margin-left: 28rpx; font-size: 62rpx; transform: rotate(-20deg); }
.carousel-dot { display: flex; justify-content: center; gap: 12rpx; height: 14rpx; margin-top: -10rpx; }
.carousel-dot text { width: 10rpx; height: 10rpx; border-radius: 50%; background: #C6CDD7; }.carousel-dot .on { width: 28rpx; border-radius: 99rpx; background: var(--neon-violet); }
.metric-card { display: flex; align-items: center; margin-top: 18rpx; padding: 22rpx 8rpx; border-radius: 18rpx; background: #FFFFFF; box-shadow: var(--shadow-sm); }
.metric-item { flex: 1; display: flex; flex-direction: column; align-items: center; }.metric-number { color: #2FA8DE; font-size: 31rpx; font-weight: 800; }.metric-label { margin-top: 5rpx; color: var(--c-text-3); font-size: 20rpx; }.metric-divider { width: 1rpx; height: 56rpx; background: var(--c-divider); }
.live-stats { margin-top: 12rpx; color: var(--c-text-3); font-size: 21rpx; text-align: center; }.live-stats text { color: var(--neon-violet); font-weight: 700; }
.platform-data-card { margin-top: 18rpx; padding: 22rpx; border: 1rpx solid #E1EBDD; border-radius: 20rpx; background: #FFFFFF; box-shadow: var(--shadow-sm); }
.data-card-header { display: flex; align-items: center; justify-content: space-between; }.data-card-title { color: var(--c-text); font-size: 27rpx; font-weight: 800; }.data-card-hint { color: var(--c-text-4); font-size: 19rpx; }
.platform-data-grid { display: grid; grid-template-columns: 1fr 1fr; margin-top: 18rpx; overflow: hidden; border: 1rpx solid var(--c-divider); border-radius: 14rpx; }.platform-data-item { display: flex; flex-direction: column; align-items: center; padding: 18rpx 8rpx; background: #FBFDF9; }.platform-data-item:nth-child(1), .platform-data-item:nth-child(2) { border-bottom: 1rpx solid var(--c-divider); }.platform-data-item:nth-child(odd) { border-right: 1rpx solid var(--c-divider); }.platform-data-number { color: #2FA8DE; font-size: 34rpx; font-weight: 800; }.platform-data-label { margin-top: 6rpx; color: var(--c-text-3); font-size: 21rpx; }.data-card-footer { margin-top: 16rpx; color: var(--c-text-3); font-size: 20rpx; text-align: center; }.data-card-footer text { color: #2FA8DE; font-weight: 700; }
.role-card { margin-top: 18rpx; padding: 25rpx 22rpx; border: 1rpx solid #BEE3F0; border-radius: 22rpx; background: linear-gradient(145deg, #FBFCFF, #EAF7FE); }.section-title { display: block; color: var(--c-text); font-size: 32rpx; line-height: 1.3; font-weight: 800; text-align: center; }.section-desc { display: block; margin-top: 7rpx; color: var(--c-text-3); font-size: 23rpx; text-align: center; }.role-grid { display: flex; gap: 14rpx; margin-top: 20rpx; }.role-option { flex: 1; min-width: 0; padding: 16rpx; border: 2rpx solid; border-radius: 16rpx; background: rgba(255,255,255,.65); transition: transform .15s ease, opacity .15s ease; }.role-option:active { transform: scale(.97); opacity: .84; }.role-option.customer { border-color: #7ED3F2; }.role-option.engineer { border-color: #52B788; }.role-top { display: flex; align-items: center; justify-content: space-between; }.role-icon { font-size: 40rpx; }.role-badge { padding: 3rpx 10rpx; border-radius: 99rpx; background: #5BC0EB; color: #FFFFFF; font-size: 17rpx; }.engineer .role-badge, .engineer .role-button { background: #52B788; }.role-name { display: block; margin-top: 8rpx; color: var(--c-text); font-size: 27rpx; font-weight: 800; }.role-copy { display: block; min-height: 60rpx; margin-top: 5rpx; color: var(--c-text-3); font-size: 19rpx; line-height: 1.45; }.role-button { display: inline-block; margin-top: 12rpx; padding: 8rpx 15rpx; border-radius: 99rpx; background: #5BC0EB; color: #FFFFFF; font-size: 20rpx; font-weight: 700; }
.benefit-section { margin-top: 22rpx; padding: 4rpx 0 0; }.benefit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 18rpx; }.benefit-item { min-height: 192rpx; padding: 20rpx 14rpx; border-radius: 18rpx; background: #FFFFFF; text-align: center; box-sizing: border-box; }.benefit-icon { display: flex; width: 54rpx; height: 54rpx; margin: 0 auto; align-items: center; justify-content: center; border-radius: 50%; font-size: 29rpx; }.blue { background: #E5F5FC; }.purple { background: #F7F3C9; }.green { background: #E5F8EF; }.gold { background: #FFF5D9; }.benefit-title { display: block; margin-top: 10rpx; color: var(--c-text); font-size: 26rpx; font-weight: 700; }.benefit-desc { display: block; margin-top: 7rpx; color: var(--c-text-3); font-size: 19rpx; line-height: 1.5; }
.guest-tabbar { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; display: flex; height: calc(112rpx + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); background: rgba(255,255,255,.98); border-top: 1rpx solid var(--c-border); box-shadow: 0 -4rpx 16rpx rgba(26,26,46,.06); box-sizing: border-box; }.guest-tab { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5rpx; color: var(--c-text-3); font-size: 20rpx; }.guest-tab.active { color: var(--neon-violet); font-weight: 700; }.tab-icon { font-size: 34rpx; line-height: 1; }
