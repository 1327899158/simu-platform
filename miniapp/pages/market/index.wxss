.market-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--bg-base);
}

.market-summary {
  display: flex;
  align-items: stretch;
  padding: 34rpx 28rpx;
  border-radius: var(--r-lg);
  background: var(--grad-violet-pink);
  box-shadow: var(--glow-primary);
  color: #FFFFFF;
}
.summary-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.summary-number { font-size: 54rpx; line-height: 1.15; font-weight: 800; }
.summary-label { margin-top: 8rpx; font-size: 25rpx; color: rgba(255,255,255,.88); }
.summary-divider { width: 1rpx; margin: 4rpx 28rpx; background: rgba(255,255,255,.28); }
.today-number { font-size: 52rpx; line-height: 1.15; font-weight: 800; color: #FDE047; }
.today-label { margin-top: 8rpx; font-size: 25rpx; font-weight: 600; color: #FDE047; }

.control-card {
  margin-top: 24rpx;
  padding: 26rpx 24rpx;
  border: 1rpx solid var(--c-border);
  border-radius: var(--r-lg);
  background: #FFFFFF;
  box-shadow: var(--shadow-card);
}
.control-head, .sort-row, .list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.control-title { font-size: 27rpx; font-weight: 700; color: var(--c-text); }
.control-value { font-size: 23rpx; color: var(--neon-violet); }
.category-scroll { width: 100%; margin-top: 16rpx; white-space: nowrap; }
.category-row { display: inline-flex; gap: 14rpx; padding-right: 24rpx; }
.filter-chip, .sort-option {
  min-height: 88rpx;
  margin: 0;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--c-border);
  border-radius: var(--r-pill);
  background: #F8F7FC;
  color: var(--c-text-2);
  font-size: 25rpx;
  line-height: 1.3;
}
.filter-chip::after, .sort-option::after, .quote-btn::after { border: none; }
.filter-chip.active {
  border-color: #7C3AED;
  background: #F1E8FF;
  color: #5B21B6;
  font-weight: 700;
}
.sort-row { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--c-divider); }
.sort-switch { display: flex; padding: 4rpx; border-radius: var(--r-pill); background: #F2F0F7; }
.sort-option { min-height: 88rpx; min-width: 142rpx; padding: 0 22rpx; border: none; background: transparent; }
.sort-option.active { background: var(--grad-violet-pink); color: #FFFFFF; box-shadow: var(--glow-violet); font-weight: 700; }
.sort-hint { display: block; margin-top: 12rpx; text-align: right; color: var(--c-text-3); font-size: 22rpx; }

.list-head { margin: 30rpx 4rpx 16rpx; }
.list-title { font-size: 31rpx; font-weight: 800; color: var(--c-text); }
.list-count { font-size: 23rpx; color: var(--c-text-3); }
.demand-card {
  margin-bottom: 20rpx;
  padding: 26rpx;
  border: 1rpx solid var(--c-border);
  border-radius: var(--r-lg);
  background: #FFFFFF;
  box-shadow: var(--shadow-card);
  transition: transform .15s ease, opacity .15s ease;
}
.demand-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.demand-title { flex: 1; min-width: 0; font-size: 30rpx; font-weight: 700; color: var(--c-text); }
.time-text { flex-shrink: 0; font-size: 21rpx; color: var(--c-text-3); }
.tag-row { margin-top: 14rpx; }
.demand-data { display: flex; flex-wrap: wrap; gap: 14rpx 24rpx; margin-top: 12rpx; color: var(--c-text-2); font-size: 23rpx; }
.price { color: var(--c-money); font-weight: 800; }
.demand-foot { min-height: 88rpx; margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid var(--c-divider); display: flex; align-items: center; justify-content: flex-end; gap: 18rpx; }
.hot-text { margin-right: auto; color: #7C3AED; font-size: 24rpx; font-weight: 700; }
.quoted-text { color: #15803D; font-size: 25rpx; font-weight: 700; }
.quote-btn { min-width: 176rpx; min-height: 88rpx; margin: 0; padding: 0 28rpx; background: var(--grad-violet-pink); color: #FFFFFF; border-radius: var(--r-pill); font-size: 26rpx; font-weight: 700; line-height: 1.3; }
.quote-btn:active { transform: scale(.97); opacity: .88; }
.empty-state { padding: 100rpx 24rpx; display: flex; flex-direction: column; align-items: center; }
.empty-icon { font-size: 68rpx; }
.empty-title { margin-top: 18rpx; font-size: 30rpx; font-weight: 700; color: var(--c-text); }
.empty-desc { margin-top: 8rpx; font-size: 24rpx; color: var(--c-text-3); }
.loading-text { padding: 70rpx 0; text-align: center; color: var(--c-text-3); font-size: 25rpx; }
