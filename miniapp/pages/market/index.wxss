.page-container {
  min-height: 100vh;
  background: #DDEBD9;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F2F5;
}
.page-title {
  display: block;
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: #1A1A2E;
}
.page-subtitle {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #767676;
}
.hint-text {
  font-size: 24rpx;
  color: #767676;
}

.stats-card {
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin: 12rpx 20rpx 0;
  padding: 20rpx 16rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--c-border);
  box-shadow: var(--shadow-card);
}
.stat-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.stat-number {
  font-size: 52rpx;
  line-height: 62rpx;
  font-weight: 800;
  color: #E85A4F;
  letter-spacing: 2rpx;
}
.stat-info {
  display: flex;
  flex-direction: column;
}
.stat-label {
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 600;
  color: #5A665C;
}
.stat-desc {
  margin-top: 2rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: #9AA59A;
}
.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #E1EBDD;
}
.stat-item.highlight .stat-number,
.stat-item.highlight .stat-label {
  color: #B98A00;
}

.filter-sort-container {
  margin: 12rpx 20rpx 0;
  padding: 16rpx 20rpx 20rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}
.filter-section {
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F2F5;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A2E;
}
.section-hint {
  font-size: 22rpx;
  color: #767676;
}
.filter-bar,
.sort-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 14rpx;
}
.filter-item,
.sort-item {
  min-height: 88rpx;
  margin: 0;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border: 2rpx solid transparent;
  border-radius: 44rpx;
  background: #F5F6FA;
  color: #4B5563;
  font-size: 24rpx;
  line-height: 1.3;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.filter-item::after,
.sort-item::after,
.quote-btn::after {
  border: none;
}
.filter-item:active,
.sort-item:active,
.quote-btn:active {
  transform: scale(0.97);
  opacity: 0.86;
}
.filter-item.active {
  border-color: #5BC0EB;
  background: #5BC0EB;
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.28);
}
.filter-name,
.sort-name {
  font-weight: 500;
}
.filter-check {
  font-size: 18rpx;
  font-weight: 700;
}
.sort-item {
  min-width: 174rpx;
  color: #767676;
}
.sort-item.active {
  border-color: #5BC0EB;
  background: #E3F4FC;
  color: #2FA8DE;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.18);
}
.sort-icon {
  font-size: 24rpx;
}
.sort-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #767676;
}

.requirement-list {
  flex: 1;
  padding: 12rpx 20rpx 0;
}
.requirement-card {
  margin-bottom: 14rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #F0F2F5;
  border-radius: 16rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.req-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 10rpx;
}
.req-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 600;
  color: #1A1A2E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.req-status {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 600;
}
.req-status.quoting {
  background: #E3F4FC;
  color: #2FA8DE;
}
.req-status.quoted {
  background: #E8F5E9;
  color: #2E7D32;
}
.req-description {
  display: -webkit-box;
  margin-bottom: 12rpx;
  color: #4B5563;
  font-size: 24rpx;
  line-height: 36rpx;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.req-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 14rpx;
}
.req-tags .tag {
  margin: 0;
  padding: 4rpx 14rpx;
  border: none;
  border-radius: 12rpx;
  background: #E3F4FC;
  color: #2FA8DE;
  font-size: 20rpx;
}
.req-data {
  display: flex;
  padding: 14rpx 0;
  border-top: 1rpx solid #F0F2F5;
  border-bottom: 1rpx solid #F0F2F5;
}
.data-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.data-label {
  color: #767676;
  font-size: 20rpx;
}
.data-value {
  color: #1A1A2E;
  font-size: 24rpx;
  font-weight: 600;
}
.budget-item .data-value {
  color: #E85A4F;
}
.req-footer {
  min-height: 88rpx;
  padding-top: 10rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}
.req-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx 16rpx;
}
.req-time,
.req-quote-count,
.req-hot {
  font-size: 20rpx;
  color: #767676;
}
.req-hot {
  color: #2FA8DE;
  font-weight: 600;
}
.quoted-text {
  flex-shrink: 0;
  color: #2E7D32;
  font-size: 24rpx;
  font-weight: 700;
}
.quote-btn {
  min-width: 168rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #5BC0EB 0%, #2FA8DE 100%);
  color: #FFFFFF;
  font-size: 25rpx;
  line-height: 1.3;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.24);
}
.empty-state,
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 20rpx;
}
.empty-icon {
  margin-bottom: 12rpx;
  font-size: 72rpx;
}
.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A2E;
}
.empty-desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #767676;
}
.loading-state {
  gap: 12rpx;
  color: #767676;
  font-size: 24rpx;
}
.spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #E4E7EE;
  border-top-color: #5BC0EB;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* ===== design rebuild ===== */
.quote-btn { transform: skewX(-12deg); border-radius: 12rpx; }
.quote-btn .btn-in { display: inline-block; transform: skewX(12deg); }
.req-data { background: #F4F8F2; border-radius: 16rpx; padding: 14rpx 20rpx; }
.requirement-card { border-radius: 32rpx; }

/* ===== design 1:1 ===== */
.page-header { background: linear-gradient(160deg, #BEE3F0 0%, #DDEBD9 100%); border-radius: 32rpx; border-bottom: none; position: relative; }
.header-illust { position: absolute; right: 20rpx; top: 10rpx; width: 150rpx; height: 150rpx; }
.stats-card { border-radius: 32rpx; }
