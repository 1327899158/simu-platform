/* ===== 发布需求 · 浅色商务（布局参照 new_simu requirementCreate） ===== */
.page-container {
  min-height: 100vh;
  background-color: var(--bg-base);
  padding-bottom: 40rpx;
}

/* ===== 页头 ===== */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--c-divider);
}
.page-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--c-text);
}
.step-indicator {
  font-size: 24rpx;
  color: var(--c-text-3);
  background: #F0F0F0;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* ===== 5步进度条 ===== */
.progress-steps {
  display: flex;
  align-items: center;
  padding: 28rpx 48rpx 0;
  background: #FFFFFF;
}
.step {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #E8E8E8;
  color: var(--c-text-3);
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.25s ease;
}
.step.active {
  background: var(--neon-violet);
  color: #FFFFFF;
  box-shadow: var(--glow-primary);
}
.step-line {
  flex: 1;
  height: 4rpx;
  background: #E8E8E8;
  margin: 0 8rpx;
  border-radius: 2rpx;
  transition: background 0.25s ease;
}
.step-line.active {
  background: var(--neon-violet);
}
.step-labels {
  display: flex;
  padding: 12rpx 24rpx 20rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--c-divider);
}
.step-labels text {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: var(--c-text-3);
}

/* ===== 表单区块 ===== */
.form-section {
  background: #FFFFFF;
  border-radius: var(--r-lg);
  margin: 20rpx 24rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-card);
}
.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 8rpx;
}
.section-desc {
  display: block;
  font-size: 24rpx;
  color: var(--c-text-3);
  margin-bottom: 20rpx;
}

/* ===== 表单组 ===== */
.form-group {
  margin-bottom: 24rpx;
}
.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--c-text-2);
  margin-bottom: 12rpx;
}
.required {
  color: var(--neon-red);
}
.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #DDDDDD;
  border-radius: var(--r-md);
  font-size: 28rpx;
  color: var(--c-text);
  background: #FAFAFA;
  box-sizing: border-box;
}
.form-input:focus {
  border-color: var(--neon-violet);
  background: #FFFFFF;
}
.form-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx;
  border: 1rpx solid #DDDDDD;
  border-radius: var(--r-md);
  font-size: 28rpx;
  color: var(--c-text);
  background: #FAFAFA;
  box-sizing: border-box;
  line-height: 1.6;
}
.form-textarea:focus {
  border-color: var(--neon-violet);
  background: #FFFFFF;
}
.char-count {
  display: block;
  text-align: right;
  font-size: 20rpx;
  color: var(--c-text-4);
  margin-top: 6rpx;
}
.form-hint {
  font-size: 22rpx;
  color: var(--c-text-3);
  font-weight: 400;
}
.flexible-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* ===== 多选网格 ===== */
.multi-select-grid {
  display: grid;
  gap: 12rpx;
}
.multi-select-grid.three-col {
  grid-template-columns: repeat(3, 1fr);
}
.select-item {
  position: relative;
  padding: 16rpx 8rpx;
  text-align: center;
  background: #FAFAFA;
  border: 2rpx solid #E8E8E8;
  border-radius: var(--r-md);
  transition: all 0.2s ease;
}
.select-item:active { transform: scale(0.95); }
.select-item.selected {
  background: #EBF5FB;
  border-color: var(--neon-violet);
}
.select-label {
  font-size: 22rpx;
  color: var(--c-text-2);
  display: block;
}
.select-item.selected .select-label {
  color: var(--neon-violet);
  font-weight: 600;
}
.select-checkbox {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--neon-violet);
  color: #FFFFFF;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.selected-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--c-text-3);
  margin-top: 10rpx;
}
.other-input {
  margin-top: 16rpx;
  border-color: #C4B5FD;
  background: #FAF7FF;
}

/* ===== 工期选择 ===== */
.deadline-options {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}
.deadline-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  background: #FAFAFA;
  border: 2rpx solid #E8E8E8;
  border-radius: var(--r-md);
  transition: all 0.2s ease;
}
.deadline-item:active { transform: scale(0.95); }
.deadline-item.active {
  background: #EBF5FB;
  border-color: var(--neon-violet);
}
.deadline-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.deadline-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--c-text-2);
}
.deadline-item.active .deadline-label {
  color: var(--neon-violet);
}
.deadline-days {
  font-size: 20rpx;
  color: var(--c-text-3);
  margin-top: 4rpx;
}
.custom-days {
  margin-top: 16rpx;
}
.custom-days .form-hint {
  display: block;
  margin-top: 8rpx;
}

/* ===== 上传须知（红色提醒框） ===== */
.upload-rule-box {
  display: flex;
  gap: 16rpx;
  background: #FDF2F0;
  border: 1rpx solid #F5C6C0;
  border-radius: var(--r-md);
  padding: 20rpx;
  margin-bottom: 24rpx;
}
.rule-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}
.rule-content {
  flex: 1;
  min-width: 0;
}
.rule-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--neon-red);
  margin-bottom: 8rpx;
}
.rule-item {
  display: block;
  font-size: 22rpx;
  color: #B03A2E;
  line-height: 1.7;
}

/* ===== 上传区 ===== */
.upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 20rpx;
  border: 2rpx dashed #CCCCCC;
  border-radius: var(--r-md);
  background: #FAFAFA;
  transition: all 0.2s ease;
}
.upload-area:active {
  border-color: var(--neon-violet);
  background: #EBF5FB;
}
.upload-area.disabled {
  opacity: 0.6;
  border-style: solid;
}
.upload-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}
.upload-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-text-2);
}
.upload-hint {
  font-size: 22rpx;
  color: var(--c-text-3);
  margin-top: 6rpx;
}

/* ===== 文件列表 ===== */
.file-list {
  margin-top: 16rpx;
}
.file-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #F8F9FA;
  border-radius: var(--r-sm);
  margin-bottom: 12rpx;
}
.file-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}
.file-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--c-text);
  margin-left: 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.file-size {
  font-size: 22rpx;
  color: var(--c-text-3);
  flex-shrink: 0;
  margin-left: 12rpx;
}
.file-delete {
  font-size: 28rpx;
  color: var(--c-text-4);
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.file-delete:active {
  color: var(--neon-red);
}

/* ===== 确认汇总 ===== */
.summary-card {
  background: #F8F9FA;
  border-radius: var(--r-md);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}
.summary-item {
  display: flex;
  padding: 12rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid #EEEEEE;
}
.summary-item:last-child {
  border-bottom: none;
}
.summary-label {
  width: 150rpx;
  flex-shrink: 0;
  color: var(--c-text-3);
}
.summary-value {
  flex: 1;
  min-width: 0;
  color: var(--c-text);
  word-break: break-all;
}
.summary-value.price {
  color: var(--c-money);
  font-weight: 700;
}

/* ===== 服务条款 ===== */
.terms {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.checkbox-box {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #CCCCCC;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FFFFFF;
  flex-shrink: 0;
  transition: all 0.2s ease;
}
.checkbox-box.checked {
  background: var(--neon-violet);
  border-color: var(--neon-violet);
}
.terms-text {
  font-size: 24rpx;
  color: var(--c-text-2);
}
.terms-link {
  color: var(--neon-cyan);
}

/* ===== 按钮 ===== */
.btn-primary-block {
  width: 100%;
  padding: 22rpx 0;
  border: none;
  border-radius: var(--r-md);
  background: var(--grad-violet-pink);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: var(--glow-primary);
  line-height: 1.5;
}
.btn-primary-block::after { border: none; }
.btn-primary-block:active {
  transform: scale(0.98);
  opacity: 0.9;
}
.btn-success-block {
  width: 100%;
  padding: 22rpx 0;
  border: none;
  border-radius: var(--r-md);
  background: linear-gradient(135deg, #52B788, #3E9B72);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(39, 174, 96, 0.25);
  line-height: 1.5;
}
.btn-success-block::after { border: none; }
.btn-success-block:active {
  transform: scale(0.98);
  opacity: 0.9;
}
.btn-success-block.disabled {
  opacity: 0.5;
}
.form-actions-row {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.btn-secondary {
  flex: 1;
  padding: 20rpx 0;
  border: 1rpx solid #DDDDDD;
  border-radius: var(--r-md);
  background: #FFFFFF;
  color: var(--c-text-2);
  font-size: 28rpx;
  line-height: 1.5;
}
.btn-secondary::after { border: none; }
.btn-secondary:active {
  background: #F5F5F5;
}
.btn-primary-sm {
  flex: 1;
  padding: 20rpx 0;
  border: none;
  border-radius: var(--r-md);
  background: var(--grad-violet-pink);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: var(--glow-primary);
  line-height: 1.5;
}
.btn-primary-sm::after { border: none; }
.btn-primary-sm:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* ===== design rebuild ===== */
.section-title { display: inline-block; background: linear-gradient(transparent 62%, #F5D33F 62%); padding: 0 8rpx; }
.btn-primary-block, .btn-success-block, .btn-primary-sm, .btn-secondary { border-radius: 999rpx; }

/* ===== design 1:1 ===== */
.form-section { background: #FFFFFF; border-radius: 32rpx; box-shadow: 0 2rpx 12rpx rgba(70,110,60,.06); }
.form-input, .form-textarea { background: #FBFDF9; border: 1rpx solid #E1EBDD; border-radius: 16rpx; }
.select-item { border-radius: 999rpx; border: 1rpx solid #E1EBDD; }
.select-item.selected { background: #5BC0EB; color: #FFFFFF; border-color: transparent; }
.deadline-item { border-radius: 24rpx; border: 1rpx solid #E1EBDD; }
.deadline-item.active { border-color: #5BC0EB; background: #E3F4FC; }
.progress-steps .step { background: #D8E2D4; }
.progress-steps .step.active { background: #5BC0EB; }
.step-line.active { background: #5BC0EB; }
