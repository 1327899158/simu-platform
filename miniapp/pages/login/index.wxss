.wrap {
  padding: 88rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
}
.wrap::before {
  content: "";
  position: absolute;
  top: 40rpx;
  left: 50%;
  width: 460rpx;
  height: 460rpx;
  transform: translateX(-50%);
  background: radial-gradient(circle, rgba(168, 85, 247, 0.22), transparent 65%);
  z-index: 0;
  pointer-events: none;
}

/* ---------- 角色选择 ---------- */
.logo-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  position: relative;
  z-index: 1;
  animation: neon-rise 0.5s ease-out both;
}
.logo-img {
  width: 88rpx; height: 88rpx;
  border-radius: var(--r-lg);
  flex-shrink: 0;
  border: 1rpx solid rgba(34, 211, 238, 0.5);
  box-shadow: var(--glow-cyan);
}
.logo {
  font-size: 52rpx; font-weight: 700;
  background: var(--grad-neon);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
  color: var(--neon-violet-2);
  letter-spacing: 3rpx;
}
.slogan {
  text-align: center;
  color: var(--c-text-3);
  margin: 22rpx 0 76rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  position: relative; z-index: 1;
  animation: neon-rise 0.5s ease-out 0.08s both;
}
.role-btn {
  border-radius: var(--r-xl);
  padding: 44rpx 40rpx;
  margin-bottom: 28rpx;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 32rpx;
  position: relative;
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.25s ease;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  animation: neon-rise 0.5s ease-out both;
}
.role-btn:nth-of-type(2) { animation-delay: 0.16s; }
.role-btn:active { transform: scale(0.97); }
.role-btn.dim { opacity: 0.5; }
.role-btn::before {
  content: "";
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.07) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1rpx, transparent 1rpx);
  background-size: 40rpx 40rpx;
}
.role-btn::after {
  content: "";
  position: absolute; top: -40rpx; right: -40rpx;
  width: 180rpx; height: 180rpx; border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}
.role-icon {
  width: 84rpx; height: 84rpx;
  flex-shrink: 0; position: relative; z-index: 1;
  border-radius: var(--r-md);
}
.role-info { position: relative; z-index: 1; }
.role-name {
  font-size: 38rpx; font-weight: 700;
  letter-spacing: 2rpx;
  text-shadow: 0 0 16rpx rgba(255, 255, 255, 0.25);
}
.role-desc {
  font-size: 24rpx; opacity: 0.88; margin-top: 10rpx;
  letter-spacing: 1rpx;
}
.customer {
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.35), rgba(168, 85, 247, 0.55));
  box-shadow: 0 8rpx 40rpx rgba(168, 85, 247, 0.3), inset 0 1rpx 0 rgba(255, 255, 255, 0.15);
}
.engineer {
  background: linear-gradient(135deg, rgba(34, 211, 238, 0.35), rgba(59, 130, 246, 0.55));
  box-shadow: 0 8rpx 40rpx rgba(34, 211, 238, 0.3), inset 0 1rpx 0 rgba(255, 255, 255, 0.15);
}
.tip {
  color: var(--c-text-4);
  font-size: 22rpx;
  text-align: center;
  margin-top: 60rpx;
  line-height: 1.7;
  letter-spacing: 1rpx;
}

/* ---------- 通用：返回 / 标题 ---------- */
.back {
  display: inline-block;
  color: var(--neon-cyan-2);
  font-size: 28rpx;
  padding: 12rpx 0;
  letter-spacing: 1rpx;
}
.method-title {
  font-size: 44rpx; font-weight: 700;
  background: var(--grad-violet-pink);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
  color: var(--neon-violet-2);
  letter-spacing: 2rpx;
  margin: 24rpx 0 36rpx;
  animation: neon-rise 0.4s ease-out both;
}

/* ---------- 方式切换 ---------- */
.method-switch {
  display: flex;
  gap: 12rpx;
  margin-bottom: 32rpx;
  animation: neon-rise 0.4s ease-out both;
}
.ms-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: var(--c-text-3);
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid var(--c-border);
  border-radius: var(--r-md);
  transition: color 0.18s ease, background 0.18s ease, border-color 0.18s ease;
}
.ms-item.on {
  color: #fff;
  background: var(--grad-violet-pink);
  border-color: transparent;
  font-weight: 600;
  box-shadow: var(--glow-violet);
}

/* ---------- 登录卡 / 表单 ---------- */
.auth-card {
  background: var(--bg-card);
  border: 1rpx solid var(--c-border);
  border-radius: var(--r-lg);
  padding: 36rpx 28rpx;
  box-shadow: var(--shadow-sm);
  animation: neon-rise 0.4s ease-out both;
}
.field { margin-bottom: 28rpx; }
.field-label {
  display: block;
  font-size: 24rpx;
  color: var(--c-text-3);
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}
.field-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: rgba(8, 6, 15, 0.55);
  border: 1rpx solid rgba(168, 85, 247, 0.25);
  border-radius: var(--r-md);
  font-size: 30rpx;
  color: var(--c-text);
  box-sizing: border-box;
  transition: border-color 0.2s ease;
}
.field-input:focus { border-color: var(--neon-cyan); }

.code-row { display: flex; gap: 16rpx; }
.code-input { flex: 1; }
.code-btn {
  flex-shrink: 0;
  width: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--neon-cyan-2);
  background: rgba(34, 211, 238, 0.08);
  border: 1rpx solid rgba(34, 211, 238, 0.4);
  border-radius: var(--r-md);
  transition: background 0.18s ease;
}
.code-btn:active { background: rgba(34, 211, 238, 0.16); }
.code-btn.dis { color: var(--c-text-4); border-color: var(--c-border); }

.sent-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--neon-amber);
  letter-spacing: 1rpx;
}

.submit-btn { margin-top: 16rpx; }
.link-row {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
}
.link {
  font-size: 24rpx;
  color: var(--neon-cyan-2);
  letter-spacing: 1rpx;
}
.link:active { opacity: 0.6; }

/* ---------- 反馈类 ---------- */
.row-hover { opacity: 0.7; }
.btn-press { transform: scale(0.97); opacity: 0.9; }
