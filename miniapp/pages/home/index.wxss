/* ===== 首页 · 浅色商务（布局参照 new_simu customerHome / engineerHome） ===== */
.page-container {
  min-height: 100vh;
  background-color: var(--bg-base);
  padding: 20rpx 24rpx 40rpx;
  box-sizing: border-box;
}

/* ===== 顶部欢迎卡片（深色主色卡 · 视觉焦点） ===== */
.welcome-card {
  display: flex;
  align-items: center;
  background: var(--grad-violet-pink);
  border-radius: var(--r-lg);
  padding: 32rpx 28rpx;
  box-shadow: var(--glow-primary);
  margin-bottom: 20rpx;
}
.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  flex-shrink: 0;
  overflow: hidden;
}
.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.18);
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 600;
}
.welcome-text {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.greeting {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.role-badge {
  display: inline-flex;
  align-self: flex-start;
  font-size: 22rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.18);
  padding: 4rpx 18rpx;
  border-radius: var(--r-pill);
}
.welcome-right {
  flex-shrink: 0;
}
.profile-link {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  padding: 10rpx 4rpx;
}
.profile-link:active { opacity: 0.6; }

/* ===== 快捷操作 ===== */
.quick-actions {
  display: flex;
  gap: 16rpx;
  background: #FFFFFF;
  border-radius: var(--r-lg);
  padding: 28rpx 16rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 20rpx;
}
.quick-actions.three {
  display: flex;
}
.action-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 0;
  border-radius: var(--r-md);
  transition: transform 0.15s ease;
}
.action-item:active {
  transform: scale(0.94);
  background: #F5F6F7;
}
.action-icon {
  font-size: 48rpx;
}
.action-label {
  font-size: 24rpx;
  color: var(--c-text-2);
}
.action-notice {
  position: absolute;
  top: -8rpx;
  right: 10rpx;
  z-index: 1;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 7rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 3rpx solid #FFFFFF;
  border-radius: 999rpx;
  background: #E5484D;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
}

/* ===== 通用区块 ===== */
.section {
  background: #FFFFFF;
  border-radius: var(--r-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 20rpx;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--c-text);
}
.section-more {
  font-size: 24rpx;
  color: var(--c-text-3);
  padding: 6rpx 0;
}
.section-more:active { opacity: 0.6; }
.hall-link {
  min-height: 88rpx;
  margin: 0;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  background: transparent;
  color: var(--neon-violet);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}
.hall-link::after { border: none; }
.hall-link:active { opacity: .65; }

/* ===== 订单状态统计 ===== */
.order-stats {
  display: flex;
  flex-wrap: wrap;
}
.stat-item {
  flex: 1 0 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 0;
  border-radius: var(--r-md);
}
.stat-item:active {
  background: #F5F6F7;
}
.stat-number {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--neon-violet);
}
.stat-label {
  font-size: 20rpx;
  color: var(--c-text-3);
}

/* ===== 我的需求列表项 ===== */
.order-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--c-divider);
}
.order-item:last-of-type {
  border-bottom: none;
}
.order-item-hover {
  opacity: 0.7;
}
.order-item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.order-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.order-meta {
  font-size: 22rpx;
  color: var(--c-text-3);
}
.order-item .status {
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ===== 筛选行 ===== */
.filter-row {
  white-space: nowrap;
  margin-bottom: 12rpx;
}

/* ===== 需求大厅列表项 ===== */
.demand-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--c-divider);
}
.demand-item:last-of-type {
  border-bottom: none;
}
.demand-item-hover {
  opacity: 0.75;
}
.demand-info {
  flex: 1;
  min-width: 0;
}
.demand-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-text);
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.demand-tags {
  margin-top: 10rpx;
}
.demand-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 8rpx;
}
.meta-item {
  font-size: 22rpx;
  color: var(--c-text-3);
}
.btn-quote {
  flex-shrink: 0;
  margin: 0 0 0 20rpx;
  padding: 12rpx 36rpx;
  border: none;
  border-radius: var(--r-pill);
  background: var(--grad-violet-pink);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: var(--glow-primary);
  line-height: 1.5;
}
.btn-quote::after { border: none; }
.btn-quote:active {
  transform: scale(0.94);
  opacity: 0.9;
}
.quoted-badge {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: 22rpx;
  color: var(--neon-green);
  background: #E8F5E9;
  border: 1rpx solid #C8E6C9;
  padding: 8rpx 20rpx;
  border-radius: var(--r-pill);
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 20rpx;
}
.empty-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}
.empty-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-text);
}
.empty-desc {
  font-size: 24rpx;
  color: var(--c-text-3);
  margin-top: 8rpx;
}
