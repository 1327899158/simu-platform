.hero {
  background: linear-gradient(135deg,#1890FF,#36A3FF); border-radius: 16rpx;
  padding: 40rpx; color: #fff; margin-bottom: 24rpx;
}
.hero-title { font-size: 40rpx; font-weight: 700; }
.hero-sub { font-size: 24rpx; opacity: .85; margin: 8rpx 0 24rpx; }
.hero-btn {
  background: #fff; color: #1890FF; border-radius: 8rpx; text-align: center;
  padding: 16rpx 0; font-size: 32rpx; font-weight: 600;
}
.stat-row { display: flex; margin-top: 24rpx; }
.stat { flex: 1; text-align: center; }
.num { font-size: 40rpx; font-weight: 700; color: #1890FF; }
.filter { white-space: nowrap; margin-bottom: 8rpx; }
