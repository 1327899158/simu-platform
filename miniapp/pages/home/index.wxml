<view class="page-container">

  <!-- ========== 客户视图 ========== -->
  <block wx:if="{{role === 'CUSTOMER'}}">
    <!-- 顶部欢迎卡片 -->
    <view class="welcome-card">
      <image wx:if="{{user.avatarUrl}}" class="avatar" src="{{user.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-fallback">{{user.nickname ? user.nickname[0] : '客'}}</view>
      <view class="welcome-text">
        <text class="greeting">你好，{{user.nickname || '客户'}}</text>
        <text class="role-badge">👤 客户</text>
      </view>
    </view>

    <!-- 快捷操作 -->
    <view class="quick-actions">
      <view class="action-item" bindtap="goPublish">
        <text class="action-icon">📝</text>
        <text class="action-label">发布需求</text>
      </view>
      <view class="action-item" bindtap="goOrders">
        <text class="action-icon">📋</text>
        <text class="action-label">我的订单</text>
      </view>
      <view class="action-item" bindtap="goMessages">
        <text class="action-icon">💬</text>
        <text class="action-label">消息</text>
      </view>
      <view class="action-item" bindtap="goMe">
        <text class="action-icon">👤</text>
        <text class="action-label">个人中心</text>
      </view>
    </view>

    <!-- 订单状态统计 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">我的订单</text>
        <text class="section-more" bindtap="goOrders">查看全部 ›</text>
      </view>
      <view class="order-stats">
        <view class="stat-item" bindtap="goOrders">
          <text class="stat-number">{{counts.QUOTING}}</text>
          <text class="stat-label">待报价</text>
        </view>
        <view class="stat-item" bindtap="goOrders">
          <text class="stat-number">{{counts.AWAITING_PAYMENT}}</text>
          <text class="stat-label">待支付</text>
        </view>
        <view class="stat-item" bindtap="goOrders">
          <text class="stat-number">{{counts.IN_PROGRESS}}</text>
          <text class="stat-label">执行中</text>
        </view>
        <view class="stat-item" bindtap="goOrders">
          <text class="stat-number">{{counts.DELIVERED}}</text>
          <text class="stat-label">待验收</text>
        </view>
      </view>
    </view>

    <!-- 我的需求列表 -->
    <view class="section">
      <text class="section-title">我的需求</text>
      <view wx:for="{{recent}}" wx:key="id" class="order-item" data-id="{{item.id}}"
        bindtap="openMine" hover-class="order-item-hover" hover-stay-time="80">
        <view class="order-item-main">
          <text class="order-title">{{item.projectName}}</text>
          <text class="order-meta">{{item.time}} · {{item.quoteCount}} 人报价 · ¥{{item.budgetY}}</text>
        </view>
        <text class="status {{item.cls}}">{{item.statusText}}</text>
      </view>
      <view class="empty-state" wx:if="{{!recent.length}}">
        <text class="empty-icon">📭</text>
        <text class="empty-text">暂无需求</text>
        <text class="empty-desc">点上方「发布需求」创建第一个需求</text>
      </view>
    </view>
  </block>

  <!-- ========== 工程师视图（抢单大厅） ========== -->
  <block wx:if="{{role === 'ENGINEER'}}">
    <!-- 顶部欢迎卡片 -->
    <view class="welcome-card">
      <image wx:if="{{user.avatarUrl}}" class="avatar" src="{{user.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-fallback">{{user.nickname ? user.nickname[0] : '工'}}</view>
      <view class="welcome-text">
        <text class="greeting">🛠️ 你好，{{user.nickname || '工程师'}}</text>
        <text class="role-badge">工程师</text>
      </view>
      <view class="welcome-right" bindtap="goProfile">
        <text class="profile-link">查看资料 ›</text>
      </view>
    </view>

    <!-- 快捷操作 -->
    <view class="quick-actions three">
      <view class="action-item" bindtap="goMyQuotes">
        <text class="action-icon">📋</text>
        <text class="action-label">我的报价</text>
      </view>
      <view class="action-item" bindtap="goMessages">
        <text class="action-icon">💬</text>
        <text class="action-label">消息</text>
      </view>
      <view class="action-item" bindtap="goMe">
        <text class="action-icon">👤</text>
        <text class="action-label">个人中心</text>
      </view>
    </view>

    <!-- 可接单需求列表 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">📌 可接单需求</text>
        <button class="hall-link" wx:if="{{canTakeOrders}}" bindtap="goMarketHall">去接单大厅 ›</button>
      </view>

      <view wx:for="{{hall}}" wx:key="id" class="demand-item" data-id="{{item.id}}"
        bindtap="openMarket" hover-class="demand-item-hover" hover-stay-time="80">
        <view class="demand-info">
          <text class="demand-title">{{item.projectName}}</text>
          <view class="demand-tags">
            <text class="tag" wx:for="{{item.directionTags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
          </view>
          <view class="demand-meta">
            <text class="meta-item">💰 ¥{{item.budgetY}}</text>
            <text class="meta-item">📅 工期{{item.deliveryDays}}天</text>
            <text class="meta-item">💬 {{item.quoteCount}}人报价</text>
            <text class="meta-item">👁 {{item.viewCount}}次浏览</text>
          </view>
        </view>
        <button wx:if="{{!item.myQuote}}" class="btn-quote"
          data-id="{{item.id}}" data-flexible="{{item.budgetFlexible ? 1 : 0}}" data-fen="{{item.budgetFen}}"
          catchtap="quickQuote">报价</button>
        <view wx:else class="quoted-badge">已报价</view>
      </view>

      <view class="empty-state" wx:if="{{!hall.length}}">
        <text class="empty-icon">📭</text>
        <text class="empty-text">暂无需求</text>
        <text class="empty-desc">当前没有可接单的需求，下拉刷新试试</text>
      </view>
    </view>
  </block>

</view>
