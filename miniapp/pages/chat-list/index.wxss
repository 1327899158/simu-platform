/* ========== 会话列表 · 霓虹 ========== */
.c-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--grad-violet-pink);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: var(--glow-violet);
  border: 1rpx solid rgba(168, 85, 247, 0.5);
}
.c-avatar-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
  border: 1rpx solid var(--c-border-strong);
  box-shadow: var(--glow-cyan);
}

/* 未读徽章 · 霓虹红 */
.badge {
  display: inline-block;
  min-width: 38rpx;
  height: 38rpx;
  line-height: 38rpx;
  text-align: center;
  background: var(--neon-pink);
  color: #fff;
  border-radius: var(--r-pill);
  font-size: 20rpx;
  font-weight: 600;
  padding: 0 10rpx;
  margin-top: 8rpx;
  box-shadow: 0 0 16rpx rgba(236, 72, 153, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.last {
  margin-top: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-link {
  margin-top: 16rpx;
  color: var(--neon-cyan-2);
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}
