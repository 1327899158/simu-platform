<view class="container">
  <view class="empty" wx:if="{{!items.length}}">支付成功后会自动创建与对方的会话</view>
  <view class="card" wx:for="{{items}}" wx:key="id" bindtap="open" data-id="{{item.id}}">
    <view class="spread">
      <view class="row">
        <view class="c-avatar">{{item.peer.nickname[0]}}</view>
        <view style="margin-left:16rpx">
          <view class="title" style="font-size:28rpx">{{item.peer.nickname}}</view>
          <view class="muted">{{item.order.projectName}}</view>
        </view>
      </view>
      <view style="text-align:right">
        <view class="muted">{{item.time}}</view>
        <view class="badge" wx:if="{{item.unread}}">{{item.unread}}</view>
      </view>
    </view>
    <view class="muted last">{{item.lastText}}</view>
  </view>
</view>
