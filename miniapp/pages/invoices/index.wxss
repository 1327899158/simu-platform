.page-container{min-height:100vh;padding:28rpx 24rpx;box-sizing:border-box;background:var(--bg-base)}.hero{padding:30rpx 28rpx;border-radius:var(--r-lg);background:var(--grad-violet-pink);color:#fff}.hero-title,.hero-desc,.title,.desc,.order-link{display:block}.hero-title{font-size:36rpx;font-weight:700}.hero-desc{margin-top:10rpx;font-size:23rpx;line-height:1.6;color:rgba(255,255,255,.84)}.card{margin-top:22rpx;padding:26rpx;border-radius:var(--r-lg);background:#fff;box-shadow:var(--shadow-card)}.row{display:flex;gap:16rpx;align-items:center;justify-content:space-between}.title{flex:1;min-width:0;font-size:30rpx;font-weight:700;color:var(--c-text);word-break:break-all}.status{flex-shrink:0;padding:6rpx 14rpx;border-radius:999rpx;background:#EEF2FF;color:#596CD4;font-size:21rpx}.desc{margin-top:10rpx;color:var(--c-text-2);font-size:24rpx;line-height:1.5;word-break:break-all}.actions{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:22rpx}.actions button{margin:0}.primary,.outline,.minor{min-height:72rpx;padding:0 20rpx;border-radius:var(--r-md);font-size:24rpx;line-height:72rpx}.primary{margin-top:22rpx;border:0;background:var(--grad-violet-pink);color:#fff}.primary::after,.outline::after,.minor::after{border:none}.outline{background:#fff;border:1rpx solid #667EEA;color:#596CD4}.minor{background:#F5F6FA;color:#6E7480}.order-link{margin-top:20rpx;color:#596CD4;font-size:24rpx}.empty{padding:120rpx 20rpx;text-align:center;color:var(--c-text-3);font-size:27rpx}
