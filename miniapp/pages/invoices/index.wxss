.page-container{min-height:100vh;padding:28rpx 24rpx;box-sizing:border-box;background:var(--bg-base)}.hero{padding:30rpx 28rpx;border-radius:var(--r-lg);background:var(--grad-violet-pink);color:#fff}.hero-title,.hero-desc,.title,.desc,.order-link{display:block}.hero-title{font-size:36rpx;font-weight:700}.hero-desc{margin-top:10rpx;font-size:23rpx;line-height:1.6;color:rgba(255,255,255,.84)}.card{margin-top:22rpx;padding:26rpx;border-radius:var(--r-lg);background:#fff;box-shadow:var(--shadow-card)}.row{display:flex;gap:16rpx;align-items:center;justify-content:space-between}.title{flex:1;min-width:0;font-size:30rpx;font-weight:700;color:var(--c-text);word-break:break-all}.status{flex-shrink:0;padding:6rpx 14rpx;border-radius:999rpx;background:#E3F4FC;color:#2FA8DE;font-size:21rpx}.desc{margin-top:10rpx;color:var(--c-text-2);font-size:24rpx;line-height:1.5;word-break:break-all}.actions{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:22rpx}.actions button{margin:0}.primary,.outline,.minor{min-height:72rpx;padding:0 20rpx;border-radius:var(--r-md);font-size:24rpx;line-height:72rpx}.primary{margin-top:22rpx;border:0;background:var(--grad-violet-pink);color:#fff}.primary::after,.outline::after,.minor::after{border:none}.outline{background:#fff;border:1rpx solid #5BC0EB;color:#2FA8DE}.minor{background:#F5F6FA;color:#6E7480}.order-link{margin-top:20rpx;color:#2FA8DE;font-size:24rpx}.empty{padding:120rpx 20rpx;text-align:center;color:var(--c-text-3);font-size:27rpx}

.invoice-files{display:flex;flex-direction:column;gap:10rpx;margin-top:22rpx;padding-top:18rpx;border-top:1rpx solid #EEF0F5}.files-title{color:var(--c-text);font-size:24rpx;font-weight:600}.file-row,.pending-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:16rpx 18rpx;border-radius:14rpx;background:#F7F8FC}.file-row:active{background:#E3F4FC}.file-copy{display:flex;min-width:0;flex:1;flex-direction:column;gap:4rpx}.file-name{overflow:hidden;color:var(--c-text);font-size:24rpx;text-overflow:ellipsis;white-space:nowrap}.file-size{color:var(--c-text-3);font-size:20rpx}.file-open{flex-shrink:0;color:#2FA8DE;font-size:23rpx;font-weight:600}.upload-mask{position:fixed;z-index:1000;top:0;right:0;bottom:0;left:0;display:flex;align-items:flex-end;padding:24rpx;box-sizing:border-box;background:rgba(20,27,45,.52)}.upload-dialog{width:100%;max-height:82vh;padding:30rpx 28rpx calc(26rpx + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:28rpx 28rpx 20rpx 20rpx;background:#fff;box-shadow:0 -12rpx 50rpx rgba(17,25,46,.18)}.dialog-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.dialog-title{color:var(--c-text);font-size:34rpx;font-weight:700}.dialog-tag{padding:6rpx 13rpx;border-radius:999rpx;background:#E3F4FC;color:#2FA8DE;font-size:20rpx}.dialog-desc{display:block;margin-top:12rpx;color:var(--c-text-2);font-size:23rpx;line-height:1.6}.pick-file{margin:24rpx 0 0;border:1rpx dashed #7C8BE2;border-radius:16rpx;background:#F7F8FF;color:#2FA8DE;font-size:26rpx}.pick-file::after,.dialog-actions button::after{border:none}.pending-files{display:flex;max-height:360rpx;flex-direction:column;gap:10rpx;margin-top:18rpx;overflow-y:auto}.pending-row{border:1rpx solid #E8EAF3;background:#fff}.file-remove{flex-shrink:0;padding:8rpx;color:#D95650;font-size:22rpx}.dialog-actions{display:flex;gap:16rpx;margin-top:26rpx}.dialog-actions button{flex:1;margin:0;border-radius:16rpx;font-size:26rpx;font-weight:600}.dialog-cancel{border:1rpx solid #D8DCE7;background:#fff;color:#6A7180}.dialog-submit{border:0;background:var(--grad-violet-pink);color:#fff}.dialog-actions button[disabled],.pick-file[disabled]{opacity:.52}

/* ===== design 1:1 ===== */
.hero { background: linear-gradient(160deg, #BEE3F0, #DDEBD9); }
.card { border-radius: 32rpx; }
.primary, button.primary { border-radius: 999rpx; background: #5BC0EB; }
.outline { border-radius: 999rpx; }
.upload-dialog { border-radius: 32rpx; }
