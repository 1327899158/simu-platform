.page-container { min-height: 100vh; padding: 22rpx 20rpx calc(140rpx + env(safe-area-inset-bottom)); background: #F3F6FB; box-sizing: border-box; }

/* 访客落地页首屏：把“有机会可接”与注册价值放在首屏。 */
.market-hero { position: relative; overflow: hidden; padding: 28rpx 28rpx 26rpx; border-radius: 26rpx; background: linear-gradient(135deg, #101C3F, #274F97 58%, #3672C8); box-shadow: 0 14rpx 30rpx rgba(32, 66, 137, .24); }
.hero-glow { position: absolute; border-radius: 50%; filter: blur(5rpx); opacity: .44; }.glow-one { width: 240rpx; height: 240rpx; top: -125rpx; right: -72rpx; background: #74DAFF; }.glow-two { width: 180rpx; height: 180rpx; bottom: -116rpx; left: 26%; background: #917BFF; }
.hero-top, .hero-title, .hero-copy, .hero-cta, .hero-proof { position: relative; z-index: 1; }.hero-top { display: flex; align-items: center; justify-content: space-between; }.hero-badge { display: flex; align-items: center; gap: 8rpx; color: #D8E9FF; font-size: 21rpx; }.pulse-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #63E5A7; box-shadow: 0 0 0 6rpx rgba(99, 229, 167, .17); }.visitor-chip { padding: 5rpx 12rpx; border: 1rpx solid rgba(255,255,255,.28); border-radius: 99rpx; color: rgba(255,255,255,.86); font-size: 18rpx; }
.hero-title { display: block; margin-top: 26rpx; color: #FFFFFF; font-size: 42rpx; line-height: 1.32; font-weight: 800; letter-spacing: 1rpx; }.hero-title-accent { margin-top: 0; color: #8BE0FF; }.hero-copy { display: block; margin-top: 14rpx; color: rgba(230,242,255,.78); font-size: 22rpx; line-height: 1.55; }
.hero-cta { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; padding: 18rpx 22rpx; border-radius: 14rpx; background: #FFFFFF; color: #2850A0; font-size: 27rpx; font-weight: 800; box-shadow: 0 6rpx 14rpx rgba(5, 25, 72, .18); }.hero-cta:active { opacity: .83; transform: scale(.985); }.cta-arrow { font-size: 34rpx; line-height: 1; }
.hero-proof { display: flex; flex-wrap: wrap; gap: 8rpx 14rpx; margin-top: 20rpx; color: rgba(225,241,255,.8); font-size: 18rpx; }

.market-stats-card { display: flex; align-items: center; margin: 16rpx 8rpx 0; padding: 18rpx 8rpx; border-radius: 18rpx; background: #FFFFFF; box-shadow: var(--shadow-sm); }.market-stat { flex: 1; display: flex; flex-direction: column; align-items: center; min-width: 0; }.market-stat-number { color: #3E61C1; font-size: 31rpx; font-weight: 800; }.market-stat-label { margin-top: 5rpx; color: var(--c-text-3); font-size: 19rpx; white-space: nowrap; }.market-stat-divider { width: 1rpx; height: 48rpx; background: var(--c-divider); }

.unlock-card { display: flex; align-items: center; margin-top: 18rpx; padding: 20rpx; border: 1rpx solid #D5E1FF; border-radius: 18rpx; background: linear-gradient(112deg, #EEF4FF, #FBFCFF); }.unlock-card:active { opacity: .8; }.unlock-icon { display: flex; flex-shrink: 0; width: 62rpx; height: 62rpx; align-items: center; justify-content: center; border-radius: 18rpx; background: #DCE9FF; font-size: 34rpx; }.unlock-content { flex: 1; min-width: 0; margin-left: 14rpx; }.unlock-title, .unlock-copy { display: block; }.unlock-title { color: var(--c-text); font-size: 25rpx; font-weight: 800; }.unlock-copy { margin-top: 5rpx; color: var(--c-text-3); font-size: 19rpx; }.unlock-arrow { color: #5672C9; font-size: 42rpx; line-height: 1; }

.section-heading { display: flex; align-items: flex-end; justify-content: space-between; margin: 28rpx 4rpx 0; }.section-kicker, .section-title { display: block; }.section-kicker { color: #6980C6; font-size: 19rpx; font-weight: 700; letter-spacing: 2rpx; }.section-title { margin-top: 4rpx; color: var(--c-text); font-size: 31rpx; font-weight: 800; }.section-count { margin-bottom: 3rpx; color: var(--c-text-3); font-size: 19rpx; }
.category-row { display: flex; overflow: hidden; gap: 10rpx; margin-top: 16rpx; }.category-chip { flex-shrink: 0; padding: 11rpx 18rpx; border: 1rpx solid #DFE4EE; border-radius: 99rpx; background: #FFFFFF; color: var(--c-text-3); font-size: 21rpx; }.category-chip.active { border-color: #5971CB; background: #5870C8; color: #FFFFFF; font-weight: 700; }

.opportunity-list { margin-top: 16rpx; }.opportunity-card { position: relative; margin-bottom: 14rpx; padding: 22rpx; overflow: hidden; border: 1rpx solid #E2E7F0; border-radius: 20rpx; background: #FFFFFF; box-shadow: 0 3rpx 12rpx rgba(29, 48, 86, .05); }.opportunity-card:active { opacity: .83; transform: scale(.99); }.opportunity-card.featured { border-color: #C9D9FF; box-shadow: 0 6rpx 18rpx rgba(66, 101, 189, .12); }.opportunity-ribbon { position: absolute; top: 0; right: 0; padding: 7rpx 16rpx; border-radius: 0 18rpx 0 14rpx; background: linear-gradient(90deg, #4B77D8, #7368D2); color: #FFFFFF; font-size: 18rpx; font-weight: 700; }
.opportunity-head { display: flex; align-items: center; }.opportunity-type { display: flex; width: 48rpx; height: 48rpx; align-items: center; justify-content: center; border-radius: 14rpx; font-size: 23rpx; font-weight: 800; }.type-heat { background: #FFF0E8; color: #E26B3B; }.type-flow { background: #E9F6FF; color: #2D8DC7; }.type-struct { background: #F0EDFF; color: #7159C1; }.opportunity-head-main { flex: 1; min-width: 0; margin-left: 12rpx; }.opportunity-category, .opportunity-time { display: block; }.opportunity-category { color: var(--c-text-2); font-size: 21rpx; font-weight: 700; }.opportunity-time { margin-top: 3rpx; color: var(--c-text-4); font-size: 18rpx; }.opportunity-status { flex-shrink: 0; padding: 5rpx 11rpx; border-radius: 99rpx; background: #E3F4FC; color: #5670C7; font-size: 18rpx; font-weight: 700; }
.opportunity-title { display: block; margin-top: 18rpx; color: var(--c-text); font-size: 29rpx; line-height: 1.35; font-weight: 800; }.opportunity-desc { display: -webkit-box; margin-top: 8rpx; overflow: hidden; color: var(--c-text-2); font-size: 21rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.opportunity-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 14rpx; }.opportunity-tags text { padding: 4rpx 11rpx; border-radius: 8rpx; background: #F4F6FA; color: #697487; font-size: 18rpx; }
.opportunity-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 17rpx; padding-top: 15rpx; border-top: 1rpx solid var(--c-divider); }.foot-label, .budget-lock { display: block; }.foot-label { color: var(--c-text-4); font-size: 18rpx; }.budget-lock { margin-top: 4rpx; color: #425FB7; font-size: 22rpx; font-weight: 800; }.quote-lock { display: flex; align-items: center; gap: 7rpx; color: #4867C1; font-size: 21rpx; font-weight: 700; }

.how-card { margin-top: 24rpx; padding: 26rpx 22rpx; border-radius: 22rpx; background: linear-gradient(145deg, #202F61, #3B5EAE); color: #FFFFFF; }.how-title { display: block; font-size: 28rpx; font-weight: 800; text-align: center; }.how-steps { display: flex; align-items: center; justify-content: center; margin-top: 22rpx; }.how-steps view { display: flex; flex-direction: column; align-items: center; color: rgba(255,255,255,.84); font-size: 19rpx; white-space: nowrap; }.how-step-num { display: flex; width: 38rpx; height: 38rpx; margin-bottom: 7rpx; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.18); color: #FFFFFF; font-size: 22rpx; font-weight: 800; }.how-line { width: 45rpx; height: 1rpx; margin: -24rpx 5rpx 0; background: rgba(255,255,255,.36); }.how-button { margin-top: 25rpx; padding: 17rpx 0; border-radius: 13rpx; background: #FFFFFF; color: #3454A7; font-size: 25rpx; font-weight: 800; text-align: center; }.how-button:active { opacity: .84; }

.guest-tabbar { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; display: flex; height: calc(112rpx + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); background: rgba(255,255,255,.98); border-top: 1rpx solid var(--c-border); box-shadow: 0 -4rpx 16rpx rgba(26,26,46,.06); box-sizing: border-box; }.guest-tab { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5rpx; color: var(--c-text-3); font-size: 20rpx; }.guest-tab.active { color: var(--neon-violet); font-weight: 700; }.tab-icon { font-size: 34rpx; line-height: 1; }

/* ===== design 1:1 ===== */
.req-card, .card { border-radius: 32rpx; }
