.page-container { min-height: 100vh; padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); background: var(--bg-base); box-sizing: border-box; }
.page-header { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 32rpx 22rpx; background: #FFFFFF; }
.page-title { display: block; color: var(--c-text); font-size: 34rpx; font-weight: 800; line-height: 1.35; }
.page-subtitle { display: block; margin-top: 4rpx; color: var(--c-text-3); font-size: 23rpx; }
.visitor-badge { padding: 8rpx 16rpx; border: 1rpx solid #C7D8F5; border-radius: 99rpx; background: #EEF5FF; color: #2C6EA3; font-size: 21rpx; }
.visitor-tip { display: flex; align-items: center; margin: 16rpx 20rpx 0; padding: 16rpx 18rpx; border: 1rpx solid #D9E7FB; border-radius: 14rpx; background: #F5F9FF; }
.visitor-tip-icon { margin-right: 10rpx; font-size: 24rpx; }
.visitor-tip-text { color: #45627F; font-size: 23rpx; }
.stats-card { display: flex; align-items: center; justify-content: space-around; margin: 16rpx 20rpx 0; padding: 22rpx 12rpx; border-radius: 20rpx; background: var(--grad-violet-pink); box-shadow: 0 8rpx 22rpx rgba(102, 126, 234, 0.26); }
.stat-item { flex: 1; display: flex; align-items: center; justify-content: center; gap: 14rpx; }
.stat-number { color: #FFFFFF; font-size: 50rpx; font-weight: 800; }
.stat-label { display: block; color: #FFFFFF; font-size: 25rpx; font-weight: 600; }
.stat-desc { display: block; margin-top: 2rpx; color: rgba(255,255,255,.75); font-size: 19rpx; }
.stat-divider { width: 1rpx; height: 52rpx; background: rgba(255,255,255,.3); }
.highlight .stat-number { color: #FFE272; }
.filter-card { margin: 16rpx 20rpx 0; padding: 20rpx; border-radius: 20rpx; background: #FFFFFF; box-shadow: var(--shadow-sm); }
.section-header { display: flex; align-items: center; justify-content: space-between; }
.section-title { color: var(--c-text); font-size: 26rpx; font-weight: 700; }
.section-hint { color: var(--c-text-3); font-size: 22rpx; }
.filter-bar, .sort-bar { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.filter-item, .sort-item { min-height: 64rpx; padding: 0 20rpx; display: flex; align-items: center; gap: 6rpx; border: 1rpx solid #E4E7EE; border-radius: 36rpx; background: #F7F8FA; color: var(--c-text-2); font-size: 23rpx; box-sizing: border-box; }
.filter-item.active { border-color: #667EEA; background: #667EEA; color: #FFFFFF; }
.sort-header { margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid var(--c-divider); }
.sort-item.active { border-color: #C9D3FB; background: #EEF2FF; color: #596CD4; }
.requirement-list { padding: 16rpx 20rpx 0; }
.requirement-card { margin-bottom: 14rpx; padding: 22rpx; border: 1rpx solid var(--c-border); border-radius: 18rpx; background: #FFFFFF; box-shadow: var(--shadow-sm); }
.req-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.req-title { flex: 1; min-width: 0; color: var(--c-text); font-size: 28rpx; font-weight: 700; line-height: 1.4; }
.req-status { flex-shrink: 0; padding: 6rpx 13rpx; border-radius: 99rpx; background: #EEF2FF; color: #596CD4; font-size: 20rpx; }
.req-description { display: -webkit-box; margin-top: 10rpx; overflow: hidden; color: var(--c-text-2); font-size: 23rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.req-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 14rpx; }
.tag { padding: 4rpx 12rpx; border-radius: 10rpx; background: #EEF2FF; color: #596CD4; font-size: 19rpx; }
.req-data { display: flex; margin-top: 16rpx; padding: 14rpx 0; border-top: 1rpx solid var(--c-divider); border-bottom: 1rpx solid var(--c-divider); }
.req-data view { flex: 1; display: flex; flex-direction: column; align-items: center; }
.data-label { color: var(--c-text-3); font-size: 19rpx; }
.data-value { margin-top: 4rpx; color: var(--c-text); font-size: 23rpx; font-weight: 700; }
.price { color: var(--c-money); }
.req-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 14rpx; }
.req-meta { color: var(--c-text-3); font-size: 19rpx; }
.login-to-quote { color: #2C6EA3; font-size: 22rpx; font-weight: 600; }
.guest-tabbar { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; display: flex; height: calc(112rpx + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); background: rgba(255,255,255,.98); border-top: 1rpx solid var(--c-border); box-shadow: 0 -4rpx 16rpx rgba(26,26,46,.06); box-sizing: border-box; }
.guest-tab { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5rpx; color: var(--c-text-3); font-size: 20rpx; }
.guest-tab.active { color: var(--neon-violet); font-weight: 700; }
.tab-icon { font-size: 34rpx; line-height: 1; }
