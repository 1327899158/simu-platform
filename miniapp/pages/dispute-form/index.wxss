.page-container {
  min-height: 100vh;
  background-color: var(--bg-base);
  padding: 20rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.hero {
  background: linear-gradient(135deg, #F97316 0%, #E85A4F 100%);
  border-radius: var(--r-lg);
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(231, 76, 60, 0.25);
}
.hero-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}
.hero-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  line-height: 1.6;
}

.card {
  background: #FFFFFF;
  border-radius: var(--r-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 20rpx;
}
.card-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 16rpx;
}
.card-subtitle {
  display: block;
  font-size: 22rpx;
  color: var(--c-text-3);
  margin-bottom: 16rpx;
  line-height: 1.6;
}

/* 纠纷类型网格 */
.reason-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.reason-item {
  flex: 1 0 28%;
  min-height: 96rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border: 2rpx solid var(--c-border);
  border-radius: var(--r-md);
  background: #FAFAFA;
  transition: all 0.2s ease;
}
.reason-item:active { transform: scale(0.95); }
.reason-item.active {
  border-color: #E85A4F;
  background: #FDECEA;
}
.reason-icon { font-size: 40rpx; }
.reason-label { font-size: 24rpx; color: var(--c-text-2); }
.reason-item.active .reason-label { color: #C0392B; font-weight: 600; }

/* 描述 */
.desc-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 200rpx;
  padding: 20rpx;
  border: 1rpx solid var(--c-border);
  border-radius: var(--r-md);
  background: #FAFBFC;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--c-text);
}
.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--c-text-4);
  margin-top: 8rpx;
}

/* 证据 */
.evid-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.evid-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #F8F9FA;
  border-radius: var(--r-sm);
  gap: 12rpx;
}
.evid-name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--c-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.evid-size { font-size: 22rpx; color: var(--c-text-4); flex-shrink: 0; }
.evid-remove { font-size: 28rpx; color: var(--neon-red); padding: 4rpx 8rpx; flex-shrink: 0; }
.btn-upload {
  width: 100%;
  padding: 18rpx 0;
  border: 1rpx dashed #C7D2FE;
  border-radius: var(--r-md);
  background: #E3F4FC;
  color: #2FA8DE;
  font-size: 26rpx;
  line-height: 1.5;
}
.btn-upload::after { border: none; }
.btn-upload.disabled { opacity: 0.5; }

.btn-submit {
  width: 100%;
  padding: 24rpx 0;
  border: none;
  border-radius: var(--r-md);
  background: linear-gradient(135deg, #E85A4F, #C0392B);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(231, 76, 60, 0.3);
  line-height: 1.5;
  margin-top: 8rpx;
}
.btn-submit::after { border: none; }
.btn-submit:active { transform: scale(0.98); opacity: 0.9; }
.btn-submit.disabled { opacity: 0.5; }

/* ===== design 1:1 ===== */
.card { border-radius: 32rpx; }
.upload-button, .submit, button.primary { border-radius: 999rpx; }
