/* ================================================================
   仿真服务平台 · 浅色商务风 Design Token 体系
   （L1 换肤：变量名与深色版保持一致，仅替换值——页面级 WXSS 无需大改）
   浅灰底 + 白卡片 + 深蓝灰主色 + 浅阴影
   ================================================================ */

/* ---------- Design Tokens ---------- */
page {
  /* ===== 底色 · 浅灰空间 ===== */
  --bg-deep: #EFEFEF;
  --bg-base: #F5F5F5;
  --bg-elev: #FFFFFF;
  --bg-card: #FFFFFF;

  /* ===== 主色与语义色（沿用 neon-* 变量名，值换商务色） ===== */
  --neon-violet: #2C3E50;
  --neon-violet-2: #34495E;
  --neon-pink: #E74C3C;
  --neon-pink-2: #EC7063;
  --neon-cyan: #3498DB;
  --neon-cyan-2: #5DADE2;
  --neon-blue: #3498DB;
  --neon-green: #27AE60;
  --neon-amber: #F39C12;
  --neon-red: #E74C3C;

  /* ===== 渐变（商务化：低饱和同色系） ===== */
  --grad-neon: linear-gradient(135deg, #2C3E50 0%, #3498DB 100%);
  --grad-violet-pink: linear-gradient(135deg, #34495E, #2C3E50);
  --grad-cyan-blue: linear-gradient(135deg, #5DADE2, #3498DB);
  --grad-pink-cyan: linear-gradient(90deg, #EC7063, #5DADE2);
  --grad-gold: linear-gradient(135deg, #F39C12, #E67E22);

  /* ===== 文字 ===== */
  --c-text: #333333;
  --c-text-2: #666666;
  --c-text-3: #999999;
  --c-text-4: #BBBBBB;
  --c-money: #E74C3C;

  /* ===== 线条 ===== */
  --c-border: #E8E8E8;
  --c-border-strong: #2C3E50;
  --c-divider: #F0F0F0;

  /* ===== 间距 — 8px 基准 → rpx (×2) ===== */
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;
  --sp-4: 32rpx;
  --sp-5: 40rpx;
  --sp-6: 48rpx;
  --sp-7: 64rpx;

  /* ===== 圆角 ===== */
  --r-sm: 8rpx;
  --r-md: 16rpx;
  --r-lg: 24rpx;
  --r-xl: 32rpx;
  --r-pill: 999rpx;

  /* ===== 阴影 · 浅灰（沿用 glow-* 变量名，值换浅阴影） ===== */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8rpx 24rpx rgba(0, 0, 0, 0.10);
  --shadow-card: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  --glow-cyan: 0 4rpx 12rpx rgba(52, 152, 219, 0.18);
  --glow-violet: 0 4rpx 12rpx rgba(44, 62, 80, 0.15);
  --glow-pink: 0 4rpx 12rpx rgba(231, 76, 60, 0.18);
  --glow-primary: 0 4rpx 14rpx rgba(44, 62, 80, 0.22);

  /* ===== 字体 ===== */
  --font-family: -apple-system, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;

  background-color: var(--bg-base);
  font-size: 28rpx;
  color: var(--c-text);
  font-family: var(--font-family);
  -webkit-font-smoothing: antialiased;
}

/* ---------- 布局 ---------- */
.container {
  padding: var(--sp-3);
  padding-bottom: calc(var(--sp-5) + env(safe-area-inset-bottom));
}

/* ---------- 卡片 ---------- */
.card {
  position: relative;
  background: var(--bg-card);
  border: 1rpx solid var(--c-border);
  border-radius: var(--r-lg);
  padding: var(--sp-3);
  margin-bottom: var(--sp-3);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  transition: transform 0.18s ease, border-color 0.2s ease;
}
.card:active {
  transform: scale(0.985);
  border-color: #D0D0D0;
}
/* 整框可点反馈（hover-class 用） */
.card-press {
  opacity: 0.85;
}

/* ---------- 按钮 · 商务 ---------- */
.btn-primary {
  background: var(--grad-violet-pink);
  color: #fff;
  border-radius: var(--r-md);
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 0;
  text-align: center;
  box-shadow: var(--glow-primary);
  position: relative;
  overflow: hidden;
  transition: transform 0.15s ease, box-shadow 0.2s ease;
}
.btn-primary:active {
  transform: scale(0.97);
  background: #1A252F;
}
.btn-primary.disabled {
  background: #B0B7BD;
  box-shadow: none;
  opacity: 0.7;
}

.btn-outline {
  border: 1rpx solid var(--neon-cyan);
  color: var(--neon-cyan);
  background: rgba(52, 152, 219, 0.06);
  border-radius: var(--r-md);
  font-size: 30rpx;
  font-weight: 500;
  padding: 20rpx 0;
  text-align: center;
  transition: transform 0.15s ease, background 0.15s ease;
}
.btn-outline:active {
  transform: scale(0.98);
  background: rgba(52, 152, 219, 0.12);
}

.btn-danger-outline {
  border: 1rpx solid var(--neon-red);
  color: var(--neon-red);
  background: rgba(231, 76, 60, 0.05);
  border-radius: var(--r-md);
  font-size: 30rpx;
  font-weight: 500;
  padding: 20rpx 0;
  text-align: center;
  transition: transform 0.15s ease, background 0.15s ease;
}
.btn-danger-outline:active {
  transform: scale(0.98);
  background: rgba(231, 76, 60, 0.12);
}

/* ---------- 通用工具类 ---------- */
.row { display: flex; align-items: center; }
.spread { display: flex; align-items: center; justify-content: space-between; }
.title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--c-text);
}
.muted {
  color: var(--c-text-3);
  font-size: 24rpx;
}
.money {
  color: var(--c-money);
  font-weight: 700;
}

/* 强调文字工具类（原渐变文字，浅色底改纯色） */
.grad-text {
  color: var(--neon-violet);
  font-weight: 600;
}
.grad-text-cyan {
  color: var(--neon-cyan);
  font-weight: 600;
}

/* ---------- 标签 Tag ---------- */
.tag {
  display: inline-block;
  background: #EBF5FB;
  border: 1rpx solid #D6EAF8;
  color: #2874A6;
  border-radius: var(--r-sm);
  padding: 6rpx 16rpx;
  margin: 0 var(--sp-2) var(--sp-2) 0;
  font-size: 22rpx;
  font-weight: 500;
}

/* ---------- Chip 选择标签 ---------- */
.chip {
  display: inline-block;
  border: 1rpx solid #D5D8DC;
  color: var(--c-text-2);
  border-radius: var(--r-pill);
  padding: 12rpx 30rpx;
  margin: 0 var(--sp-2) var(--sp-2) 0;
  font-size: 26rpx;
  background: #FAFAFA;
  transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease;
}
.chip:active { transform: scale(0.95); }
.chip.on {
  border-color: transparent;
  color: #fff;
  background: var(--neon-violet);
  font-weight: 600;
}

/* ---------- 状态徽章 · 浅底深字 ---------- */
.status {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: var(--r-pill);
  white-space: nowrap;
  border: 1rpx solid transparent;
}
.st-blue { background: #E3F2FD; color: #1976D2; border-color: #BBDEFB; }
.st-orange { background: #FFF3E0; color: #F57C00; border-color: #FFE0B2; }
.st-cyan { background: #E0F7FA; color: #0097A7; border-color: #B2EBF2; }
.st-purple { background: #F3E5F5; color: #7B1FA2; border-color: #E1BEE7; }
.st-green { background: #E8F5E9; color: #388E3C; border-color: #C8E6C9; }
.st-gray { background: #F5F5F5; color: #999999; border-color: #E0E0E0; }

/* ---------- 空状态 ---------- */
.empty {
  text-align: center;
  color: var(--c-text-4);
  padding: 110rpx 0;
  font-size: 26rpx;
  line-height: 1.7;
}

/* ---------- 表单 ---------- */
.input {
  background: #FFFFFF;
  border-radius: var(--r-md);
  padding: 20rpx 24rpx;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--c-text);
  border: 1rpx solid #DDDDDD;
  transition: border-color 0.2s ease, background 0.2s ease;
  box-sizing: border-box;
}
.input:focus {
  border-color: var(--neon-violet);
}
.input::placeholder {
  color: var(--c-text-4);
}
.label {
  font-size: 26rpx;
  color: var(--c-text-2);
  margin-top: var(--sp-3);
  font-weight: 500;
  letter-spacing: 1rpx;
}
.step-title {
  font-size: 30rpx;
  font-weight: 700;
  margin: 0 0 var(--sp-2);
  display: flex;
  align-items: center;
  color: var(--neon-violet);
}
.step-title::before {
  content: "";
  display: inline-block;
  width: 6rpx;
  height: 32rpx;
  background: var(--neon-violet);
  border-radius: var(--r-pill);
  margin-right: var(--sp-2);
}

/* ---------- 入场动画（保留，无视觉侵入） ---------- */
@keyframes neon-rise {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.rise {
  animation: neon-rise 0.4s ease-out both;
}
