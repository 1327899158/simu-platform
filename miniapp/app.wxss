/* ================================================================
   仿真服务平台 · 年轻轻量化马卡龙 Design Token
   主色天蓝 #5BC0EB，薄荷绿底 #DDEBD9 + 白卡片 + 荧光黄 #F5D33F 强调。
   neon-* 名称作为旧页面兼容别名保留，业务页面无需改动逻辑。
   ================================================================ */

/* ---------- Design Tokens ---------- */
page {
  /* ===== 底色 · 薄荷绿空间 ===== */
  --bg-deep: #CFE3C8;
  --bg-base: #DDEBD9;
  --bg-elev: #FFFFFF;
  --bg-card: #FFFFFF;

  /* ===== 品牌色与语义色 ===== */
  --color-primary: #5BC0EB;
  --color-primary-dark: #2FA8DE;
  --color-primary-light: #E3F4FC;
  --color-success: #52B788;
  --color-warning: #F5B31A;
  --color-error: #E85A4F;
  --color-info: #5BC0EB;

  /* 旧变量兼容映射 */
  --neon-violet: #5BC0EB;
  --neon-violet-2: #2FA8DE;
  --neon-pink: #7ED3F2;
  --neon-pink-2: #A5E1F7;
  --neon-cyan: #5BC0EB;
  --neon-cyan-2: #7ED3F2;
  --neon-blue: #5BC0EB;
  --neon-green: #52B788;
  --neon-amber: #F5B31A;
  --neon-red: #E85A4F;

  /* ===== 渐变（马卡龙浅色系） ===== */
  --grad-neon: linear-gradient(135deg, #7ED3F2 0%, #5BC0EB 100%);
  --grad-violet-pink: linear-gradient(135deg, #7ED3F2 0%, #5BC0EB 100%);
  --grad-cyan-blue: linear-gradient(135deg, #A5E1F7, #5BC0EB);
  --grad-pink-cyan: linear-gradient(90deg, #F7F3C9, #BEE3F0);
  --grad-gold: linear-gradient(135deg, #F5D33F, #F5B31A);
  --grad-hero-sunny: linear-gradient(160deg, #F7F3C9 0%, #DDEBD9 100%);
  --grad-hero-sky: linear-gradient(160deg, #BEE3F0 0%, #DDEBD9 100%);

  /* ===== 文字 ===== */
  --c-text: #1F2B22;
  --c-text-2: #5A665C;
  --c-text-3: #7C877B;
  --c-text-4: #9AA59A;
  --c-money: #E85A4F;

  /* ===== 线条 ===== */
  --c-border: #E1EBDD;
  --c-border-strong: #5BC0EB;
  --c-divider: #EDF3EA;

  /* ===== 间距 — 8px 基准 → rpx (×2) ===== */
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;
  --sp-4: 32rpx;
  --sp-5: 40rpx;
  --sp-6: 48rpx;
  --sp-7: 64rpx;

  /* ===== 圆角 ===== */
  --r-sm: 8rpx;
  --r-md: 16rpx;
  --r-lg: 24rpx;
  --r-xl: 32rpx;
  --r-pill: 999rpx;

  /* ===== 阴影 · 浅绿灰（沿用 glow-* 变量名） ===== */
  --shadow-sm: 0 2rpx 8rpx rgba(70, 110, 60, 0.06);
  --shadow-md: 0 4rpx 16rpx rgba(70, 110, 60, 0.08);
  --shadow-lg: 0 8rpx 24rpx rgba(70, 110, 60, 0.10);
  --shadow-card: 0 2rpx 12rpx rgba(70, 110, 60, 0.06);
  --glow-cyan: 0 4rpx 12rpx rgba(91, 192, 235, 0.20);
  --glow-violet: 0 4rpx 12rpx rgba(91, 192, 235, 0.22);
  --glow-pink: 0 4rpx 12rpx rgba(232, 90, 79, 0.16);
  --glow-primary: 0 8rpx 24rpx rgba(91, 192, 235, 0.30);

  /* ===== 字体 ===== */
  --font-family: -apple-system, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;

  background-color: var(--bg-base);
  font-size: 28rpx;
  color: var(--c-text);
  font-family: var(--font-family);
  -webkit-font-smoothing: antialiased;
}

/* ---------- 布局 ---------- */
.container {
  padding: var(--sp-3);
  padding-bottom: calc(var(--sp-5) + env(safe-area-inset-bottom));
}

/* ---------- 卡片 ---------- */
.card {
  position: relative;
  background: var(--bg-card);
  border: 1rpx solid var(--c-border);
  border-radius: var(--r-lg);
  padding: var(--sp-3);
  margin-bottom: var(--sp-3);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  transition: transform 0.18s ease, border-color 0.2s ease;
}
.card:active {
  transform: scale(0.985);
  border-color: #CFE0CA;
}
/* 整框可点反馈（hover-class 用） */
.card-press {
  opacity: 0.85;
}

/* ---------- 按钮 · 天蓝胶囊 ---------- */
.btn-primary {
  background: var(--grad-violet-pink);
  color: #fff;
  border-radius: var(--r-pill);
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 0;
  text-align: center;
  box-shadow: var(--glow-primary);
  position: relative;
  overflow: hidden;
  transition: transform 0.15s ease, box-shadow 0.2s ease;
}
.btn-primary:active {
  transform: scale(0.97);
  background: #2FA8DE;
}
.btn-primary.disabled {
  background: #B9C4BC;
  box-shadow: none;
  opacity: 0.7;
}

.btn-outline {
  border: 1rpx solid var(--neon-cyan);
  color: var(--neon-cyan);
  background: rgba(91, 192, 235, 0.08);
  border-radius: var(--r-pill);
  font-size: 30rpx;
  font-weight: 500;
  padding: 20rpx 0;
  text-align: center;
  transition: transform 0.15s ease, background 0.15s ease;
}
.btn-outline:active {
  transform: scale(0.98);
  background: rgba(91, 192, 235, 0.16);
}

.btn-danger-outline {
  border: 1rpx solid var(--neon-red);
  color: var(--neon-red);
  background: rgba(232, 90, 79, 0.05);
  border-radius: var(--r-pill);
  font-size: 30rpx;
  font-weight: 500;
  padding: 20rpx 0;
  text-align: center;
  transition: transform 0.15s ease, background 0.15s ease;
}
.btn-danger-outline:active {
  transform: scale(0.98);
  background: rgba(232, 90, 79, 0.12);
}

/* ---------- 通用工具类 ---------- */
.row { display: flex; align-items: center; }
.spread { display: flex; align-items: center; justify-content: space-between; }
.title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--c-text);
}
.muted {
  color: var(--c-text-3);
  font-size: 24rpx;
}
.money {
  color: var(--c-money);
  font-weight: 700;
}

/* 强调文字工具类（天蓝纯色） */
.grad-text {
  color: var(--neon-violet-2);
  font-weight: 600;
}
.grad-text-cyan {
  color: var(--neon-cyan);
  font-weight: 600;
}

/* ---------- 标签 Tag ---------- */
.tag {
  display: inline-block;
  background: #E3F4FC;
  border: 1rpx solid #BEE3F0;
  color: #175D7A;
  border-radius: var(--r-pill);
  padding: 6rpx 16rpx;
  margin: 0 var(--sp-2) var(--sp-2) 0;
  font-size: 22rpx;
  font-weight: 500;
}

/* 荧光黄强调（设计稿 marker 高亮） */
.highlight {
  background: linear-gradient(transparent 62%, #F5D33F 62%);
  padding: 0 6rpx;
  font-weight: 700;
}

/* ---------- Chip 选择标签 ---------- */
.chip {
  display: inline-block;
  border: 1rpx solid #D8E2D4;
  color: var(--c-text-2);
  border-radius: var(--r-pill);
  padding: 12rpx 30rpx;
  margin: 0 var(--sp-2) var(--sp-2) 0;
  font-size: 26rpx;
  background: #FFFFFF;
  transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease;
}
.chip:active { transform: scale(0.95); }
.chip.on {
  border-color: transparent;
  color: #fff;
  background: var(--neon-violet);
  font-weight: 600;
}

/* ---------- 状态徽章 · 浅底深字 ---------- */
.status {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: var(--r-pill);
  white-space: nowrap;
  border: 1rpx solid transparent;
}
.st-blue { background: #E3F4FC; color: #175D7A; border-color: #BEE3F0; }
.st-orange { background: #FBF3CD; color: #8A6D00; border-color: #F1E3A6; }
.st-cyan { background: #E3F4FC; color: #175D7A; border-color: #BEE3F0; }
.st-purple { background: #EFE7FB; color: #6B4FA0; border-color: #E1D4F4; }
.st-green { background: #E6F4E9; color: #2F855A; border-color: #CBE8D4; }
.st-gray { background: #F2F4F1; color: #8A948A; border-color: #E1E6E0; }

/* ---------- 空状态 ---------- */
.empty {
  text-align: center;
  color: var(--c-text-4);
  padding: 110rpx 0;
  font-size: 26rpx;
  line-height: 1.7;
}

/* ---------- 表单 ---------- */
.input {
  background: #FFFFFF;
  border-radius: var(--r-md);
  padding: 20rpx 24rpx;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--c-text);
  border: 1rpx solid #DDE6D9;
  transition: border-color 0.2s ease, background 0.2s ease;
  box-sizing: border-box;
}
.input:focus {
  border-color: var(--neon-violet);
}
.input::placeholder {
  color: var(--c-text-4);
}
.label {
  font-size: 26rpx;
  color: var(--c-text-2);
  margin-top: var(--sp-3);
  font-weight: 500;
  letter-spacing: 1rpx;
}
.step-title {
  font-size: 30rpx;
  font-weight: 700;
  margin: 0 0 var(--sp-2);
  display: flex;
  align-items: center;
  color: var(--neon-violet-2);
}
.step-title::before {
  content: "";
  display: inline-block;
  width: 6rpx;
  height: 32rpx;
  background: var(--neon-violet);
  border-radius: var(--r-pill);
  margin-right: var(--sp-2);
}

/* ---------- 入场动画（保留，无视觉侵入） ---------- */
@keyframes neon-rise {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.rise {
  animation: neon-rise 0.4s ease-out both;
}
