/* ================================================================
   仿真服务平台 · 年轻轻量化马卡龙 Design Token
   主色天蓝 #5BC0EB，薄荷绿底 #DDEBD9 + 白卡片 + 荧光黄 #F5D33F 强调。
   neon-* 名称作为旧页面兼容别名保留，业务页面无需改动逻辑。
   ================================================================ */

/* ---------- Design Tokens ---------- */
page {
  /* ===== 底色 · 薄荷绿空间 ===== */
  --bg-deep: #CFE3C8;
  --bg-base: #DDEBD9;
  --bg-elev: #FFFFFF;
  --bg-card: #FFFFFF;

  /* ===== 品牌色与语义色 ===== */
  --color-primary: #5BC0EB;
  --color-primary-dark: #2FA8DE;
  --color-primary-light: #E3F4FC;
  --color-success: #52B788;
  --color-warning: #F5B31A;
  --color-error: #E85A4F;
  --color-info: #5BC0EB;

  /* 旧变量兼容映射 */
  --neon-violet: #5BC0EB;
  --neon-violet-2: #2FA8DE;
  --neon-pink: #7ED3F2;
  --neon-pink-2: #A5E1F7;
  --neon-cyan: #5BC0EB;
  --neon-cyan-2: #7ED3F2;
  --neon-blue: #5BC0EB;
  --neon-green: #52B788;
  --neon-amber: #F5B31A;
  --neon-red: #E85A4F;

  /* ===== 渐变（马卡龙浅色系） ===== */
  --grad-neon: linear-gradient(135deg, #7ED3F2 0%, #5BC0EB 100%);
  --grad-violet-pink: linear-gradient(135deg, #7ED3F2 0%, #5BC0EB 100%);
  --grad-cyan-blue: linear-gradient(135deg, #A5E1F7, #5BC0EB);
  --grad-pink-cyan: linear-gradient(90deg, #F7F3C9, #BEE3F0);
  --grad-gold: linear-gradient(135deg, #F5D33F, #F5B31A);
  --grad-hero-sunny: linear-gradient(160deg, #F7F3C9 0%, #DDEBD9 100%);
  --grad-hero-sky: linear-gradient(160deg, #BEE3F0 0%, #DDEBD9 100%);

  /* ===== 文字 ===== */
  --c-text: #1F2B22;
  --c-text-2: #5A665C;
  --c-text-3: #7C877B;
  --c-text-4: #9AA59A;
  --c-money: #E85A4F;

  /* ===== 线条 ===== */
  --c-border: #E1EBDD;
  --c-border-strong: #5BC0EB;
  --c-divider: #EDF3EA;

  /* ===== 间距 — 8px 基准 → rpx (×2) ===== */
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;
  --sp-4: 32rpx;
  --sp-5: 40rpx;
  --sp-6: 48rpx;
  --sp-7: 64rpx;

  /* ===== 圆角 ===== */
  --r-sm: 8rpx;
  --r-md: 20rpx;
  --r-lg: 32rpx;
  --r-xl: 32rpx;
  --r-pill: 999rpx;

  /* ===== 阴影 · 浅绿灰（沿用 glow-* 变量名） ===== */
  --shadow-sm: 0 2rpx 8rpx rgba(70, 110, 60, 0.06);
  --shadow-md: 0 4rpx 16rpx rgba(70, 110, 60, 0.08);
  --shadow-lg: 0 8rpx 24rpx rgba(70, 110, 60, 0.10);
  --shadow-card: 0 2rpx 12rpx rgba(70, 110, 60, 0.06);
  --glow-cyan: 0 4rpx 12rpx rgba(91, 192, 235, 0.20);
  --glow-violet: 0 4rpx 12rpx rgba(91, 192, 235, 0.22);
  --glow-pink: 0 4rpx 12rpx rgba(232, 90, 79, 0.16);
  --glow-primary: 0 8rpx 24rpx rgba(91, 192, 235, 0.30);

  /* ===== 字体 ===== */
  --font-family: -apple-system, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;

  background-color: var(--bg-base);
  font-size: 28rpx;
  color: var(--c-text);
  font-family: var(--font-family);
  -webkit-font-smoothing: antialiased;
}

/* ---------- 布局 ---------- */
.container {
  padding: var(--sp-3);
  padding-bottom: calc(var(--sp-5) + env(safe-area-inset-bottom));
}

/* ---------- 卡片 ---------- */
.card {
  position: relative;
  background: var(--bg-card);
  border: 1rpx solid var(--c-border);
  border-radius: var(--r-lg);
  padding: var(--sp-3);
  margin-bottom: var(--sp-3);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  transition: transform 0.18s ease, border-color 0.2s ease;
}
.card:active {
  transform: scale(0.985);
  border-color: #CFE0CA;
}
/* 整框可点反馈（hover-class 用） */
.card-press {
  opacity: 0.85;
}

/* ---------- 按钮 · 天蓝胶囊 ---------- */
.btn-primary {
  background: var(--grad-violet-pink);
  color: #fff;
  border-radius: var(--r-pill);
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 0;
  text-align: center;
  box-shadow: var(--glow-primary);
  position: relative;
  overflow: hidden;
  transition: transform 0.15s ease, box-shadow 0.2s ease;
}
.btn-primary:active {
  transform: scale(0.97);
  background: #2FA8DE;
}
.btn-primary.disabled {
  background: #B9C4BC;
  box-shadow: none;
  opacity: 0.7;
}

.btn-outline {
  border: 1rpx solid var(--neon-cyan);
  color: var(--neon-cyan);
  background: rgba(91, 192, 235, 0.08);
  border-radius: var(--r-pill);
  font-size: 30rpx;
  font-weight: 500;
  padding: 20rpx 0;
  text-align: center;
  transition: transform 0.15s ease, background 0.15s ease;
}
.btn-outline:active {
  transform: scale(0.98);
  background: rgba(91, 192, 235, 0.16);
}

.btn-danger-outline {
  border: 1rpx solid var(--neon-red);
  color: var(--neon-red);
  background: rgba(232, 90, 79, 0.05);
  border-radius: var(--r-pill);
  font-size: 30rpx;
  font-weight: 500;
  padding: 20rpx 0;
  text-align: center;
  transition: transform 0.15s ease, background 0.15s ease;
}
.btn-danger-outline:active {
  transform: scale(0.98);
  background: rgba(232, 90, 79, 0.12);
}

/* ---------- 通用工具类 ---------- */
.row { display: flex; align-items: center; }
.spread { display: flex; align-items: center; justify-content: space-between; }
.title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--c-text);
}
.muted {
  color: var(--c-text-3);
  font-size: 24rpx;
}
.money {
  color: var(--c-money);
  font-weight: 700;
}

/* 强调文字工具类（天蓝纯色） */
.grad-text {
  color: var(--neon-violet-2);
  font-weight: 600;
}
.grad-text-cyan {
  color: var(--neon-cyan);
  font-weight: 600;
}

/* ---------- 标签 Tag ---------- */
.tag {
  display: inline-block;
  background: #E3F4FC;
  border: 1rpx solid #BEE3F0;
  color: #175D7A;
  border-radius: var(--r-pill);
  padding: 6rpx 16rpx;
  margin: 0 var(--sp-2) var(--sp-2) 0;
  font-size: 22rpx;
  font-weight: 500;
}

/* 荧光黄强调（设计稿 marker 高亮） */
.highlight {
  background: linear-gradient(transparent 62%, #F5D33F 62%);
  padding: 0 6rpx;
  font-weight: 700;
}

/* ---------- Chip 选择标签 ---------- */
.chip {
  display: inline-block;
  border: 1rpx solid #D8E2D4;
  color: var(--c-text-2);
  border-radius: var(--r-pill);
  padding: 12rpx 30rpx;
  margin: 0 var(--sp-2) var(--sp-2) 0;
  font-size: 26rpx;
  background: #FFFFFF;
  transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease;
}
.chip:active { transform: scale(0.95); }
.chip.on {
  border-color: transparent;
  color: #fff;
  background: var(--neon-violet);
  font-weight: 600;
}

/* ---------- 状态徽章 · 浅底深字 ---------- */
.status {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: var(--r-pill);
  white-space: nowrap;
  border: 1rpx solid transparent;
}
.st-blue { background: #E3F4FC; color: #175D7A; border-color: #BEE3F0; }
.st-orange { background: #FBF3CD; color: #8A6D00; border-color: #F1E3A6; }
.st-cyan { background: #E3F4FC; color: #175D7A; border-color: #BEE3F0; }
.st-purple { background: #EFE7FB; color: #6B4FA0; border-color: #E1D4F4; }
.st-green { background: #E6F4E9; color: #2F855A; border-color: #CBE8D4; }
.st-gray { background: #F2F4F1; color: #8A948A; border-color: #E1E6E0; }

/* ---------- 空状态 ---------- */
.empty {
  text-align: center;
  color: var(--c-text-4);
  padding: 110rpx 0;
  font-size: 26rpx;
  line-height: 1.7;
}

/* ---------- 表单 ---------- */
.input {
  background: #FFFFFF;
  border-radius: var(--r-md);
  padding: 20rpx 24rpx;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--c-text);
  border: 1rpx solid #DDE6D9;
  transition: border-color 0.2s ease, background 0.2s ease;
  box-sizing: border-box;
}
.input:focus {
  border-color: var(--neon-violet);
}
.input::placeholder {
  color: var(--c-text-4);
}
.label {
  font-size: 26rpx;
  color: var(--c-text-2);
  margin-top: var(--sp-3);
  font-weight: 500;
  letter-spacing: 1rpx;
}
.step-title {
  font-size: 30rpx;
  font-weight: 700;
  margin: 0 0 var(--sp-2);
  display: flex;
  align-items: center;
  color: var(--neon-violet-2);
}
.step-title::before {
  content: "";
  display: inline-block;
  width: 6rpx;
  height: 32rpx;
  background: var(--neon-violet);
  border-radius: var(--r-pill);
  margin-right: var(--sp-2);
}

/* ---------- 入场动画（保留，无视觉侵入） ---------- */
@keyframes neon-rise {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.rise {
  animation: neon-rise 0.4s ease-out both;
}

/* ---------- 设计稿结构组件 ---------- */
/* 荧光黄 marker 高亮 */
.hl {
  background: linear-gradient(transparent 62%, #F5D33F 62%);
  padding: 0 8rpx;
  font-weight: 700;
}
/* 头部 hero（浅色渐变 + 圆角） */
.hero {
  position: relative;
  overflow: hidden;
  border-radius: var(--r-xl);
  padding: 36rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}
.hero-sunny { background: var(--grad-hero-sunny); }
.hero-sky { background: var(--grad-hero-sky); }
.hero-illust { width: 240rpx; height: 240rpx; }
.hero-illust.sm { width: 170rpx; height: 170rpx; }
/* 黄色丝带 */
.ribbon {
  display: inline-block;
  transform: rotate(-4deg);
  background: #F5D33F;
  border-radius: 10rpx;
  padding: 8rpx 22rpx;
  font-weight: 700;
  font-size: 26rpx;
}
/* 平行四边形按钮（抢单/报价） */
.btn-para {
  background: var(--color-primary);
  color: #fff;
  border-radius: 12rpx;
  transform: skewX(-12deg);
  padding: 12rpx 34rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
}
.btn-para .btn-in { display: inline-block; transform: skewX(12deg); }
/* 2x2 宫格 */
.tile-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  background: #fff;
  border-radius: var(--r-xl);
  padding: 20rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 20rpx;
}
.tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 30rpx 0;
  border-radius: var(--r-lg);
  background: #FBFDF9;
}
.tile .tile-icon { font-size: 44rpx; }
.tile .tile-label { font-size: 26rpx; color: var(--c-text); }
/* 数据行卡片 */
.stat-card {
  display: flex;
  background: #fff;
  border-radius: var(--r-xl);
  padding: 26rpx 8rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 20rpx;
}
.stat-card .stat { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.stat-card .stat b { font-size: 40rpx; line-height: 48rpx; color: var(--c-text); font-weight: 800; }
.stat-card .stat span { font-size: 22rpx; color: var(--c-text-3); }
/* 列表卡 */
.list-card {
  background: #fff;
  border-radius: var(--r-xl);
  padding: 24rpx 28rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 20rpx;
}
/* 黄色徽章 */
.badge-y {
  display: inline-block;
  background: #F5D33F;
  color: #1F2B22;
  border-radius: 10rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  font-weight: 700;
}
/* 灰色信息盒 */
.info-box {
  background: #F4F8F2;
  border-radius: var(--r-md);
  padding: 14rpx 20rpx;
  margin: 12rpx 0;
}
.info-box .ib-row { display: flex; gap: 12rpx; font-size: 24rpx; color: var(--c-text-2); line-height: 1.9; }
/* 菜单卡 */
.menu-card { background: #fff; border-radius: var(--r-xl); box-shadow: var(--shadow-card); margin-bottom: 20rpx; }
.menu-row { display: flex; align-items: center; gap: 18rpx; padding: 28rpx; }
.menu-row + .menu-row { border-top: 1rpx solid var(--c-divider); }
.menu-row .m-icon { font-size: 36rpx; }
.menu-row .m-title { flex: 1; font-size: 28rpx; color: var(--c-text); }
.menu-row .m-arrow { color: var(--c-text-4); }
/* 奶黄数据卡 / 天蓝卡片 / 黄色按钮 */
.data-card-y { background: #F7F3C9; border-radius: var(--r-xl); padding: 28rpx 8rpx; display: flex; margin-bottom: 20rpx; }
.card-sky { background: var(--color-primary); border-radius: var(--r-xl); padding: 26rpx 28rpx; margin-bottom: 20rpx; color: #fff; }
.btn-y { background: #F5D33F; color: #1F2B22; border-radius: var(--r-pill); padding: 10rpx 34rpx; font-weight: 700; font-size: 26rpx; }
/* 竖排 hero（插画居中） */
.hero-col { display: flex; flex-direction: column; align-items: center; padding-top: 20rpx; }
.hero-greet { margin-top: 8rpx; font-size: 40rpx; font-weight: 800; color: #1F2B22; }
.hero-link { margin-top: 8rpx; font-size: 24rpx; color: #2FA8DE; }
.tile { position: relative; }
.tile-badge { position: absolute; top: 10rpx; right: 14rpx; min-width: 32rpx; height: 32rpx; padding: 0 8rpx; box-sizing: border-box; background: #E85A4F; color: #fff; border-radius: 999rpx; font-size: 20rpx; font-weight: 700; line-height: 32rpx; text-align: center; }
.tile-hover { opacity: 0.85; }
.tile-grid.three { grid-template-columns: 1fr 1fr 1fr; }
.badge-g { display: inline-block; background: #E1E6E0; color: #8A948A; border-radius: 10rpx; padding: 4rpx 16rpx; font-size: 22rpx; font-weight: 700; }
.sec-title { margin: 8rpx 4rpx 16rpx; font-size: 30rpx; font-weight: 800; color: #1F2B22; }
.lc-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.lc-title { font-size: 30rpx; font-weight: 800; }
.lc-more { font-size: 24rpx; color: #7C877B; }
.stat-row { display: flex; background: #F4F8F2; border-radius: 16rpx; padding: 20rpx 0; }
.stat-row .stat { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.stat-row .stat b { font-size: 36rpx; line-height: 44rpx; font-weight: 800; color: #1F2B22; }
.stat-row .stat span { font-size: 21rpx; color: #7C877B; }
.req-card .req-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.req-card .req-name { flex: 1; font-size: 30rpx; font-weight: 700; color: #1F2B22; }
.req-card .req-meta { display: block; margin-top: 8rpx; font-size: 23rpx; color: #7C877B; }
.req-card .req-price { display: block; margin-top: 12rpx; font-size: 36rpx; font-weight: 800; color: #E85A4F; }
.req-card .tag-row { margin-top: 10rpx; }
.req-card .req-foot { display: flex; justify-content: flex-end; margin-top: 8rpx; }
.empty-state { display: flex; flex-direction: column; align-items: center; gap: 10rpx; padding: 90rpx 0; color: #9AA59A; }
.empty-icon { font-size: 64rpx; }
.empty-text { font-size: 28rpx; color: #7C877B; }
.empty-desc { font-size: 23rpx; color: #9AA59A; }
