/* 设计规范：科技蓝 #1890FF，16px 基础间距，卡片 8px 圆角（方案 8.1） */
page { background: #F5F6F8; font-size: 28rpx; color: #333; }
.container { padding: 24rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.btn-primary {
  background: #1890FF; color: #fff; border-radius: 8rpx;
  font-size: 30rpx; padding: 18rpx 0; text-align: center;
}
.btn-primary.disabled { background: #9DC9F7; }
.btn-outline {
  border: 1rpx solid #1890FF; color: #1890FF; background: #fff;
  border-radius: 8rpx; font-size: 30rpx; padding: 16rpx 0; text-align: center;
}
.btn-danger-outline {
  border: 1rpx solid #FF4D4F; color: #FF4D4F; background: #fff;
  border-radius: 8rpx; font-size: 30rpx; padding: 16rpx 0; text-align: center;
}
.row { display: flex; align-items: center; }
.spread { display: flex; align-items: center; justify-content: space-between; }
.title { font-size: 32rpx; font-weight: 600; }
.muted { color: #999; font-size: 24rpx; }
.money { color: #FF6A00; font-weight: 600; }
.tag {
  display: inline-block; background: #EDF5FF; color: #1890FF;
  border-radius: 6rpx; padding: 4rpx 12rpx; margin: 0 12rpx 12rpx 0; font-size: 22rpx;
}
.chip {
  display: inline-block; border: 1rpx solid #D9D9D9; color: #555; border-radius: 28rpx;
  padding: 8rpx 24rpx; margin: 0 16rpx 16rpx 0; font-size: 26rpx; background: #fff;
}
.chip.on { border-color: #1890FF; color: #1890FF; background: #EDF5FF; }
.status { font-size: 24rpx; padding: 4rpx 14rpx; border-radius: 6rpx; }
.st-blue { background: #EDF5FF; color: #1890FF; }
.st-orange { background: #FFF4E6; color: #FA8C16; }
.st-cyan { background: #E6FFFB; color: #13C2C2; }
.st-purple { background: #F9F0FF; color: #722ED1; }
.st-green { background: #F0FFF0; color: #52C41A; }
.st-gray { background: #F0F0F0; color: #999; }
.empty { text-align: center; color: #999; padding: 80rpx 0; }
.input {
  background: #F5F6F8; border-radius: 8rpx; padding: 16rpx 20rpx; margin-top: 12rpx;
}
.label { font-size: 26rpx; color: #666; margin-top: 24rpx; }
.step-title { font-size: 30rpx; font-weight: 600; margin: 8rpx 0 8rpx; color: #1890FF; }
