page {
  background: #F0F4F8;
  color: #1A1A2E;
}

.admin-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.admin-hero {
  padding: 30rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  box-shadow: 0 10rpx 28rpx rgba(102, 126, 234, 0.28);
  color: #FFFFFF;
}
.admin-hero-title { display: block; font-size: 38rpx; line-height: 52rpx; font-weight: 700; }
.admin-hero-desc { display: block; margin-top: 8rpx; font-size: 24rpx; line-height: 36rpx; color: rgba(255,255,255,.82); }

.admin-card {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #E4E7EE;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.05);
}
.admin-card-title { font-size: 30rpx; line-height: 42rpx; font-weight: 650; color: #1A1A2E; }
.admin-card-subtitle { margin-top: 6rpx; font-size: 23rpx; line-height: 34rpx; color: #767676; }

.admin-row { display: flex; align-items: center; }
.admin-between { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.admin-grow { flex: 1; min-width: 0; }
.admin-muted { color: #767676; font-size: 24rpx; line-height: 36rpx; }
.admin-small { color: #767676; font-size: 22rpx; line-height: 32rpx; }

.admin-input {
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border: 2rpx solid #DDE1EA;
  border-radius: 16rpx;
  background: #FFFFFF;
  font-size: 28rpx;
}
.admin-search { display: flex; gap: 12rpx; margin-top: 20rpx; }
.admin-search .admin-input { flex: 1; min-width: 0; }

.admin-button {
  min-height: 88rpx;
  margin: 0;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #667EEA, #764BA2);
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.3;
}
.admin-button::after { border: none; }
.admin-button:active { transform: scale(.97); opacity: .88; }
.admin-button.secondary { background: #EEF2FF; color: #596CD4; }
.admin-button.danger { background: #FFF0EE; color: #C0392B; }
.admin-button.ghost { background: #F5F6FA; color: #4B5563; }
.admin-button.small { min-height: 72rpx; padding: 0 22rpx; font-size: 24rpx; }

.admin-chips { display: flex; gap: 12rpx; overflow-x: auto; margin-top: 16rpx; white-space: nowrap; }
.admin-chip {
  flex-shrink: 0;
  min-height: 72rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  border-radius: 38rpx;
  background: #FFFFFF;
  border: 2rpx solid #DDE1EA;
  color: #4B5563;
  font-size: 24rpx;
}
.admin-chip.active { border-color: #667EEA; background: #EEF2FF; color: #596CD4; font-weight: 600; }

.admin-badge { padding: 6rpx 16rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 600; }
.badge-purple { color: #68439A; background: #F1E9FA; }
.badge-blue { color: #245CB8; background: #EAF2FF; }
.badge-green { color: #247A43; background: #E8F6ED; }
.badge-orange { color: #A55A00; background: #FFF1DB; }
.badge-red { color: #B3382D; background: #FDECEA; }
.badge-gray { color: #666E7A; background: #EEF0F3; }

.admin-empty { padding: 110rpx 30rpx; text-align: center; color: #8A8A8A; font-size: 26rpx; line-height: 42rpx; }
.admin-loading { padding: 60rpx 0; text-align: center; color: #767676; font-size: 25rpx; }
.admin-error { margin-top: 20rpx; padding: 22rpx; border-radius: 16rpx; background: #FDECEA; color: #B3382D; font-size: 25rpx; line-height: 38rpx; }

.admin-divider { height: 1rpx; margin: 20rpx 0; background: #EEF0F3; }
.admin-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.admin-tag { padding: 7rpx 14rpx; border-radius: 10rpx; background: #EEF2FF; color: #596CD4; font-size: 22rpx; }
