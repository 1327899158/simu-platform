@import "../../admin.wxss";
.order-card { transition: transform .15s ease, opacity .15s ease; }
.order-pressed { transform: scale(.985); opacity: .86; }
.order-title { flex: 1; min-width: 0; font-size: 29rpx; line-height: 42rpx; font-weight: 650; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.order-no { display: block; margin-top: 6rpx; color: #8A8A8A; font-size: 22rpx; }
.order-metrics { display: flex; justify-content: space-between; margin-top: 22rpx; }
.order-metrics > view { flex: 1; text-align: center; border-right: 1rpx solid #EEF0F3; }
.order-metrics > view:last-child { border-right: none; }
.metric-value { display: block; font-size: 28rpx; line-height: 38rpx; font-weight: 650; color: #2FA8DE; }
.metric-label { display: block; margin-top: 3rpx; color: #8A8A8A; font-size: 21rpx; }
