<view class="admin-page" wx:if="{{data}}">
  <view class="admin-hero"><text class="admin-hero-title">数据预览</text><text class="admin-hero-desc">近 7 日趋势与当前业务数据分布，下拉可刷新</text></view>
  <view class="metric-grid"><view class="metric-card"><text class="metric-value">{{data.reviews.averageScore === null ? '--' : data.reviews.averageScore}}</text><text class="metric-label">工程师平均评分</text></view><view class="metric-card"><text class="metric-value">{{data.reviews.count}}</text><text class="metric-label">累计服务评价</text></view></view>
  <view class="admin-card"><text class="admin-card-title">近 7 日新增趋势</text><text class="admin-card-subtitle">紫色：用户 · 蓝色：订单 · 黄色：评价</text><view class="trend-chart"><view class="trend-column" wx:for="{{trend}}" wx:key="day"><view class="trend-bars"><view class="trend-bar users" style="height: {{item.userHeight}}rpx"></view><view class="trend-bar orders" style="height: {{item.orderHeight}}rpx"></view><view class="trend-bar reviews" style="height: {{item.reviewHeight}}rpx"></view></view><text class="trend-day">{{item.day}}</text><text class="trend-count">{{item.users}}/{{item.orders}}/{{item.reviews}}</text></view></view></view>
  <view class="admin-card"><text class="admin-card-title">订单状态分布</text><view class="bar-list"><view class="bar-row" wx:for="{{orderStates}}" wx:key="key"><view class="bar-label"><text>{{item.label}}</text><text>{{item.count}}</text></view><view class="bar-track"><view class="bar-fill order" style="width: {{item.percent}}%"></view></view></view></view></view>
  <view class="admin-card"><text class="admin-card-title">身份认证审核分布</text><view class="bar-list"><view class="bar-row" wx:for="{{verifyStates}}" wx:key="key"><view class="bar-label"><text>{{item.label}}</text><text>{{item.count}}</text></view><view class="bar-track"><view class="bar-fill verify {{item.key}}" style="width: {{item.percent}}%"></view></view></view></view></view>
  <view class="admin-card"><text class="admin-card-title">评价星级分布</text><view class="bar-list"><view class="bar-row" wx:for="{{ratingStates}}" wx:key="score"><view class="bar-label"><text>{{item.label}}</text><text>{{item.count}}</text></view><view class="bar-track"><view class="bar-fill rating" style="width: {{item.percent}}%"></view></view></view></view></view>
</view>
<view class="admin-loading" wx:if="{{loading}}">正在汇总数据…</view>
