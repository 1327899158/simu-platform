@import "../../admin.wxss";
.metric-grid { display: flex; gap: 16rpx; margin-top: 20rpx; }.metric-card { flex: 1; padding: 24rpx; border-radius: 20rpx; background: #fff; border: 1rpx solid #E4E7EE; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.05); }.metric-value { display: block; color: #2FA8DE; font-size: 46rpx; line-height: 56rpx; font-weight: 750; }.metric-label { display: block; margin-top: 8rpx; color: #4B5563; font-size: 23rpx; }.trend-chart { height: 204rpx; margin-top: 22rpx; display: flex; align-items: flex-end; justify-content: space-between; gap: 8rpx; }.trend-column { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; }.trend-bars { height: 132rpx; display: flex; align-items: flex-end; gap: 3rpx; }.trend-bar { width: 12rpx; min-height: 2rpx; border-radius: 6rpx 6rpx 0 0; }.trend-bar.users { background: #5BC0EB; }.trend-bar.orders { background: #5BC0EB; }.trend-bar.reviews { background: #E6A400; }.trend-day { margin-top: 8rpx; color: #767676; font-size: 18rpx; }.trend-count { margin-top: 4rpx; color: #9CA3AF; font-size: 17rpx; }.bar-list { margin-top: 16rpx; }.bar-row { margin-top: 16rpx; }.bar-label { display: flex; justify-content: space-between; color: #4B5563; font-size: 23rpx; }.bar-track { height: 16rpx; margin-top: 8rpx; overflow: hidden; border-radius: 8rpx; background: #EEF0F5; }.bar-fill { height: 100%; min-width: 0; border-radius: 8rpx; }.bar-fill.order { background: linear-gradient(90deg,#5BC0EB,#7ED3F2); }.bar-fill.verify { background: #D97706; }.bar-fill.verify.APPROVED { background: #52B788; }.bar-fill.verify.REJECTED { background: #D04A3B; }.bar-fill.rating { background: linear-gradient(90deg,#E6A400,#F6C94C); }
