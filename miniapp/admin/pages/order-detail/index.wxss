@import "../../admin.wxss";
.detail-badge { flex-shrink: 0; padding: 8rpx 18rpx; border-radius: 999rpx; background: rgba(255,255,255,.18); font-size: 23rpx; }
.detail-line { min-height: 58rpx; padding-top: 12rpx; display: flex; justify-content: space-between; gap: 24rpx; border-bottom: 1rpx solid #F0F2F5; color: #4B5563; font-size: 24rpx; line-height: 38rpx; }
.detail-line text:last-child { max-width: 68%; text-align: right; color: #1A1A2E; }
.description { display: block; margin-top: 20rpx; padding: 18rpx; border-radius: 14rpx; background: #F7F8FB; color: #4B5563; font-size: 25rpx; line-height: 40rpx; white-space: pre-wrap; }
.file-line { min-height: 88rpx; padding: 12rpx 0; display: flex; align-items: center; border-bottom: 1rpx solid #F0F2F5; }
.file-name { display: block; font-size: 25rpx; line-height: 38rpx; word-break: break-all; }
.risk-card { border-color: #F3C8C3; }
.risk-card .admin-button { margin-top: 20rpx; }
