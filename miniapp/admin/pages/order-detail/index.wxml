<view class="admin-page" wx:if="{{order}}">
  <view class="admin-hero"><view class="admin-between"><view class="admin-grow"><text class="admin-hero-title">{{order.projectName}}</text><text class="admin-hero-desc">{{order.orderNo}}</text></view><text class="detail-badge">{{order.statusText}}</text></view></view>
  <view class="admin-card"><text class="admin-card-title">需求信息</text><view class="detail-line"><text>客户</text><text>{{order.customerName}}（{{order.customerPhone || '无手机号'}}）</text></view><view class="detail-line"><text>发布时间</text><text>{{order.createdText}}</text></view><view class="detail-line"><text>工期</text><text>{{order.deliveryDays}} 天</text></view><view class="detail-line"><text>预算</text><text>¥{{order.budgetText}}</text></view><view class="detail-line" wx:if="{{order.finalAmountFen}}"><text>成交金额</text><text>¥{{order.finalText}}</text></view><view class="detail-line"><text>浏览量</text><text>{{order.viewCount}} 次</text></view><view class="detail-line" wx:if="{{order.adminCloseReason}}"><text>管理关闭原因</text><text>{{order.adminCloseReason}}</text></view><view class="admin-tags"><text class="admin-tag" wx:for="{{order.directionTags}}" wx:key="*this">{{item}}</text><text class="admin-tag" wx:for="{{order.softwareTags}}" wx:key="*this">{{item}}</text></view><text class="description">{{order.description}}</text></view>
  <view class="admin-card" wx:if="{{order.engineerName}}"><text class="admin-card-title">中选信息</text><view class="detail-line"><text>工程师</text><text>{{order.engineerName}}</text></view><view class="detail-line"><text>报价</text><text>¥{{order.selectedText}}</text></view><view class="detail-line"><text>承诺工期</text><text>{{order.selectedDays}} 天</text></view></view>
  <view class="admin-card"><text class="admin-card-title">附件（{{order.files.length}}）</text><view class="file-line" wx:for="{{order.files}}" wx:key="id"><view class="admin-grow"><text class="file-name">{{item.name}}</text><text class="admin-small">{{item.purpose}} · {{item.sizeText}}</text></view></view><view class="admin-muted" wx:if="{{!order.files.length}}">没有附件</view></view>
  <view class="admin-card risk-card" wx:if="{{canClose && order.status === 'QUOTING'}}"><text class="admin-card-title">受控操作</text><text class="admin-card-subtitle">仅待报价订单可以关闭，操作将记录管理员、原因和时间。</text><button class="admin-button danger" bindtap="closeOrder">关闭该订单</button></view>
</view>
<view class="admin-loading" wx:if="{{loading}}">正在加载订单详情…</view>
