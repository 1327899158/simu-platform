<view class="admin-page">
  <view class="admin-hero">
    <view class="admin-between">
      <view class="admin-grow">
        <text class="admin-hero-title">管理总览</text>
        <text class="admin-hero-desc">{{admin.displayName}} · {{admin.adminRoleText}}</text>
      </view>
      <button class="exit-button" bindtap="exit">退出管理</button>
    </view>
  </view>

  <view class="stats-grid" wx:if="{{stats}}">
    <view class="stat-box"><text class="stat-value">{{stats.users.total}}</text><text class="stat-label">用户总数</text><text class="stat-extra">近7日 +{{stats.users.recent7d}}</text></view>
    <view class="stat-box"><text class="stat-value warning">{{stats.engineerReviews.pending}}</text><text class="stat-label">待审工程师</text><text class="stat-extra">已通过 {{stats.engineerReviews.approved}}</text></view>
    <view class="stat-box"><text class="stat-value">{{stats.orders.QUOTING || 0}}</text><text class="stat-label">待报价订单</text><text class="stat-extra">近7日 +{{stats.orders.recent7d}}</text></view>
    <view class="stat-box"><text class="stat-value">{{stats.quotes.total}}</text><text class="stat-label">有效报价</text><text class="stat-extra">全平台累计</text></view>
  </view>

  <view class="menu-list" wx:if="{{!loading}}">
    <view class="menu-card" wx:for="{{menus}}" wx:key="key" data-path="{{item.path}}" bindtap="open" hover-class="menu-pressed">
      <view class="menu-icon">{{item.key === 'users' ? '人' : (item.key === 'engineers' ? '审' : (item.key === 'orders' ? '单' : (item.key === 'invoices' ? '票' : (item.key === 'disputes' ? '纷' : (item.key === 'preview' ? '数' : '志')))))}}</view>
      <view class="admin-grow"><text class="menu-title">{{item.title}}</text><text class="menu-desc">{{item.desc}}</text></view>
      <text class="menu-count" wx:if="{{item.count}}">{{item.count}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
  <view class="admin-loading" wx:if="{{loading}}">正在加载管理数据…</view>
</view>
