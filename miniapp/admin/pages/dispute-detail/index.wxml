<view class="admin-page" wx:if="{{dispute}}">
  <view class="admin-hero">
    <view class="admin-between">
      <view class="admin-grow">
        <text class="admin-hero-title">⚖️ 订单纠纷</text>
        <text class="admin-hero-desc">{{dispute.order ? dispute.order.projectName : '纠纷'}}<text wx:if="{{dispute.order}}"> · {{dispute.order.orderNo}}</text></text>
      </view>
      <text class="detail-badge">{{dispute.statusText}}</text>
    </view>
  </view>

  <!-- 纠纷信息 -->
  <view class="admin-card">
    <text class="admin-card-title">纠纷信息</text>
    <view class="detail-line"><text>纠纷类型</text><text>{{dispute.reasonText}}</text></view>
    <view class="detail-line"><text>发起时间</text><text>{{dispute.createdText}}</text></view>
    <view class="detail-line"><text>举证截止</text><text>{{dispute.deadlineText}}</text></view>
    <view class="evidence-stage {{dispute.evidenceOpen ? 'collecting' : 'ready'}}">
      {{dispute.evidenceOpen ? '双方正在举证，管理员可实时查看材料；倒计时结束后开放仲裁。' : (dispute.status === 'OPEN' ? '举证已结束，可以开始仲裁。' : '本纠纷举证及处理已结束。')}}
    </view>
    <view class="detail-line"><text>订单状态</text><text>{{dispute.orderStatusAtOpen}} → {{dispute.order ? dispute.order.status : '—'}}</text></view>
    <view class="detail-line" wx:if="{{dispute.verdict !== 'NONE'}}"><text>仲裁结论</text><text>{{dispute.verdictText}} · {{dispute.orderActionText}}</text></view>
    <view class="detail-line" wx:if="{{dispute.resolvedAt}}"><text>结案时间</text><text>{{dispute.resolvedText}}</text></view>
    <view class="detail-line" wx:if="{{dispute.refundAmountFen != null}}"><text>应退金额</text><text>¥{{dispute.refundY}}（{{dispute.refundStatusText}}）</text></view>
    <view class="detail-line" wx:if="{{dispute.resolutionNote}}"><text>仲裁说明</text><text>{{dispute.resolutionNote}}</text></view>
    <text class="admin-description" wx:if="{{dispute.description}}">{{dispute.description}}</text>
  </view>

  <!-- 当事人 -->
  <view class="admin-card">
    <text class="admin-card-title">当事人</text>
    <view class="party-line"><text>买家</text><text>{{dispute.customer ? dispute.customer.nickname : '—'}}（{{dispute.customer ? dispute.customer.phoneMasked : '无'}}）</text></view>
    <view class="party-line"><text>工程师</text><text>{{dispute.engineer ? dispute.engineer.nickname : '—'}}（{{dispute.engineer ? dispute.engineer.phoneMasked : '无'}}）</text></view>
    <view class="party-line"><text>发起人</text><text>{{dispute.customer && dispute.initiatorId === dispute.customer.id ? '买家' : (dispute.engineer && dispute.initiatorId === dispute.engineer.id ? '工程师' : '—')}}</text></view>
  </view>

  <!-- 证据 -->
  <view class="admin-card">
    <text class="admin-card-title">证据材料（{{dispute.evidence.length}}）</text>
    <view class="file-row" wx:for="{{dispute.evidence}}" wx:key="fileId"
      data-index="{{index}}" bindtap="openEvidence" hover-class="file-pressed">
      <text class="file-icon">{{item.kind === 'IMAGE' ? '图' : '文'}}</text>
      <view class="admin-grow">
        <text class="file-name">{{item.name}}</text>
        <text class="admin-small">{{item.uploaderText}}提交 · {{item.uploaderName}} · {{item.submittedText}} · {{item.sizeText}}</text>
      </view>
      <text class="file-arrow">›</text>
    </view>
    <view class="admin-empty small-empty" wx:if="{{!dispute.evidence.length}}">无证据材料</view>
  </view>

  <!-- 仲裁表单 -->
  <view class="admin-card review-card" wx:if="{{canResolve && dispute.status === 'OPEN' && !dispute.evidenceOpen}}">
    <text class="admin-card-title">仲裁处理</text>
    <text class="admin-card-subtitle">仲裁结案会改变订单状态并登记退款诉求，操作写入审计日志。</text>

    <text class="section-label">仲裁结论</text>
    <view class="chip-group">
      <view wx:for="{{VERDICTS}}" wx:key="key"
        class="verdict-chip {{verdict === item.key ? 'active' : ''}}"
        data-key="{{item.key}}" bindtap="pickVerdict">{{item.label}}</view>
    </view>

    <text class="section-label">订单处理</text>
    <view class="chip-group">
      <view wx:for="{{ACTIONS}}" wx:key="key"
        class="verdict-chip {{orderAction === item.key ? 'active' : ''}}"
        data-key="{{item.key}}" bindtap="pickAction">{{item.label}}</view>
    </view>

    <text class="section-label">应退金额（元，可选）</text>
    <input class="admin-input refund-input" type="digit" placeholder="留空表示无需退款"
      value="{{refundAmount}}" bindinput="onRefund" />

    <text class="section-label">仲裁说明（可选）</text>
    <textarea class="admin-textarea" placeholder="填写仲裁理由，将同步给双方" value="{{note}}"
      bindinput="onNote" maxlength="1000" />

    <button class="admin-button danger" bindtap="resolve" disabled="{{submitting}}">
      {{submitting ? '提交中…' : '提交仲裁并结案'}}
    </button>
  </view>
  <view class="admin-card waiting-card" wx:if="{{canResolve && dispute.status === 'OPEN' && dispute.evidenceOpen}}">
    <text class="admin-card-title">等待举证结束</text>
    <text class="admin-muted">仲裁表单将在 {{dispute.deadlineText}} 后开放。期间可查看双方新上传的证据材料。</text>
  </view>
  <view class="admin-card" wx:if="{{dispute.status !== 'OPEN'}}">
    <text class="admin-muted">该纠纷已{{dispute.statusText}}，不可再次仲裁。</text>
  </view>
</view>
<view class="admin-loading" wx:if="{{loading}}">正在加载纠纷详情…</view>
