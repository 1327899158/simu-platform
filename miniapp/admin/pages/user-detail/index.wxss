@import "../../admin.wxss";
.detail-line { min-height: 58rpx; padding-top: 12rpx; display: flex; justify-content: space-between; gap: 24rpx; border-bottom: 1rpx solid #F0F2F5; color: #4B5563; font-size: 24rpx; line-height: 38rpx; }.detail-line text:last-child { max-width: 68%; color: #1A1A2E; text-align: right; word-break: break-all; }.review-row { padding: 22rpx 0; border-top: 1rpx solid #F0F2F5; }.review-head { display: flex; justify-content: space-between; gap: 16rpx; }.review-name { display: block; color: #1A1A2E; font-size: 26rpx; font-weight: 650; }.review-score { flex-shrink: 0; color: #C87C00; font-size: 26rpx; font-weight: 700; }.review-pills { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 14rpx 0; }.review-pills text { padding: 5rpx 12rpx; border-radius: 999rpx; background: #E3F4FC; color: #2FA8DE; font-size: 21rpx; }.review-content { color: #4B5563; font-size: 24rpx; line-height: 38rpx; word-break: break-all; }.small-empty { padding: 48rpx 0; font-size: 24rpx; }
.identity-file { min-height: 88rpx; padding: 14rpx 0; display: flex; align-items: center; gap: 16rpx; border-top: 1rpx solid #F0F2F5; color: #7256A8; }.identity-purpose { display: block; color: #1A1A2E; font-size: 25rpx; font-weight: 650; }.review-actions { display: flex; gap: 16rpx; margin-top: 22rpx; }.review-actions button { flex: 1; }
