<view class="admin-page" wx:if="{{user}}">
  <view class="admin-hero"><text class="admin-hero-title">{{user.nickname || user.username || '用户资料'}}</text><text class="admin-hero-desc">{{user.roleText}} · {{user.id}}</text></view>
  <view class="admin-card"><text class="admin-card-title">账号资料</text><view class="detail-line"><text>用户名</text><text>{{user.username || '—'}}</text></view><view class="detail-line"><text>手机号</text><text>{{user.phone || '未绑定'}}</text></view><view class="detail-line"><text>账号状态</text><text>{{user.statusText}}</text></view><view class="detail-line"><text>注册时间</text><text>{{user.createdText}}</text></view></view>
  <view class="admin-card"><view class="admin-between"><text class="admin-card-title">给出的评价</text><text class="admin-badge badge-blue">{{user.sentReviews.length}} 条</text></view><text class="admin-card-subtitle">该用户作为客户对工程师提交的订单评价。</text><view class="review-row" wx:for="{{user.sentReviews}}" wx:key="id"><view class="review-head"><view><text class="review-name">给 {{item.engineerNickname}}</text><text class="admin-small">{{item.order.projectName}} · {{item.updatedText}}</text></view><text class="review-score">★ {{item.averageScore}}</text></view><view class="review-pills"><text>质量 {{item.qualityScore}}</text><text>态度 {{item.attitudeScore}}</text><text>速度 {{item.speedScore}}</text></view><text class="review-content">{{item.content}}</text></view><view class="admin-empty small-empty" wx:if="{{!user.sentReviews.length}}">该用户暂未提交任何评价</view></view>
</view>
<view class="admin-loading" wx:if="{{loading}}">正在加载用户资料…</view>
