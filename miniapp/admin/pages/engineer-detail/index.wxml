<view class="admin-page" wx:if="{{engineer}}">
  <view class="admin-hero"><view class="admin-between"><view class="admin-grow"><text class="admin-hero-title">{{engineer.realName || engineer.nickname || '工程师资料'}}</text><text class="admin-hero-desc">{{engineer.nickname || '未设置昵称'}} · {{engineer.id}}</text></view><text class="detail-status">{{engineer.verifyStatusText}}</text></view></view>
  <view class="admin-card"><text class="admin-card-title">基本资料</text><view class="detail-line"><text>昵称</text><text>{{engineer.nickname || '—'}}</text></view><view class="detail-line"><text>真实姓名</text><text>{{engineer.realName || '未填写'}}</text></view><view class="detail-line"><text>手机号</text><text>{{engineer.phone || '未绑定'}}</text></view><view class="detail-line"><text>账号状态</text><text>{{engineer.userStatus === 'ACTIVE' ? '正常' : '已停用'}}</text></view><view class="detail-line"><text>创建时间</text><text>{{engineer.createdText}}</text></view><view class="admin-tags"><text class="admin-tag" wx:for="{{engineer.specialties}}" wx:key="*this">{{item}}</text><text class="admin-tag" wx:for="{{engineer.softwares}}" wx:key="*this">{{item}}</text></view><text class="intro" wx:if="{{engineer.intro}}">{{engineer.intro}}</text></view>
  <view class="admin-card"><view class="admin-between"><text class="admin-card-title">资格附件</text><text class="admin-badge {{engineer.badgeClass}}">{{engineer.files.length}} 份</text></view><text class="admin-card-subtitle">点击附件可直接预览图片或下载、打开文档。</text><view class="file-row" wx:for="{{engineer.files}}" wx:key="fileId" data-index="{{index}}" bindtap="openFile" hover-class="file-pressed"><text class="file-icon">{{item.kind === 'IMAGE' ? '图' : '文'}}</text><view class="admin-grow"><text class="file-name">{{item.name}}</text><text class="admin-small">{{item.sizeText}} · {{item.createdAt}}</text></view><text class="file-arrow">›</text></view><view class="admin-empty small-empty" wx:if="{{!engineer.files.length}}">该工程师尚未上传资格附件</view></view>
  <view class="admin-card" wx:if="{{engineer.reviewReason}}"><text class="admin-card-title">上次审核说明</text><text class="review-reason">{{engineer.reviewReason}}</text></view>
  <view class="admin-card review-card" wx:if="{{canReview && engineer.verifyStatus === 'PENDING'}}"><text class="admin-card-title">资格审核</text><text class="admin-card-subtitle">通过或驳回都会写入管理员操作日志。</text><view class="review-actions"><button class="admin-button secondary" bindtap="approve">通过审核</button><button class="admin-button danger" bindtap="reject">驳回申请</button></view></view>
</view>
<view class="admin-loading" wx:if="{{loading}}">正在加载工程师资料…</view>
